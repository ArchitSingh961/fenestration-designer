<Application x:Class="Mark.Owner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mark.Designer;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A small coloured label: green active, amber ending soon, red suspended / expired. -->
            <Style x:Key="StatePill" TargetType="Border">
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="8,1" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Background" Value="#E8F6EE" />
                <Setter Property="TextElement.Foreground" Value="#1D6B3A" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                        <Setter Property="Background" Value="#FFF4D6" />
                        <Setter Property="TextElement.Foreground" Value="#8A5A00" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsBad}" Value="True">
                        <Setter Property="Background" Value="#FBECEC" />
                        <Setter Property="TextElement.Foreground" Value="#A32020" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Owner header tabs on the dark bar. -->
            <Style x:Key="OwnerTab" TargetType="RadioButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="#C9D6EA" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="14,7" Margin="2,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}" />
                <Setter Property="Margin" Value="0,14,0,6" />
            </Style>

            <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Padding" Value="7,2" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="4,0,0,0" />
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Foreground" Value="#A32020" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
