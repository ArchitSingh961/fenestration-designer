<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Fenestration.App</RootNamespace>
    <AssemblyName>Fenestration.App</AssemblyName>
  </PropertyGroup>

  <!-- Data shipped next to the executable: the product library and the workshop's calculation rules. -->
  <ItemGroup>
    <None Update="Library\library.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Settings\calculation-rules.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fenestration.Core\Fenestration.Core.csproj" />
    <ProjectReference Include="..\Fenestration.Designer\Fenestration.Designer.csproj" />
    <ProjectReference Include="..\Fenestration.Data\Fenestration.Data.csproj" />
  </ItemGroup>

</Project>
