<Window x:Class="Mark.Designer.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PanelBackgroundBrush}"
        FocusManager.FocusedElement="{Binding ElementName=Input}">
    <StackPanel Margin="16">
        <TextBlock x:Name="Label" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
        <TextBox x:Name="Input" Padding="4,3" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
