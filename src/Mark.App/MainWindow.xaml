                                    <Button Style="{StaticResource PrimaryButton}" Content="Invoice PDF…" Margin="0,0,8,0" Command="{Binding InvoicePdfCommand}" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Cancel invoice" Command="{Binding CancelInvoiceCommand}" />
                                </StackPanel>
                            </StackPanel>
                            <DockPanel Visibility="{Binding HasDraft, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding DraftTitle}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" />
                                <TextBlock DockPanel.Dock="Top" Text="{Binding DraftWarning}" Foreground="#9A5B00" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding DraftWarning.Length, Converter={StaticResource CountToVisibility}}" />
                                <Button DockPanel.Dock="Top" Style="{StaticResource SecondaryButton}" Content="Use the order's value" HorizontalAlignment="Left" Margin="0,6,0,0"
                                        Command="{Binding MatchOrderValueCommand}" Visibility="{Binding HasPriceDifference, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Scale the windows' rates so the invoice comes to the value the order was confirmed at (charges stay as they are)" />
                                <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Date" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Padding="4,3" Text="{Binding DraftDate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Invoice date" />
                                    <TextBlock Grid.Column="2" Text="Place of supply" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="12,0,8,0" />
                                    <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:AccountsViewModel.States}" SelectedItem="{Binding PlaceOfSupply}"
                                              AutomationProperties.Name="Place of supply" />
                                </Grid>
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding DraftTotals}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="Notes" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Padding="4,3" Text="{Binding DraftNotes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Invoice notes" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Create invoice" Margin="0,0,8,0" Command="{Binding CreateInvoiceCommand}"
                                                ToolTip="Gives it the next number and writes its PDF" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="Discard" Command="{Binding DiscardDraftCommand}" />
                                    </StackPanel>
                                </StackPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,10,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Description" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="HSN/SAC" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="6,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="Qty" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="Rate (before tax)" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Right" />
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <views:ItemsList ItemsSource="{Binding DraftLines}" AutomationProperties.Name="Invoice lines">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}"><Run Text="{Binding Unit, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding LeftText, Mode=OneWay}" /></TextBlock>
                                                    </StackPanel>
                                                    <TextBox Grid.Column="1" Margin="6,0,0,0" Padding="4,2" VerticalAlignment="Top" Text="{Binding Hsn, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="{Binding Description, StringFormat=HSN of {0}}" />
                                                    <TextBox Grid.Column="2" Margin="6,0,0,0" Padding="4,2" VerticalAlignment="Top" TextAlignment="Right"
                                                             Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Description, StringFormat=Quantity of {0}}" />
                                                    <TextBox Grid.Column="3" Margin="6,0,0,0" Padding="4,2" VerticalAlignment="Top" TextAlignment="Right"
                                                             Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Description, StringFormat=Rate of {0}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </views:ItemsList>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                </DockPanel>
            </DockPanel>

            <DockPanel x:Name="ReceiptsPage" DataContext="{Binding Accounts}" Background="{StaticResource PageBackgroundBrush}"
