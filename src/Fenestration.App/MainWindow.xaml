<Window x:Class="Fenestration.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Fenestration.Designer.Controls;assembly=Fenestration.Designer"
        xmlns:views="clr-namespace:Fenestration.Designer.Views;assembly=Fenestration.Designer"
        xmlns:vm="clr-namespace:Fenestration.Designer.ViewModels;assembly=Fenestration.Designer"
        Title="{Binding Title}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ChromeBackgroundBrush}">

    <Window.Resources>
        <views:EnumToBooleanConverter x:Key="EnumToBool" />

        <!-- A name / value / unit row of the properties panel. -->
        <DataTemplate x:Key="PropertyRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextAlignment="Right"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding Unit}" Margin="4,0,0,0"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </DataTemplate>

        <!-- Searchable library selection (glass type / profile) in the properties panel. -->
        <DataTemplate DataType="{x:Type vm:LibraryPickerViewModel}">
            <StackPanel Margin="12,10,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding CurrentText}" TextWrapping="Wrap" TextAlignment="Right"
                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Search" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Padding="4,2" ToolTip="Filter the library by name, code, type or series"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <ComboBox Margin="0,4,0,0" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                          ToolTip="Choose a library item to assign it">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,1">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding ResultSummary}" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0"
                           Foreground="{StaticResource MutedTextBrush}" />
                <Border Margin="0,4,0,0" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewProjectCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- ── Menu ─────────────────────────────────────────────── -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource ChromeBackgroundBrush}" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Command="{Binding NewProjectCommand}" />
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Command="{Binding OpenProjectCommand}" />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveProjectCommand}" />
                <MenuItem Header="Save a _Copy As..." Command="{Binding SaveProjectAsCommand}" />
                <Separator />
                <MenuItem Header="_Import Project File..." Command="{Binding ImportProjectFileCommand}" />
                <MenuItem Header="_Export Project File..." Command="{Binding ExportProjectFileCommand}" />
                <Separator />
                <MenuItem Header="_Library Manager..." Command="{Binding OpenLibraryManagerCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" />
                <MenuItem Header="_Delete" InputGestureText="Del" Command="{Binding DeleteSelectedCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _In" Command="{Binding Canvas.ZoomInCommand}" />
                <MenuItem Header="Zoom _Out" Command="{Binding Canvas.ZoomOutCommand}" />
                <MenuItem Header="_Fit to Screen" InputGestureText="F" Command="{Binding Canvas.FitCommand}" />
                <MenuItem Header="_Reset View" Command="{Binding Canvas.ResetViewCommand}" />
                <Separator />
                <MenuItem Header="Show _Grid" InputGestureText="G" IsCheckable="True" IsChecked="{Binding Canvas.ShowGrid}" />
                <MenuItem Header="Show _Axes" IsCheckable="True" IsChecked="{Binding Canvas.ShowAxes}" />
            </MenuItem>
            <MenuItem Header="_Design">
                <MenuItem Header="Create _Frame (typed size)" Command="{Binding CreateFrameCommand}" />
                <MenuItem Header="Add _Mullion (centred)" Command="{Binding AddMullionCommand}" />
                <MenuItem Header="Add _Transom (centred)" Command="{Binding AddTransomCommand}" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Select" Command="{Binding SetModeCommand}" CommandParameter="Select" />
                <MenuItem Header="_Pan" Command="{Binding SetModeCommand}" CommandParameter="Pan" />
                <MenuItem Header="Draw _Frame" Command="{Binding SetModeCommand}" CommandParameter="CreateFrame" />
                <MenuItem Header="Place _Mullion" Command="{Binding SetModeCommand}" CommandParameter="AddMullion" />
                <MenuItem Header="Place _Transom" Command="{Binding SetModeCommand}" CommandParameter="AddTransom" />
                <Separator />
                <MenuItem Header="_Object Snap" IsCheckable="True" IsChecked="{Binding ObjectSnapEnabled}" />
                <MenuItem Header="Snap to _Grid" IsCheckable="True" IsChecked="{Binding Canvas.SnapToGrid}" />
            </MenuItem>
        </Menu>

        <!-- ── Toolbar ──────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1"
                Background="{StaticResource PanelBackgroundBrush}" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButton}" Content="New" Command="{Binding NewProjectCommand}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Open" ToolTip="Open a saved project (Ctrl+O)"
                        Command="{Binding OpenProjectCommand}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Save" ToolTip="Save the project (Ctrl+S)"
                        Command="{Binding SaveProjectCommand}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Library" ToolTip="Library manager: products, prices, stock lengths"
                        Command="{Binding OpenLibraryManagerCommand}" />
                <Rectangle Width="1" Margin="6,2" Fill="{StaticResource BorderBrush}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Undo" Command="{Binding UndoCommand}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Redo" Command="{Binding RedoCommand}" />
                <Rectangle Width="1" Margin="6,2" Fill="{StaticResource BorderBrush}" />
                <!-- Interaction modes: exactly one is active. -->
                <RadioButton Style="{StaticResource ToolRadio}" Content="Select" ToolTip="Select, move, resize (Esc)"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Select}" />
                <RadioButton Style="{StaticResource ToolRadio}" Content="Pan" ToolTip="Drag to pan"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Pan}" />
                <RadioButton Style="{StaticResource ToolRadio}" Content="Frame" ToolTip="Drag a rectangle to draw a frame"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=CreateFrame}" />
                <RadioButton Style="{StaticResource ToolRadio}" Content="Mullion" ToolTip="Click a glass panel to add a mullion (Shift = whole frame)"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=AddMullion}" />
                <RadioButton Style="{StaticResource ToolRadio}" Content="Transom" ToolTip="Click a glass panel to add a transom (Shift = whole frame)"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=AddTransom}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Delete" ToolTip="Delete the selection (Del)"
                        Command="{Binding DeleteSelectedCommand}" />
                <Rectangle Width="1" Margin="6,2" Fill="{StaticResource BorderBrush}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Zoom In" Command="{Binding Canvas.ZoomInCommand}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Zoom Out" Command="{Binding Canvas.ZoomOutCommand}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Fit" ToolTip="Fit to screen (F)" Command="{Binding Canvas.FitCommand}" />
                <Button Style="{StaticResource ToolbarButton}" Content="Reset" ToolTip="Reset view" Command="{Binding Canvas.ResetViewCommand}" />
                <ToggleButton Style="{StaticResource ToolbarToggle}" Content="Grid" ToolTip="Show grid (G)"
                              IsChecked="{Binding Canvas.ShowGrid}" />
            </StackPanel>
        </Border>

        <!-- ── Status bar ───────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Background="{StaticResource PanelBackgroundBrush}" Padding="12,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding Canvas.CursorText}" Foreground="{StaticResource TextBrush}"
                               MinWidth="230" FontFamily="Consolas" />
                    <TextBlock Text="Zoom:" Margin="16,0,4,0" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding Canvas.ZoomPercentage}" Foreground="{StaticResource TextBrush}"
                               MinWidth="48" FontFamily="Consolas" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding ModeHint}" Margin="24,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding Hint}" Margin="24,0,0,0" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HintIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Main area: design | canvas | properties ──────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- Design actions -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource PanelHeader}" Text="NEW FRAME" />
                    <Grid Margin="12,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Width" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource NumberBox}"
                                 Text="{Binding NewFrameWidthText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                        <TextBlock Grid.Row="1" Text="Height" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}"
                                 Text="{Binding NewFrameHeightText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                    </Grid>
                    <Button Style="{StaticResource PanelButton}" Content="Create Frame" Command="{Binding CreateFrameCommand}" />

                    <TextBlock Style="{StaticResource PanelHeader}" Text="DIVISIONS" Margin="12,20,12,8" />
                    <Button Style="{StaticResource PanelButton}" Content="Add Mullion  │" Command="{Binding AddMullionCommand}" />
                    <Button Style="{StaticResource PanelButton}" Content="Add Transom  ─" Command="{Binding AddTransomCommand}" />
                    <TextBlock Margin="12,6,12,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                               Text="With a glass panel selected, the division splits only that opening. Otherwise it spans the whole frame." />

                    <Border Margin="12,12,12,0" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                            Visibility="{Binding HasDesignMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding DesignMessage}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                    </Border>

                    <TextBlock Style="{StaticResource PanelHeader}" Text="SNAP" Margin="12,20,12,8" />
                    <CheckBox Margin="12,2" Content="Object snap" IsChecked="{Binding ObjectSnapEnabled}" Focusable="False"
                              ToolTip="Intersection › endpoint › midpoint › centre › edge" />
                    <CheckBox Margin="12,2" Content="Grid snap" IsChecked="{Binding Canvas.SnapToGrid}" Focusable="False" />
                    <Grid Margin="12,4,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Grid step" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding Canvas.GridSpacingMm}" />
                        <TextBlock Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                        <TextBlock Grid.Row="1" Text="Tolerance" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding SnapTolerancePixels}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="px" Style="{StaticResource UnitLabel}" />
                    </Grid>

                    <TextBlock Margin="12,20,12,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                               Text="Click selects, Shift+click adds, Ctrl+click toggles, drag on empty space box-selects (→ inside, ← touching). Drag frames, mullions, transoms or the frame's handles. Esc cancels, Del deletes, Ctrl+A selects all, Ctrl+Z / Ctrl+Y undo / redo." />
                </StackPanel>
            </Border>

            <!-- 2D drawing view -->
            <controls:ViewportControl x:Name="Viewport" Grid.Column="1" Viewport="{Binding Canvas}" Tool="{Binding ActiveTool}" />

            <!-- Properties -->
            <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                <StackPanel DataContext="{Binding Properties}">
                    <TextBlock Style="{StaticResource PanelHeader}" Text="PROPERTIES" />
                    <TextBlock Margin="12,0,12,8" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Text="{Binding Header}" />

                    <!-- Frame size -->
                    <StackPanel Visibility="{Binding IsFrameEditable, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="12,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Width" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Style="{StaticResource NumberBox}"
                                     Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ApplyFrameSizeCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                            <TextBlock Grid.Row="1" Text="Height" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}"
                                     Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ApplyFrameSizeCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                        </Grid>
                        <Button Style="{StaticResource PanelButton}" Content="Apply" Command="{Binding ApplyFrameSizeCommand}" />
                    </StackPanel>

                    <!-- Division position -->
                    <StackPanel Visibility="{Binding IsDivisionEditable, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="12,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PositionLabel}" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Style="{StaticResource NumberBox}"
                                     Text="{Binding PositionText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ApplyPositionCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                        </Grid>
                        <Button Style="{StaticResource PanelButton}" Content="Apply" Command="{Binding ApplyPositionCommand}" />
                    </StackPanel>

                    <Border Margin="12,8,12,4" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Items}" Margin="12,8,12,0" ItemTemplate="{StaticResource PropertyRow}" />

                    <!-- Library assignments: change glass / profile after design -->
                    <ContentControl Content="{Binding ProfilePicker}" Focusable="False" />
                    <ContentControl Content="{Binding GlassPicker}" Focusable="False" />

                    <!-- Calculated values for the selection -->
                    <StackPanel Visibility="{Binding HasCalculation, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource PanelHeader}" Text="CALCULATION" Margin="12,16,12,4" />
                        <ItemsControl ItemsSource="{Binding CalculationItems}" Margin="12,0,12,0" ItemTemplate="{StaticResource PropertyRow}" />
                    </StackPanel>
                    <Border Margin="12,8,12,4" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                            Visibility="{Binding HasCalculationMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding CalculationMessage}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                    </Border>
                </StackPanel>

                    <!-- Bill of materials for the whole project -->
                    <TextBlock Style="{StaticResource PanelHeader}" Text="BILL OF MATERIALS" Margin="12,20,12,4" />
                    <TextBlock Margin="12,0,12,6" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{Binding CostText}" />
                    <Border Margin="12,0,12,6" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                            Visibility="{Binding HasCalculationStatus, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding CalculationStatus}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding BomRows}" Margin="12,0,12,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}"
                                               ToolTip="{Binding Category}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Cost}" Margin="8,0,0,0" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" FontSize="10"
                                               TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Cutting plan (stock bars, remnants, waste) for the whole project -->
                    <StackPanel DataContext="{Binding Cutting}">
                        <TextBlock Style="{StaticResource PanelHeader}" Text="CUTTING PLAN" Margin="12,8,12,4" />
                        <TextBlock Margin="12,0,12,2" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                                   Text="{Binding SummaryText}" />
                        <TextBlock Margin="12,0,12,2" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Text="{Binding CostText}" />
                        <TextBlock Margin="12,0,12,6" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding RulesText}" />
                        <Border Margin="12,0,12,6" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Profiles}" Margin="12,0,12,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding Summary}" FontSize="10" TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <ItemsControl ItemsSource="{Binding Bars}" Margin="8,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2">
                                                        <!-- Runs on one line: XAML whitespace between them would show as a space. -->
                                                        <TextBlock Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"><Run Text="{Binding Stock, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Cuts, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock Text="{Binding Leftover}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
