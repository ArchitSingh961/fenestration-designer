                            <TextBlock Text="Invoice an order" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Width="420" ItemsSource="{Binding OrderChoices}" SelectedItem="{Binding OrderToInvoice}" AutomationProperties.Name="Order to invoice" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Make invoice" Margin="8,0,0,0" Command="{Binding DraftCommand}"
                                    ToolTip="Everything of the order not invoiced yet, at the order's prices" />
                        </StackPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Left" Width="620" Margin="0,0,14,0">
                        <TextBox DockPanel.Dock="Top" Width="260" HorizontalAlignment="Left" Margin="0,0,0,6" Style="{StaticResource SearchBox}" Tag="Search invoices"
                                 Text="{Binding InvoiceSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search invoices" />
