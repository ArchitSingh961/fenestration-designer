<Window x:Class="Mark.Designer.Views.SaveChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PanelBackgroundBrush}"
        FocusManager.FocusedElement="{Binding ElementName=SaveButton}">
    <StackPanel Margin="20,18,20,16">
        <TextBlock x:Name="Question" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
        <TextBlock x:Name="Detail" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="SaveButton" Content="_Save" MinWidth="88" Padding="10,4" IsDefault="True" Click="Save_Click" />
            <Button Content="_Don't save" MinWidth="88" Padding="10,4" Margin="8,0,0,0" Click="DontSave_Click" />
            <Button Content="Cancel" MinWidth="88" Padding="10,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
