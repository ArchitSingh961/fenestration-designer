                                <GridView>
                                    <GridViewColumn Header="Invoice" Width="125" DisplayMemberBinding="{Binding Number}" />
                                    <GridViewColumn Header="Date" Width="80" DisplayMemberBinding="{Binding Date}" />
                                    <GridViewColumn Header="Client" Width="140" DisplayMemberBinding="{Binding Client}" />
                                    <GridViewColumn Header="Order" Width="80" DisplayMemberBinding="{Binding Order}" />
                                    <GridViewColumn Header="Total" Width="105" DisplayMemberBinding="{Binding Total}" />
                                    <GridViewColumn Header="" Width="70" DisplayMemberBinding="{Binding Status}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
