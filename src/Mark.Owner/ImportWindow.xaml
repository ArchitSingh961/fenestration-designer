<Window x:Class="Mark.Owner.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import a library file" Width="560" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="White">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" MinWidth="90" />
                <Button x:Name="ImportButton" Style="{StaticResource PrimaryButton}" Content="Import" IsDefault="True" MinWidth="90"
                        Click="Import_Click" />
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,12">
                <TextBlock x:Name="FileText" FontSize="16" FontWeight="SemiBold" Foreground="#1F2A37" TextWrapping="Wrap" />
                <TextBlock x:Name="ContentText" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,14" TextWrapping="Wrap" />

                <TextBlock Text="Where does it go?" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6" />

                <RadioButton x:Name="AddOption" GroupName="Destination" Margin="0,4" Checked="Destination_Changed" AutomationProperties.Name="Universal catalogue: add these items">
                    <StackPanel>
                        <TextBlock Text="Universal catalogue: add these items" FontWeight="SemiBold" />
                        <TextBlock Text="Everything in the catalogue stays; items whose id is already used are kept as they are."
                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ReplaceOption" GroupName="Destination" Margin="0,4" Checked="Destination_Changed" AutomationProperties.Name="Universal catalogue: replace it with this file">
                    <StackPanel>
                        <TextBlock Text="Universal catalogue: replace it with this file" FontWeight="SemiBold" />
                        <TextBlock Text="The whole catalogue becomes this file. Companies lose catalogue items that are not in it (their saved quotes keep their copy)."
                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CompanyOption" GroupName="Destination" Margin="0,4" Checked="Destination_Changed" AutomationProperties.Name="One company's own items">
                    <StackPanel>
                        <TextBlock Text="One company's own items" FontWeight="SemiBold" />
                        <TextBlock Text="Only this company gets them, under its name in its MARK; profiles go in a tab per series."
                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
                <ComboBox x:Name="CompanyBox" Margin="24,4,0,4" Padding="8,5" DisplayMemberPath="Name" AutomationProperties.Name="Company"
                          SelectionChanged="CompanyBox_SelectionChanged" />

                <StackPanel x:Name="GivePanel" Margin="0,14,0,0">
                    <TextBlock Text="Give its systems to" FontWeight="SemiBold" Foreground="#374151" />
                    <TextBlock Text="Companies get only the systems ticked in their account. Tick the companies that should get this file's systems now (the rest of what they have stays)."
                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,6" />
                    <ItemsControl x:Name="GiveList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
