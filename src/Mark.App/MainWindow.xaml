<Window x:Class="Mark.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Mark.Designer.Controls;assembly=Mark.Designer"
        xmlns:views="clr-namespace:Mark.Designer.Views;assembly=Mark.Designer"
        xmlns:vm="clr-namespace:Mark.Designer.ViewModels;assembly=Mark.Designer"
        Title="{Binding Title}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ChromeBackgroundBrush}">

    <Window.Resources>
        <views:EnumToBooleanConverter x:Key="EnumToBool" />
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <views:EnumToVisibilityConverter x:Key="EnumToVisibility" />
        <views:FractionToWidthConverter x:Key="FractionToWidth" />
        <views:CountToVisibilityConverter x:Key="CountToVisibility" />
        <views:CountToVisibilityConverter x:Key="CountToCollapsed" Invert="True" />

        <!-- Design details of the selected frame (reference, quantity, where it goes). -->
        <DataTemplate DataType="{x:Type vm:DesignInfoEditorViewModel}">
            <StackPanel Margin="12,0,12,8">
                <StackPanel.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ApplyCommand}" />
                </StackPanel.InputBindings>
                <TextBlock Text="DESIGN" Style="{StaticResource PanelHeader}" Margin="0,2,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Design ref." Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" Padding="4,2" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Shown above the drawing and in quotes, e.g. W1" />
                    <TextBlock Grid.Row="1" Text="Quantity" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="pcs" Style="{StaticResource UnitLabel}" />
                    <TextBlock Grid.Row="2" Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" Padding="4,2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="3" Text="Location" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" Padding="4,2" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" Text="Floor" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" Padding="4,2" Text="{Binding Floor, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="5" Text="Floor distance" Style="{StaticResource FieldLabel}"
                               ToolTip="Height of the bottom of the frame above the finished floor. Empty = no floor line." />
                    <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding FloorDistanceText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                    <TextBlock Grid.Row="6" Text="Note" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,4,0,0" />
                    <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2" Padding="4,2" TextWrapping="Wrap" MinHeight="38"
                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Button Content="Apply details" Command="{Binding ApplyCommand}" Margin="0,6,0,0" Padding="8,4" HorizontalAlignment="Left" />
                <Border Margin="0,6,0,0" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- How the selected opening(s) open, and the mesh shutter. -->
        <DataTemplate DataType="{x:Type vm:OpeningEditorViewModel}">
            <StackPanel Margin="12,4,12,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                              DisplayMemberPath="Name" ToolTip="How the opening opens, seen from inside" />
                </Grid>
                <CheckBox Margin="90,6,0,0" Content="Insect mesh shutter" IsChecked="{Binding HasMesh}" Focusable="False" />
                <Border Margin="0,6,0,0" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- A name / value / unit row of the properties panel. -->
        <DataTemplate x:Key="PropertyRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextAlignment="Right"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding Unit}" Margin="4,0,0,0"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </DataTemplate>

        <!-- Searchable library selection (glass type / profile) in the properties panel. -->
        <DataTemplate DataType="{x:Type vm:LibraryPickerViewModel}">
            <StackPanel Margin="12,10,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding CurrentText}" TextWrapping="Wrap" TextAlignment="Right"
                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Search" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Padding="4,2" ToolTip="Filter the library by name, code, type or series"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <ComboBox Margin="0,4,0,0" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                          ToolTip="Choose a library item to assign it">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,1">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding ResultSummary}" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0"
                           Foreground="{StaticResource MutedTextBrush}" />
                <Border Margin="0,4,0,0" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                </Border>
            </StackPanel>
        </DataTemplate>
        <!-- Bill of materials for the whole project (with the costing feature): properties panel and Pricing › Bill of materials. -->
        <DataTemplate x:Key="BillOfMaterialsPanel">
            <StackPanel>
                                    <!-- Bill of materials for the whole project (with the costing feature) -->
                                    <ContentControl Style="{StaticResource LockNotice}" Margin="10,18,10,6" Content="{Binding Access.CostingLock}"
                                                    Visibility="{Binding Access.CanSeeCosting, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <StackPanel Visibility="{Binding Access.CanSeeCosting, Converter={StaticResource BoolToVisibility}}">
                                    <!-- Bill of materials: total with a cost bar, then colour-coded groups -->
                                    <Border Margin="10,18,10,6" Padding="14,12" CornerRadius="8" Background="White"
                                            BorderBrush="#DDE1E6" BorderThickness="1"
                                            Visibility="{Binding BomGroups.Count, Converter={StaticResource CountToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="BILL OF MATERIALS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}" />
                                            <TextBlock Text="{Binding CostText}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"
                                                       Foreground="#1F2A37" />
                                            <TextBlock Text="{Binding BomSummaryText}" FontSize="10" TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <!-- Share of each group in the cost -->
                                            <Border x:Name="BomBar" Margin="0,10,0,4" Height="8" CornerRadius="4" Background="#EEF0F3" ClipToBounds="True">
                                                <ItemsControl ItemsSource="{Binding BomGroups}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Rectangle Height="8" Fill="{Binding Accent}" ToolTip="{Binding Title}">
                                                                <Rectangle.Width>
                                                                    <MultiBinding Converter="{StaticResource FractionToWidth}">
                                                                        <Binding Path="Share" />
                                                                        <Binding Path="ActualWidth" ElementName="BomBar" />
                                                                    </MultiBinding>
                                                                </Rectangle.Width>
                                                            </Rectangle>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                            <!-- Legend -->
                                            <ItemsControl ItemsSource="{Binding BomGroups}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,10,0">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding Accent}" VerticalAlignment="Center" />
                                                            <TextBlock Margin="4,0,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}">
                                                                <Run Text="{Binding Title, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding ShareText, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="12,18,12,4" Style="{StaticResource PanelHeader}" Text="BILL OF MATERIALS"
                                               Visibility="{Binding BomGroups.Count, Converter={StaticResource CountToCollapsed}}" />
                                    <Border Margin="10,0,10,6" Padding="8" CornerRadius="6" Background="{StaticResource ErrorBackgroundBrush}"
                                            Visibility="{Binding HasCalculationStatus, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding CalculationStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource ErrorBrush}" />
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding BomGroups}" Margin="10,0,10,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" CornerRadius="8" Background="White" BorderBrush="#E3E6EA" BorderThickness="1"
                                                        ClipToBounds="True">
                                                    <StackPanel>
                                                        <ToggleButton IsChecked="{Binding IsExpanded}" Style="{StaticResource BomGroupHeader}" />
                                                        <ItemsControl ItemsSource="{Binding Items}"
                                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="#F0F2F5" BorderThickness="0,1,0,0" Padding="12,7,12,7">
                                                                        <StackPanel>
                                                                            <DockPanel>
                                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Cost}" FontWeight="SemiBold"
                                                                                           Foreground="#1F2A37" Margin="8,0,0,0" />
                                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                                                           Foreground="#1F2A37" ToolTip="{Binding Name}" />
                                                                            </DockPanel>
                                                                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                                                       Margin="0,1,0,0" />
                                                                            <ItemsControl ItemsSource="{Binding SubLines}" Margin="2,4,0,0"
                                                                                          Visibility="{Binding HasSubLines, Converter={StaticResource BoolToVisibility}}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Border BorderBrush="#BFE7EC" BorderThickness="2,0,0,0" Padding="7,1,0,1">
                                                                                            <DockPanel>
                                                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Cost}" FontSize="10"
                                                                                                           Foreground="#4B5563" />
                                                                                                <TextBlock Text="{Binding Text}" FontSize="10" Foreground="#4B5563"
                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                            </DockPanel>
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    </StackPanel>

            </StackPanel>
        </DataTemplate>

        <!-- Cutting plan for the whole project (with the cutting-plans feature): properties panel and Production › Cutting plan. -->
        <DataTemplate x:Key="CuttingPlanPanel">
            <StackPanel>
                                    <!-- Cutting plan (stock bars, remnants, waste) for the whole project (with the cutting-plans feature) -->
                                    <ContentControl Style="{StaticResource LockNotice}" Margin="10,8,10,12" Content="{Binding Access.CuttingPlansLock}"
                                                    Visibility="{Binding Access.CanSeeCuttingPlans, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <StackPanel DataContext="{Binding Cutting}"
                                                Visibility="{Binding DataContext.Access.CanSeeCuttingPlans, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource PanelHeader}" Text="CUTTING PLAN" Margin="12,8,12,4" />
                                        <TextBlock Margin="12,0,12,2" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                                                   Text="{Binding SummaryText}" />
                                        <TextBlock Margin="12,0,12,2" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Text="{Binding CostText}"
                                                   Visibility="{Binding ShowsCosts, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Margin="12,0,12,6" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding RulesText}" />
                                        <Border Margin="12,0,12,6" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                                                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Profiles}" Margin="12,0,12,12">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,4">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                        <TextBlock Text="{Binding Summary}" FontSize="10" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                        <ItemsControl ItemsSource="{Binding Bars}" Margin="8,2,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="0,2">
                                                                        <!-- Runs on one line: XAML whitespace between them would show as a space. -->
                                                                        <TextBlock Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"><Run Text="{Binding Stock, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Cuts, Mode=OneWay}" /></TextBlock>
                                                                        <TextBlock Text="{Binding Leftover}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- A tab of the current area in the header (lock: not in the package). -->
        <Style x:Key="AreaTabButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="14,6" Margin="2,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5FB" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3EDFB" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An area in the area bar on the left. -->
        <Style x:Key="AreaRailButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#C9D1DC" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" Margin="6,2" CornerRadius="6" Padding="2,8">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </Border>
                            <Rectangle x:Name="Marker" Width="3" HorizontalAlignment="Left" Margin="0,10" Fill="#6AA6F5" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B3A4D" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33465E" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A line of quote history (Client tab, dashboard). -->
        <DataTemplate x:Key="HistoryLine">
            <Border BorderBrush="#F0F2F5" BorderThickness="0,1,0,0" Padding="0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding When}" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Who}" FontWeight="SemiBold" Foreground="#1F2A37" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="#1F2A37" TextTrimming="CharacterEllipsis"><Run Text="{Binding What, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Quote, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewProjectCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- ── Menu ─────────────────────────────────────────────── -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource ChromeBackgroundBrush}" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_New Quote" InputGestureText="Ctrl+N" Command="{Binding NewProjectCommand}" />
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Command="{Binding OpenProjectCommand}" />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveProjectCommand}" />
                <MenuItem Header="Save a _Copy As..." Command="{Binding SaveProjectAsCommand}" />
                <Separator />
                <MenuItem Header="_Import Project File..." Command="{Binding ImportProjectFileCommand}" />
                <MenuItem Header="_Export Project File..." Command="{Binding ExportProjectFileCommand}" />
                <Separator />
                <MenuItem Header="_Library Manager..." Command="{Binding OpenLibraryManagerCommand}" />
                <Separator />
                <MenuItem Header="_Account" Command="{Binding ShowPageCommand}" CommandParameter="Account"
                          Visibility="{Binding HasAccount, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="S_taff Logins" Command="{Binding ShowViewCommand}" CommandParameter="Staff"
                          Visibility="{Binding HasStaff, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="Sign _Out" Command="{Binding Account.SignOutCommand}"
                          Visibility="{Binding HasAccount, Converter={StaticResource BoolToVisibility}}" />
                <Separator Visibility="{Binding HasAccount, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit" Visibility="{Binding Access.CanUseDrawing, Converter={StaticResource BoolToVisibility}}">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" />
                <MenuItem Header="_Delete" InputGestureText="Del" Command="{Binding DeleteSelectedCommand}" />
            </MenuItem>
            <MenuItem Header="_View" Visibility="{Binding Access.CanUseDrawing, Converter={StaticResource BoolToVisibility}}">
                <MenuItem Header="Zoom _In" Command="{Binding Canvas.ZoomInCommand}" />
                <MenuItem Header="Zoom _Out" Command="{Binding Canvas.ZoomOutCommand}" />
                <MenuItem Header="_Fit to Screen" InputGestureText="F" Command="{Binding Canvas.FitCommand}" />
                <MenuItem Header="_Reset View" Command="{Binding Canvas.ResetViewCommand}" />
                <Separator />
                <MenuItem Header="Show _Grid" InputGestureText="G" IsCheckable="True" IsChecked="{Binding Canvas.ShowGrid}" />
                <MenuItem Header="Show _Axes" IsCheckable="True" IsChecked="{Binding Canvas.ShowAxes}" />
                <Separator />
                <MenuItem Header="_Inside View" IsCheckable="True" IsChecked="{Binding IsInsideView}" />
                <MenuItem Header="_Outside View" IsCheckable="True" IsChecked="{Binding IsOutsideView}" />
            </MenuItem>
            <!-- The areas this login may see. -->
            <MenuItem Header="_Go" ItemsSource="{Binding Areas}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <Setter Property="Command" Value="{Binding ShowCommand}" />
                        <Setter Property="CommandParameter" Value="{Binding Area}" />
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="_Design" Visibility="{Binding Access.CanUseDrawing, Converter={StaticResource BoolToVisibility}}">
                <MenuItem Header="Create _Frame (typed size)" Command="{Binding CreateFrameCommand}" />
                <MenuItem Header="Add _Mullion (centred)" Command="{Binding AddMullionCommand}" />
                <MenuItem Header="Add _Transom (centred)" Command="{Binding AddTransomCommand}" />
            </MenuItem>
            <MenuItem Header="_Tools" Visibility="{Binding Access.CanUseDrawing, Converter={StaticResource BoolToVisibility}}">
                <MenuItem Header="_Select" Command="{Binding SetModeCommand}" CommandParameter="Select" />
                <MenuItem Header="_Pan" Command="{Binding SetModeCommand}" CommandParameter="Pan" />
                <MenuItem Header="Draw _Frame" Command="{Binding SetModeCommand}" CommandParameter="CreateFrame" />
                <MenuItem Header="Place _Mullion" Command="{Binding SetModeCommand}" CommandParameter="AddMullion" />
                <MenuItem Header="Place _Transom" Command="{Binding SetModeCommand}" CommandParameter="AddTransom" />
                <Separator />
                <MenuItem Header="_Object Snap" IsCheckable="True" IsChecked="{Binding ObjectSnapEnabled}" />
                <MenuItem Header="Snap to _Grid" IsCheckable="True" IsChecked="{Binding Canvas.SnapToGrid}" />
            </MenuItem>
        </Menu>

        <!-- ── Header: navigation and the open quote ──────────────── -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource RowButton}" Margin="0,0,14,0" Command="{Binding ShowPageCommand}" CommandParameter="Account"
                            ToolTip="Your account: licence, package and licence keys"
                            Visibility="{Binding HasAccount, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Access.Logo}" Height="28" MaxWidth="90" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Visibility="{Binding Access.HasLogo, Converter={StaticResource BoolToVisibility}}" />
                            <Border Width="28" Height="28" CornerRadius="14" Background="#E8EEF7" Margin="0,0,8,0"
                                    Visibility="{Binding Access.HasLogo, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="&#xE731;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Access.CompanyName}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                           MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Access.UserName}" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                           MaxWidth="220" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding QuoteTotalText}" VerticalAlignment="Center" Margin="0,0,14,0"
                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="New quote" Command="{Binding NewProjectCommand}"
                            ToolTip="Start a new quote (Ctrl+N)"
                            Visibility="{Binding Access.CanEditQuotes, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Save" Command="{Binding SaveProjectCommand}"
                            ToolTip="Save the quote (Ctrl+S)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="MARK" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" Margin="6,0,14,0" />
                    <Rectangle Width="1" Height="22" Fill="{StaticResource BorderBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#1F2A37"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <!-- The tabs of the current area (only those this login may see; locked: not in the package). -->
                    <ItemsControl ItemsSource="{Binding Tabs}" VerticalAlignment="Center" Focusable="False"
                                  Visibility="{Binding ShowsTabs, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AreaTabButton}" Command="{Binding ShowCommand}" CommandParameter="{Binding View}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
                                                   Foreground="#B7791F" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Title}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Licence notice: why MARK is read-only, or a warning (licence ending, offline) ── -->
        <Border DockPanel.Dock="Top" Padding="14,7" BorderThickness="0,0,0,1"
                Visibility="{Binding Access.HasNotice, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFF8E6" />
                    <Setter Property="BorderBrush" Value="#F2D9A0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Access.IsReadOnly}" Value="True">
                            <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="#EBC4C4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Account" Command="{Binding ShowPageCommand}"
                        CommandParameter="Account" Visibility="{Binding HasAccount, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="#B7791F" />
                <TextBlock Text="{Binding Access.Notice}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#3F2A00" />
            </DockPanel>
        </Border>

        <!-- ── Status bar ───────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Background="{StaticResource PanelBackgroundBrush}" Padding="12,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding Canvas.CursorText}" Foreground="{StaticResource TextBrush}"
                               MinWidth="230" FontFamily="Consolas" />
                    <TextBlock Text="Zoom:" Margin="16,0,4,0" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding Canvas.ZoomPercentage}" Foreground="{StaticResource TextBrush}"
                               MinWidth="48" FontFamily="Consolas" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding ModeHint}" Margin="24,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding Hint}" Margin="24,0,0,0" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HintIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Area bar: the areas this login may see (lock: not in the package; dim: coming later) ── -->
        <Border DockPanel.Dock="Left" Background="#1F2A37" Width="80">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                <ItemsControl ItemsSource="{Binding Areas}" Margin="0,8" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource AreaRailButton}" Command="{Binding ShowCommand}" CommandParameter="{Binding Area}"
                                    ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Name}"
                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Width="62">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsComingLater}" Value="True">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Grid HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" />
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="0,-3,-13,0"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#F2C14E"
                                                   Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ── Pages ──────────────────────────────────────────────── -->
        <Grid>
            <!-- ══ Dashboard ══════════════════════════════════════════ -->
            <ScrollViewer DataContext="{Binding Dashboard}" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Background="{StaticResource PageBackgroundBrush}"
                          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Dashboard}">
                <StackPanel Margin="24,18,24,24">
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Create quote"
                                Command="{Binding NewQuoteCommand}" />
                        <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                    </DockPanel>
                    <Border Padding="10" Margin="0,0,0,12" Background="{StaticResource ErrorBackgroundBrush}"
                            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Tiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,14">
                                    <DockPanel>
                                        <Rectangle DockPanel.Dock="Left" Width="4" RadiusX="2" RadiusY="2" Margin="0,0,12,0"
                                                   Fill="{Binding Accent}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Count}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Quote value by status" Style="{StaticResource CardTitle}" />
                                <ItemsControl ItemsSource="{Binding ValueByStatus}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                                <StackPanel Grid.Column="1">
                                                    <ProgressBar Height="12" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                                                 Foreground="{Binding Accent}" Background="#EEF0F3" BorderThickness="0" />
                                                    <TextBlock Text="{Binding Value}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding WinRateText}" Margin="0,12,0,0" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Recent quotes" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="No quotes saved yet. Create a quote, add the client and their designs, then Save."
                                           Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecentQuotes.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding RecentQuotes}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Open this quote">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="140" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Client}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Value}" TextAlignment="Right" Foreground="{StaticResource TextBrush}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Sales charts: by week or month; by person and city -->
                    <ContentControl Style="{StaticResource LockNotice}" Margin="0,16,0,0" MaxWidth="560" HorizontalAlignment="Left"
                                    Content="{Binding DataContext.Access.SalesChartsLock, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding DataContext.Access.CanSeeSalesCharts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                    <StackPanel DataContext="{Binding DataContext.SalesCharts, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding DataContext.Access.CanSeeSalesCharts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="16">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource FilterTab}" Content="By week" IsChecked="{Binding IsWeeks}" />
                                            <RadioButton Style="{StaticResource FilterTab}" Content="By month" IsChecked="{Binding IsMonths}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Enquiries, quotes, won and lost" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- Legend -->
                                    <ItemsControl ItemsSource="{Binding Legend}" Margin="0,8,0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                    <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Color}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" Margin="5,0,0,0" FontSize="11" Foreground="#374151" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Grouped bars per period, from a common baseline -->
                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,6,0,0">
                                        <ItemsControl ItemsSource="{Binding Columns}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ItemsControl ItemsSource="{Binding Bars}" Height="124" HorizontalAlignment="Center" Background="Transparent">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="7" Height="{Binding Height}" Margin="1,0" CornerRadius="3,3,0,0" Background="{Binding Color}"
                                                                        VerticalAlignment="Bottom" ToolTip="{Binding ToolTip}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Columns}" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Value won" FontWeight="SemiBold" Foreground="#1F2A37" Margin="0,16,0,4" />
                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                        <ItemsControl ItemsSource="{Binding Columns}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="124" Background="Transparent" ToolTip="{Binding ValueToolTip}">
                                                        <Border Width="16" Height="{Binding ValueHeight}" CornerRadius="3,3,0,0" Background="#2A78D6"
                                                                VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Columns}" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- The same numbers as a table -->
                                    <Expander Header="Show the numbers" Margin="0,12,0,0" Foreground="#374151">
                                        <ListView ItemsSource="{Binding Columns}" BorderThickness="0" Margin="0,6,0,0" MaxHeight="320">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Period" Width="170" DisplayMemberBinding="{Binding LongLabel}" />
                                                    <GridViewColumn Header="Enquiries" Width="75" DisplayMemberBinding="{Binding Counts[0]}" />
                                                    <GridViewColumn Header="Quotes" Width="65" DisplayMemberBinding="{Binding Counts[1]}" />
                                                    <GridViewColumn Header="Won" Width="55" DisplayMemberBinding="{Binding Counts[2]}" />
                                                    <GridViewColumn Header="Lost" Width="55" DisplayMemberBinding="{Binding Counts[3]}" />
                                                    <GridViewColumn Header="Value won" Width="110" DisplayMemberBinding="{Binding WonValueText}" />
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Expander>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Sales by person" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Quotes each person created in the period." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" />
                                        <ListView ItemsSource="{Binding People}" BorderThickness="0" MaxHeight="240">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Person" Width="120" DisplayMemberBinding="{Binding Name}" />
                                                    <GridViewColumn Header="Quotes" Width="55" DisplayMemberBinding="{Binding Quotes}" />
                                                    <GridViewColumn Header="Won" Width="45" DisplayMemberBinding="{Binding Won}" />
                                                    <GridViewColumn Header="Win rate" Width="65" DisplayMemberBinding="{Binding WinRate}" />
                                                    <GridViewColumn Header="Value won" Width="95" DisplayMemberBinding="{Binding WonValue}" />
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Sales by city" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="The client's city of quotes created in the period." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" />
                                        <ListView ItemsSource="{Binding Cities}" BorderThickness="0" MaxHeight="240">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="City" Width="140" DisplayMemberBinding="{Binding City}" />
                                                    <GridViewColumn Header="Quotes" Width="60" DisplayMemberBinding="{Binding Quotes}" />
                                                    <GridViewColumn Header="Won" Width="50" DisplayMemberBinding="{Binding Won}" />
                                                    <GridViewColumn Header="Value won" Width="110" DisplayMemberBinding="{Binding WonValue}" />
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Who did what: the latest changes to all quotes -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0"
                            Visibility="{Binding HasRecentActivity, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Recent activity" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Who created, saved or deleted which quote, and what changed." FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" />
                            <ItemsControl ItemsSource="{Binding RecentActivity}" ItemTemplate="{StaticResource HistoryLine}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Quotes ═════════════════════════════════════════════ -->
            <DockPanel DataContext="{Binding Quotes}" Background="{StaticResource PageBackgroundBrush}"
                       Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Quotes}">
                <DockPanel DockPanel.Dock="Top" Margin="24,18,24,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Create quote"
                            Command="{Binding NewQuoteCommand}" />
                    <TextBlock Text="Quotes" Style="{StaticResource PageTitle}" />
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="24,0,24,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBox Width="240" Padding="6,4" VerticalContentAlignment="Center" ToolTip="Search by quote number, project or client"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource FilterTab}" Content="{Binding ActiveHeader}"
                                     IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Active}" />
                        <RadioButton Style="{StaticResource FilterTab}" Content="{Binding WonHeader}"
                                     IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Won}" />
                        <RadioButton Style="{StaticResource FilterTab}" Content="{Binding LostHeader}"
                                     IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Lost}" />
                        <RadioButton Style="{StaticResource FilterTab}" Content="{Binding AllHeader}"
                                     IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=All}" />
                    </StackPanel>
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="24,8,24,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="Delete" Command="{Binding DeleteCommand}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Open" Command="{Binding OpenCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                </DockPanel>
                <Border Style="{StaticResource Card}" Margin="24,0,24,0" Padding="0">
                    <ListView ItemsSource="{Binding Quotes}" SelectedItem="{Binding SelectedQuote}" BorderThickness="0"
                              Background="Transparent">
                        <ListView.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}" />
                            <KeyBinding Key="Enter" Command="{Binding OpenCommand}" />
                        </ListView.InputBindings>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="4,6" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Quote no." Width="100" DisplayMemberBinding="{Binding Number}" />
                                <GridViewColumn Header="Project" Width="200" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Client" Width="170" DisplayMemberBinding="{Binding Client}" />
                                <GridViewColumn Header="Status" Width="70" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="Order" Width="85" DisplayMemberBinding="{Binding Order}" />
                                <GridViewColumn Header="Designs" Width="65" DisplayMemberBinding="{Binding Designs}" />
                                <GridViewColumn Header="Qty" Width="50" DisplayMemberBinding="{Binding Quantity}" />
                                <GridViewColumn Header="Area" Width="80" DisplayMemberBinding="{Binding Area}" />
                                <GridViewColumn Header="Value" Width="140" DisplayMemberBinding="{Binding Value}" />
                                <GridViewColumn Header="Saved by" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ModifiedBy}" ToolTip="{Binding AuthorsText}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Last change" Width="130" DisplayMemberBinding="{Binding Modified}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </DockPanel>

            <!-- ══ Account: company, licence, products, package features, licence keys ══ -->
            <ScrollViewer DataContext="{Binding Account}" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Background="{StaticResource PageBackgroundBrush}"
                          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Account}">
                <StackPanel Margin="24,18,24,24" MaxWidth="1100">
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="Staff logins"
                                    Command="{Binding DataContext.ShowViewCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Staff"
                                    ToolTip="Give your staff their own sign-in, with only the parts of MARK they need"
                                    Visibility="{Binding DataContext.HasStaff, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Check now" Command="{Binding CheckNowCommand}"
                                    ToolTip="Ask the licence server for your current licence" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Sign out" Command="{Binding SignOutCommand}"
                                    ToolTip="Sign out of MARK on this computer (frees it for another computer)" />
                        </StackPanel>
                        <TextBlock Text="Account" Style="{StaticResource PageTitle}" />
                    </DockPanel>

                    <Border Padding="10" Margin="0,0,0,12" CornerRadius="6" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F6EE" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1D6B3A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <!-- Company and licence -->
                        <Border Style="{StaticResource Card}" Padding="20,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <Grid DockPanel.Dock="Left" Width="64" Height="64" Margin="0,0,16,0">
                                        <Border CornerRadius="8" Background="#E8EEF7"
                                                Visibility="{Binding DataContext.Access.HasLogo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock Text="&#xE731;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{Binding DataContext.Access.Logo, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="Uniform" />
                                    </Grid>
                                    <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,3" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E8F6EE" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1D6B3A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CompanyName}" FontSize="20" FontWeight="SemiBold" Foreground="#1F2A37" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding CompanyType}" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </DockPanel>
                                <Border Padding="10" Margin="0,0,0,12" CornerRadius="6" Background="#FFF8E6"
                                        Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#3F2A00" />
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Signed in as" Style="{StaticResource FormLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UserText}" Margin="0,4,0,3" Foreground="#1F2A37" />
                                    <TextBlock Grid.Row="1" Text="Package" Style="{StaticResource FormLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PackageName}" Margin="0,4,0,3" Foreground="#1F2A37" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Text="Licence valid until" Style="{StaticResource FormLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ValidUntilText}" Margin="0,4,0,3" Foreground="#1F2A37" />
                                    <TextBlock Grid.Row="3" Text="Computers" Style="{StaticResource FormLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ComputersText}" Margin="0,4,0,3" Foreground="#1F2A37" />
                                    <TextBlock Grid.Row="4" Text="Licence server" Style="{StaticResource FormLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ServerText}" Margin="0,4,0,3" Foreground="#1F2A37" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastCheckText}" Margin="0,4,0,3" FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Products and licence key -->
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Products" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Products}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#C9CED6" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                                        <Setter Property="Fill" Value="#2F9E5B" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1F2A37" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="Licence key" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Enter a key from your MARK supplier to renew, or to add a product or feature." TextWrapping="Wrap"
                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Use key" Command="{Binding RedeemKeyCommand}" />
                                        <TextBox Style="{StaticResource FormBox}" Margin="0" FontFamily="Consolas" CharacterCasing="Upper"
                                                 Text="{Binding KeyText, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding RedeemKeyCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Package features by area -->
                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding FeaturesTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding FeatureGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,8,18,4">
                                            <TextBlock Text="{Binding Area}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}"
                                                       Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding Features}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,3" ToolTip="{Binding Description}">
                                                            <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,2,8,0"
                                                                       VerticalAlignment="Top">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="&#xE72E;" />
                                                                        <Setter Property="Foreground" Value="#A0A7B1" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsIncluded}" Value="True">
                                                                                <Setter Property="Text" Value="&#xE73E;" />
                                                                                <Setter Property="Foreground" Value="#2F9E5B" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" Foreground="#1F2A37" />
                                                                <TextBlock Text="{Binding State}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Library: the company's systems and products; the Library Manager ══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Background="{StaticResource PageBackgroundBrush}"
                          Visibility="{Binding Page, Converter={StaticResource EnumToVisibility}, ConverterParameter=Library}">
                <StackPanel Margin="24,18,24,24" MaxWidth="1100">
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Open Library Manager"
                                Command="{Binding OpenLibraryManagerCommand}" />
                        <TextBlock Text="Library" Style="{StaticResource PageTitle}" />
                    </DockPanel>
                    <ContentControl Style="{StaticResource LockNotice}" Content="{Binding Access.LibraryLock}" Margin="0,0,0,12"
                                    MaxWidth="560" HorizontalAlignment="Left"
                                    Visibility="{Binding Access.CanUseLibrary, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding LibraryModeText}" TextWrapping="Wrap" Foreground="#1F2A37" />
                            <TextBlock Text="{Binding LibraryCountsText}" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="Systems" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                            <TextBlock Text="A window is made in a system: its profiles, glass, steel and hardware come from it." FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding LibrarySystems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0F2F5" BorderThickness="0,1,0,0" Padding="0,7">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1F2A37" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ An area still to come (Orders, Purchasing, Inventory, Accounts): what it will do ══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Background="{StaticResource PageBackgroundBrush}"
                          Visibility="{Binding Page, Converter={StaticResource EnumToVisibility}, ConverterParameter=Overview}">
                <StackPanel Margin="24,18,24,24" MaxWidth="900" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding AreaInfo.Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding AreaInfo.Name}" Style="{StaticResource PageTitle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AreaInfo.Description}" Foreground="#4B5563" Margin="0,0,0,14" />
                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="Coming in a later version of MARK" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="This area is being built. When it is released it opens here, for everyone whose package includes it."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8" />
                            <ItemsControl ItemsSource="{Binding OverviewFeatures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0F2F5" BorderThickness="0,1,0,0" Padding="0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1F2A37" />
                                                <TextBlock Text="{Binding Description}" Foreground="#4B5563" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding State}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Staff: logins for the company's people (the account owner only) ══ -->
            <ScrollViewer x:Name="StaffPage" DataContext="{Binding Staff}" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Background="{StaticResource PageBackgroundBrush}"
                          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Staff}">
                <StackPanel Margin="24,18,24,24" MaxWidth="1150">
                    <DockPanel Margin="0,0,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Add staff login" Command="{Binding AddCommand}" />
                        </StackPanel>
                        <TextBlock Text="Staff logins" Style="{StaticResource PageTitle}" />
                    </DockPanel>
                    <TextBlock Text="{Binding UsersText}" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"
                               Text="Give each person their own User ID and password, and only the parts of MARK they need: a cutter can see only Production, a salesperson Sales, Design and Pricing. Changes reach their MARK at its next check-in, or when they sign in." />

                    <Border Padding="10" Margin="0,0,0,12" CornerRadius="6" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F6EE" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1D6B3A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="6*" />
                        </Grid.ColumnDefinitions>

                        <!-- The staff logins -->
                        <Border Style="{StaticResource Card}" Padding="16,12" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="No staff logins yet. Add one for each person who works in MARK." TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,4"
                                           Visibility="{Binding HasStaff, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Staff}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Command="{Binding DataContext.EditCommand, ElementName=StaffPage}"
                                                    CommandParameter="{Binding}" ToolTip="Change this login" AutomationProperties.Name="{Binding Name}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="#E8EEF7" Margin="0,0,12,0">
                                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel>
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.55" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Foreground="#1F2A37"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding UserId, Mode=OneWay}" Foreground="#6B7280" /></TextBlock>
                                                        <TextBlock Text="{Binding AreasText}" Foreground="#374151" />
                                                        <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- The login being added or changed -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16" VerticalAlignment="Top" DataContext="{Binding Editor}"
                                Visibility="{Binding DataContext.HasEditor, ElementName=StaffPage, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Name *" Style="{StaticResource FormLabel}" />
                                        <TextBox Style="{StaticResource FormBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="User ID *" Style="{StaticResource FormLabel}" />
                                        <TextBox Style="{StaticResource FormBox}" Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding PasswordLabel}" Style="{StaticResource FormLabel}" />
                                <TextBox Style="{StaticResource FormBox}" FontFamily="Consolas" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="At least 6 characters. Tell the person their User ID and password." />
                                <CheckBox Content="Turned off (cannot sign in, does not count towards your logins)" IsChecked="{Binding IsDisabled}"
                                          Margin="0,0,0,10" Foreground="#374151" />

                                <TextBlock Text="What this person may use" FontWeight="SemiBold" Foreground="#1F2A37" Margin="0,4,0,2" />
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Quick choice:" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,2,0" />
                                    <ItemsControl ItemsSource="{Binding DataContext.Presets, ElementName=StaffPage}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SecondaryButton}" Content="{Binding Name}" ToolTip="{Binding Description}"
                                                        Padding="10,3" Margin="6,2,0,2" AutomationProperties.Name="{Binding Name, StringFormat=Quick choice {0}}"
                                                        Command="{Binding DataContext.PresetCommand, ElementName=StaffPage}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,6,12,4">
                                                <TextBlock Text="{Binding Area}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}" Margin="0,0,0,2" />
                                                <ItemsControl ItemsSource="{Binding Features}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" ToolTip="{Binding Description}"
                                                                      Margin="0,2" Foreground="#1F2A37" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <DockPanel Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="Remove login" Margin="0"
                                            Command="{Binding DataContext.DeleteCommand, ElementName=StaffPage}"
                                            Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding DataContext.CancelCommand, ElementName=StaffPage}" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="Save login" Command="{Binding DataContext.SaveCommand, ElementName=StaffPage}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Enquiries: the list, and the two-step form ══ -->
            <Grid x:Name="EnquiriesPage" DataContext="{Binding Enquiries}" Background="{StaticResource PageBackgroundBrush}"
                  Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Enquiries}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="24,18,24,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="New enquiry" Command="{Binding NewCommand}" />
                        <StackPanel>
                            <TextBlock Text="Enquiries" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{Binding DueText}" Foreground="#B7791F" FontWeight="SemiBold" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="24,0,24,8">
                        <TextBox DockPanel.Dock="Right" Width="240" Padding="6,4" VerticalContentAlignment="Center"
                                 ToolTip="Search by number, client, city, phone, source, salesperson or quote"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource FilterTab}" Content="{Binding OpenHeader}"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Open}" />
                            <RadioButton Style="{StaticResource FilterTab}" Content="{Binding QuotedHeader}"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Quoted}" />
                            <RadioButton Style="{StaticResource FilterTab}" Content="{Binding WonHeader}"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Won}" />
                            <RadioButton Style="{StaticResource FilterTab}" Content="{Binding LostHeader}"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Lost}" />
                            <RadioButton Style="{StaticResource FilterTab}" Content="{Binding AllHeader}"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=All}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="24,8,24,16" Text="{Binding Message}" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <Border Style="{StaticResource Card}" Margin="24,0,24,0" Padding="0">
                        <ListView ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="4,6" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Number}" />
                                    <EventSetter Event="MouseDoubleClick" Handler="EnquiryRow_DoubleClick" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Enquiry" Width="90" DisplayMemberBinding="{Binding Number}" />
                                    <GridViewColumn Header="Client" Width="180" DisplayMemberBinding="{Binding Client}" />
                                    <GridViewColumn Header="City" Width="100" DisplayMemberBinding="{Binding City}" />
                                    <GridViewColumn Header="Phone" Width="110" DisplayMemberBinding="{Binding Phone}" />
                                    <GridViewColumn Header="Stage" Width="80" DisplayMemberBinding="{Binding Stage}" />
                                    <GridViewColumn Header="Source" Width="95" DisplayMemberBinding="{Binding Source}" />
                                    <GridViewColumn Header="Salesperson" Width="110" DisplayMemberBinding="{Binding Owner}" />
                                    <GridViewColumn Header="Expected value" Width="105">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Value}" TextAlignment="Right" MinWidth="90" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Follow-up" Width="95">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FollowUp}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDue}" Value="True">
                                                                    <Setter Property="Foreground" Value="#B45309" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Quote" Width="100" DisplayMemberBinding="{Binding Quote}" />
                                    <GridViewColumn Header="" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Open" Padding="10,2" Margin="0"
                                                        Command="{Binding DataContext.EditCommand, ElementName=EnquiriesPage}" CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Number, StringFormat=Open {0}}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </DockPanel>

                <!-- The form: step 1 client and site, step 2 the enquiry -->
                <Border Grid.Column="1" Width="460" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                        DataContext="{Binding Editor}" Visibility="{Binding DataContext.HasEditor, ElementName=EnquiriesPage, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="20,16,20,8">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding StepText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="Delete" Margin="0"
                                        Command="{Binding DataContext.DeleteCommand, ElementName=EnquiriesPage}"
                                        Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding DataContext.CancelCommand, ElementName=EnquiriesPage}" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Back" Command="{Binding DataContext.BackCommand, ElementName=EnquiriesPage}"
                                            Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Next" Command="{Binding DataContext.NextCommand, ElementName=EnquiriesPage}"
                                            Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Save enquiry" Command="{Binding DataContext.SaveCommand, ElementName=EnquiriesPage}"
                                            Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Create quote" Command="{Binding DataContext.CreateQuoteCommand, ElementName=EnquiriesPage}"
                                            ToolTip="Save the enquiry and start a quote with its client, site and requirements"
                                            Visibility="{Binding CanCreateQuote, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Bottom" Margin="20,0,20,8" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}"
                                   Text="{Binding DataContext.Message, ElementName=EnquiriesPage}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel Margin="20,0,20,12">
                                <!-- Step 1: client and site -->
                                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Title" Style="{StaticResource FormLabel}" />
                                            <ComboBox IsEditable="True" Padding="6,4" Margin="0,0,0,8" ItemsSource="{x:Static vm:EnquiryEditorViewModel.Titles}"
                                                      Text="{Binding ClientTitle, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="First name" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Last name" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Company" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Phone *" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="E-mail" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="SITE ADDRESS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}" Margin="0,8,0,2" />
                                    <TextBlock Text="Address 1" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Address 2" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="City" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="State" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="PIN code" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Step 2: the enquiry -->
                                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Stage" Style="{StaticResource FormLabel}" />
                                            <ComboBox Padding="6,4" Margin="0,0,0,8" ItemsSource="{x:Static vm:EnquiryEditorViewModel.Stages}" SelectedItem="{Binding Stage}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Source" Style="{StaticResource FormLabel}" />
                                            <ComboBox IsEditable="True" Padding="6,4" Margin="0,0,0,8" ItemsSource="{x:Static vm:EnquiryEditorViewModel.Sources}"
                                                      Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Salesperson" Style="{StaticResource FormLabel}" />
                                            <ComboBox IsEditable="True" Padding="6,4" Margin="0,0,0,8"
                                                      ItemsSource="{Binding DataContext.Owners, ElementName=EnquiriesPage}"
                                                      Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Expected value" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding ExpectedValue, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Follow up on" Style="{StaticResource FormLabel}" />
                                            <DatePicker SelectedDate="{Binding FollowUp}" Margin="0,0,0,8" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Expected decision" Style="{StaticResource FormLabel}" />
                                            <DatePicker SelectedDate="{Binding ExpectedClose}" Margin="0,0,0,8" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Requirements" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" MinHeight="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                             Text="{Binding Requirements, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Rooms, window types, glass, colour, budget, timing, site conditions" />
                                    <StackPanel Visibility="{Binding IsLost, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Why it was lost" Style="{StaticResource FormLabel}" />
                                        <TextBox Style="{StaticResource FormBox}" Text="{Binding LostReason, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Open its quote" Margin="0,6,0,0" HorizontalAlignment="Left"
                                            Command="{Binding DataContext.OpenQuoteCommand, ElementName=EnquiriesPage}"
                                            Visibility="{Binding HasQuote, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ══ Quotation setup: what every quotation PDF prints ══ -->
            <ScrollViewer DataContext="{Binding QuotationSetup}" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Background="{StaticResource PageBackgroundBrush}"
                          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=QuotationSetup}">
                <StackPanel Margin="24,18,24,24" MaxWidth="1150">
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="Discard changes" Command="{Binding RevertCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Save setup" Command="{Binding SaveCommand}" />
                        </StackPanel>
                        <TextBlock Text="Quotation setup" Style="{StaticResource PageTitle}" />
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"
                               Text="What every quotation PDF prints: your details at the top of each page, the covering letter, terms and conditions and bank details. Your company name and logo come from your MARK account. Make a quotation with Quotation PDF… on an open, saved quote." />
                    <Border Padding="10" Margin="0,0,0,12" CornerRadius="6" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F6EE" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#1F2A37" />
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Your details" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                    <TextBlock Text="Company name (used only without a MARK account)" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Line above your name, e.g. Authorised partner" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding PartnerLabel, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Address (one or more lines)" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" MinHeight="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Contact no." Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Website" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="E-mail" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="GSTIN" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Brand (top left of every page)" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                    <TextBlock Text="E.g. the profile system you sell. Leave empty for none." FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="Brand name" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding BrandName, UpdateSourceTrigger=PropertyChanged}" />
                                    <DockPanel Margin="0,4,0,0">
                                        <Border DockPanel.Dock="Left" Width="150" Height="60" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                            <Image Source="{Binding BrandLogoImage}" Stretch="Uniform" Margin="4" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryButton}" Content="Choose logo…" Margin="0,0,0,4" HorizontalAlignment="Left" Command="{Binding ChooseBrandLogoCommand}" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="Remove" Margin="0" HorizontalAlignment="Left" Command="{Binding RemoveBrandLogoCommand}"
                                                    Visibility="{Binding HasBrandLogo, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Bank details" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                    <TextBlock Text="Account name" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding BankAccountName, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Account number" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding BankAccountNumber, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="IFSC" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding BankIfsc, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Bank" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Branch" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding BankBranch, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20,16">
                                <StackPanel>
                                    <TextBlock Text="Units and last page" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                        <TextBlock Text="Areas in" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#4B5563" />
                                        <RadioButton Content="Square feet" IsChecked="{Binding IsSquareFeet}" Margin="0,0,14,0" />
                                        <RadioButton Content="Square metres" IsChecked="{Binding IsSquareMetres}" />
                                    </StackPanel>
                                    <TextBlock Text="Money label after amounts" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Width="120" HorizontalAlignment="Left" Text="{Binding CurrencyLabel, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="A last page with one picture (e.g. care instructions)" Style="{StaticResource FormLabel}" />
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="90" Height="120" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                            <Image Source="{Binding ExtraPageImage}" Stretch="Uniform" Margin="3" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryButton}" Content="Choose picture…" Margin="0,0,0,4" HorizontalAlignment="Left" Command="{Binding ChooseExtraPageCommand}" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="Remove" Margin="0" HorizontalAlignment="Left" Command="{Binding RemoveExtraPageCommand}"
                                                    Visibility="{Binding HasExtraPage, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Use MARK's texts" Padding="10,3"
                                                Command="{Binding DefaultTextsCommand}" ToolTip="Replace the letter, terms and acceptance with MARK's standard texts" />
                                        <TextBlock Text="Covering letter" Style="{StaticResource CardTitle}" />
                                    </DockPanel>
                                    <TextBlock Text="After &quot;Dear Customer,&quot; — one paragraph per line." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" />
                                    <TextBox Style="{StaticResource FormBox}" MinHeight="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                             Text="{Binding Letter, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Terms and conditions" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="One term per line; they are numbered on the quotation." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" />
                                    <TextBox Style="{StaticResource FormBox}" MinHeight="200" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto" Text="{Binding Terms, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20,16">
                                <StackPanel>
                                    <TextBlock Text="Acceptance and notes" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                    <TextBlock Text="Above the signatures" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" MinHeight="48" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                             Text="{Binding Acceptance, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Notes under the quote total" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" MinHeight="48" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ The open quote: Client | Designs | Drawing ═══════════ -->
            <DockPanel Background="{StaticResource PageBackgroundBrush}"
                       Visibility="{Binding Page, Converter={StaticResource EnumToVisibility}, ConverterParameter=Quote}">
                <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="18,6">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Open quote…" VerticalAlignment="Center"
                                Command="{Binding OpenProjectCommand}" ToolTip="Open a saved quote (Ctrl+O)" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding Access.CanEditQuotes, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource SecondaryButton}" Content="New revision" Command="{Binding NewRevisionCommand}"
                                    ToolTip="Keep the saved quote as a revision and continue as the next (R1, R2…)" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Convert to order" Command="{Binding ConvertToOrderCommand}"
                                    ToolTip="Mark the quote won and give it an order number"
                                    Visibility="{Binding IsOrder, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Quotation PDF…" VerticalAlignment="Center" Margin="6,0,6,0"
                                Command="{Binding ExportQuotationCommand}" ToolTip="Make the quotation of this quote as a PDF, with your setup"
                                Visibility="{Binding Access.CanMakeQuotation, Converter={StaticResource BoolToVisibility}}" />
                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,3" Margin="0,0,10,0" Background="#E8F6EE" VerticalAlignment="Center"
                                Visibility="{Binding IsOrder, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding OrderText}" FontWeight="SemiBold" FontSize="11" Foreground="#1D6B3A" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding QuoteHeader}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"><Run Text="{Binding QuoteSubHeader, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding QuoteAuthorsText, Mode=OneWay}" /></TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid>
                    <!-- Client: project, client, site address, requirements -->
                    <ScrollViewer DataContext="{Binding Details}" VerticalScrollBarVisibility="Auto" Focusable="False"
                                  Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Client}">
                        <StackPanel Margin="24,16,24,24" MaxWidth="1100">
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Quote" Style="{StaticResource CardTitle}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Project name *" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource FormBox}" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Quote number" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource FormBox}" Text="{Binding Number, Mode=OneWay}" IsReadOnly="True"
                                                 Background="#F4F5F7" />
                                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Status" Style="{StaticResource FormLabel}" />
                                        <ComboBox Grid.Row="1" Grid.Column="4" Margin="0,2,0,8" Padding="6,4" ItemsSource="{Binding Statuses}"
                                                  SelectedItem="{Binding Status}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Client" Style="{StaticResource CardTitle}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" Style="{StaticResource FormLabel}" />
                                        <ComboBox Grid.Row="1" Grid.Column="0" Margin="0,2,8,8" Padding="6,4" IsEditable="True"
                                                  ItemsSource="{Binding Titles}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="First name" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormBox}" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Last name" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource FormBox}" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="0" Grid.Column="5" Text="Company" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="5" Style="{StaticResource FormBox}" Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Phone" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource FormBox}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Email" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="3" Grid.Column="3" Style="{StaticResource FormBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="3" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Site address" Style="{StaticResource CardTitle}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Address 1" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource FormBox}" Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Address 2" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource FormBox}" Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="3" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="City" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="3" Grid.Column="0" Style="{StaticResource FormBox}" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="State" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource FormBox}" Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Postal code / Country" Style="{StaticResource FormLabel}" />
                                        <Grid Grid.Row="3" Grid.Column="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="2" Style="{StaticResource FormBox}" Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Requirements and notes" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="What the client needs: rooms, window types, glass, colour, budget, deadlines, site conditions."
                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,6" />
                                    <TextBox Style="{StaticResource FormBox}" MinHeight="110" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="Save details" Command="{Binding ApplyCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Discard changes" Command="{Binding RevertCommand}"
                                        IsEnabled="{Binding HasChanges}" />
                                <TextBlock Text="Unsaved changes in this form" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <Border Margin="0,10,0,0" Padding="10" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E8F5EC" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                            </Border>

                            <!-- Who did what: the quote's history -->
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel>
                                    <TextBlock Text="History" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding QuoteAuthorsText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" />
                                    <ItemsControl ItemsSource="{Binding QuoteHistory}" ItemTemplate="{StaticResource HistoryLine}" />
                                </StackPanel>
                            </Border>

                            <!-- Earlier revisions of the quote -->
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding HasQuoteRevisions, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Earlier revisions" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Kept as they were when the next revision was started. Open one as a copy to look at it or start again from it."
                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding QuoteRevisions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F0F2F5" BorderThickness="0,1,0,0" Padding="0,6">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Open a copy" Padding="10,2"
                                                                Command="{Binding OpenCommand}" />
                                                        <TextBlock VerticalAlignment="Center" Foreground="#1F2A37"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding When, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding By, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Value, Mode=OneWay}" /></TextBlock>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Designs: one card per window type -->
                    <DockPanel DataContext="{Binding Designs}"
                               Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Designs}">
                        <DockPanel DockPanel.Dock="Top" Margin="24,16,24,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="New design"
                                    Command="{Binding NewDesignCommand}" ToolTip="Add a frame and open it in the Drawing tab" />
                            <StackPanel>
                                <TextBlock Text="{Binding TotalsText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding ValueText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="24,0,24,8" Text="{Binding Message}" Foreground="{StaticResource ErrorBrush}"
                                   Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock DockPanel.Dock="Top" Margin="24,12,24,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                                   Text="No designs yet. Click New design, or pick a design from the library in the Drawing tab." />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Cards}" Margin="18,0,18,18">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Width="270" Margin="6" Padding="14,12">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Quantity, StringFormat=Qty {0}}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding Reference}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                <Button Style="{StaticResource RowButton}" Command="{Binding EditCommand}" Margin="0,8" ToolTip="Edit this design">
                                                    <Image Source="{Binding Picture}" Width="200" Height="150" />
                                                </Button>
                                                <TextBlock Text="{Binding SizeText}" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding OpeningsText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding GlassText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                <DockPanel Margin="0,8,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalPriceText}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding UnitPriceText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                </DockPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Content="Edit design" Command="{Binding EditCommand}" />
                                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Content="Duplicate" Command="{Binding DuplicateCommand}" />
                                                    <Button Style="{StaticResource SecondaryButton}" Margin="0" Content="Delete" Command="{Binding DeleteCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Pricing: the quote's price structure and the price summary -->
                    <Grid DataContext="{Binding Pricing}"
                          Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Pricing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" MinWidth="330" />
                        </Grid.ColumnDefinitions>

                        <!-- Not in the package: the price structure is locked (the quote keeps the default pricing). -->
                        <Border Grid.ColumnSpan="2" Panel.ZIndex="10" Background="{StaticResource PageBackgroundBrush}"
                                Visibility="{Binding DataContext.Access.CanUsePriceStructure, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}">
                            <ContentControl Style="{StaticResource LockNotice}" MaxWidth="520" Margin="24" VerticalAlignment="Top"
                                            Content="{Binding DataContext.Access.PriceStructureLock, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel Margin="24,16,12,24">
                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryButton}" Content="Product prices..."
                                                    Command="{Binding OpenProductPricesCommand}"
                                                    ToolTip="Your prices of profiles (per metre), glass (per m²) and accessories: Library Manager" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="Use my default" Command="{Binding UseDefaultCommand}"
                                                    ToolTip="Load your saved default pricing into this form" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="Save as my default" Command="{Binding SaveAsDefaultCommand}"
                                                    ToolTip="New quotes will start with this pricing" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Price structure" Style="{StaticResource CardTitle}" />
                                            <TextBox Margin="0,6,0,0" Padding="6,4" Width="260" HorizontalAlignment="Left"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. Retail, Builder projects" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Cost lines (per window)" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Added to every window on top of its material cost, top to bottom. &quot;% of everything above&quot; is a margin on what comes before it." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8" TextWrapping="Wrap" />
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="86" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Name" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="Basis" Foreground="{StaticResource MutedTextBrush}" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="2" Text="Rate" Foreground="{StaticResource MutedTextBrush}" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="4" Text="On quote" Foreground="{StaticResource MutedTextBrush}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Heads}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="190" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="86" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Padding="4,3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                        <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{x:Static vm:PricingViewModel.HeadBases}"
                                                                  SelectedValuePath="Basis" DisplayMemberPath="Name" SelectedValue="{Binding Basis}" />
                                                        <TextBox Grid.Column="2" Margin="6,0,0,0" Padding="4,3" TextAlignment="Right"
                                                                 Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"
                                                                   Foreground="{StaticResource MutedTextBrush}" Text="{Binding UnitText}" />
                                                        <CheckBox Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                  IsChecked="{Binding ShowOnQuote}" ToolTip="Show as its own line on the quotation" />
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="2,0,0,0" Content="&#x2191;"
                                                                    Command="{Binding MoveUpCommand}" ToolTip="Move up" />
                                                            <Button Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="2,0,0,0" Content="&#x2193;"
                                                                    Command="{Binding MoveDownCommand}" ToolTip="Move down" />
                                                            <Button Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="2,0,0,0" Content="&#x2715;"
                                                                    Command="{Binding RemoveCommand}" ToolTip="Remove" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                Content="Add cost line" Command="{Binding AddHeadCommand}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Rates" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Hardware per sash, by opening type; insect mesh per m²; steel reinforcement per metre of profile (uPVC)."
                                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8" TextWrapping="Wrap" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Casement" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Margin="6,2" Padding="4,3" TextAlignment="Right"
                                                     Text="{Binding CasementText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="per sash" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Top / bottom hung" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="4" Margin="6,2" Padding="4,3" TextAlignment="Right"
                                                     Text="{Binding HungText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="0" Grid.Column="5" Text="per sash" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tilt &amp; turn" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Margin="6,2" Padding="4,3" TextAlignment="Right"
                                                     Text="{Binding TiltTurnText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="per sash" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Pivot" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1" Grid.Column="4" Margin="6,2" Padding="4,3" TextAlignment="Right"
                                                     Text="{Binding PivotText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="1" Grid.Column="5" Text="per sash" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Sliding" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Margin="6,2" Padding="4,3" TextAlignment="Right"
                                                     Text="{Binding SlidingText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="per panel" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Row="2" Grid.Column="3" Text="Insect mesh" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="2" Grid.Column="4" Margin="6,2" Padding="4,3" TextAlignment="Right"
                                                     Text="{Binding MeshText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="2" Grid.Column="5" Text="per m²" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Reinforcement" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Margin="6,2" Padding="4,3" TextAlignment="Right"
                                                     Text="{Binding ReinforcementText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="per m" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Discount and tax" Style="{StaticResource CardTitle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Discount" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                            <TextBox Width="70" Margin="8,0" Padding="4,3" TextAlignment="Right"
                                                     Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,28,0" />
                                            <TextBlock Text="Tax" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                            <TextBox Width="80" Margin="8,0" Padding="4,3" Text="{Binding TaxName, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Width="70" Margin="0,0,8,0" Padding="4,3" TextAlignment="Right"
                                                     Text="{Binding TaxText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="%" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Charges (after the discount)" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Added once to the quote after the discount, e.g. transportation, loading and unloading." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8" TextWrapping="Wrap" />
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="86" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Name" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="Basis" Foreground="{StaticResource MutedTextBrush}" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="2" Text="Rate" Foreground="{StaticResource MutedTextBrush}" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="4" Text="On quote" Foreground="{StaticResource MutedTextBrush}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Charges}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="190" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="86" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Padding="4,3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                        <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{x:Static vm:PricingViewModel.ChargeBases}"
                                                                  SelectedValuePath="Basis" DisplayMemberPath="Name" SelectedValue="{Binding Basis}" />
                                                        <TextBox Grid.Column="2" Margin="6,0,0,0" Padding="4,3" TextAlignment="Right"
                                                                 Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"
                                                                   Foreground="{StaticResource MutedTextBrush}" Text="{Binding UnitText}" />
                                                        <CheckBox Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                  IsChecked="{Binding ShowOnQuote}" ToolTip="Show as its own line on the quotation" />
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="2,0,0,0" Content="&#x2191;"
                                                                    Command="{Binding MoveUpCommand}" ToolTip="Move up" />
                                                            <Button Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="2,0,0,0" Content="&#x2193;"
                                                                    Command="{Binding MoveDownCommand}" ToolTip="Move down" />
                                                            <Button Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="2,0,0,0" Content="&#x2715;"
                                                                    Command="{Binding RemoveCommand}" ToolTip="Remove" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                Content="Add charge" Command="{Binding AddChargeCommand}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Content="Apply to this quote" Command="{Binding ApplyCommand}" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Discard changes" Command="{Binding RevertCommand}"
                                            IsEnabled="{Binding HasChanges}" />
                                    <TextBlock Text="Unsaved changes in this form" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <Border Margin="0,10,0,0" Padding="10" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E8F5EC" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel Margin="12,16,24,24">
                                <Border Style="{StaticResource Card}" Padding="18,14" Background="#F3FAF5" BorderBrush="#BFE3CB">
                                    <StackPanel>
                                        <TextBlock Text="Price summary" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding PreviewNote}" FontSize="11" Foreground="#9A5B00" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <ItemsControl ItemsSource="{Binding Summary}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,4">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" Foreground="{StaticResource TextBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Per design" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Per window: material (library prices), hardware/mesh/reinforcement (rates) and cost lines; price after discount."
                                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Ref." FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="Qty" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="2" Text="Material" FontSize="11" TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="3" Text="Hardware…" FontSize="11" TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="4" Text="Cost lines" FontSize="11" TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="5" Text="Price each" FontSize="11" TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="6" Text="Total" FontSize="11" TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding DesignPrices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44" />
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Material}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Rated}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="4" Text="{Binding Heads}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="5" Text="{Binding UnitPrice}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="6" Text="{Binding Total}" TextAlignment="Right" FontWeight="SemiBold" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Bill of materials (Pricing area) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                                  Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Materials}">
                        <StackPanel Margin="14,16,24,24" MaxWidth="780" HorizontalAlignment="Left">
                            <TextBlock Text="Bill of materials" Style="{StaticResource PageTitle}" Margin="10,0,0,2" />
                            <TextBlock Text="Everything the quote's designs need: profiles, steel, glass, hardware and accessories, with their cost."
                                       Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,0" TextWrapping="Wrap" />
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource BillOfMaterialsPanel}" Focusable="False" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Cutting plan (Production area) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                                  Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Cutting}">
                        <StackPanel Margin="14,16,24,24" MaxWidth="780" HorizontalAlignment="Left">
                            <TextBlock Text="Cutting plan" Style="{StaticResource PageTitle}" Margin="10,0,0,2" />
                            <TextBlock Text="How to cut the quote's profiles and steel from stock bars: cuts per bar, offcuts kept and waste. To see another quote, use Open quote…"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,0" TextWrapping="Wrap" />
                            <Border Style="{StaticResource Card}" Margin="10,12,0,0" Padding="0,4">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CuttingPlanPanel}" Focusable="False" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Drawing: the designer (toolbar, library, canvas, properties) -->
                    <DockPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Drawing}">
                        <!-- ── Toolbar ──────────────────────────────────────────── -->
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1"
                                Background="{StaticResource PanelBackgroundBrush}" Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ToolbarButton}" Content="New" Command="{Binding NewProjectCommand}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Open" ToolTip="Open a saved project (Ctrl+O)"
                                        Command="{Binding OpenProjectCommand}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Save" ToolTip="Save the project (Ctrl+S)"
                                        Command="{Binding SaveProjectCommand}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Library" ToolTip="Library manager: products, prices, stock lengths"
                                        Command="{Binding OpenLibraryManagerCommand}" />
                                <Rectangle Width="1" Margin="6,2" Fill="{StaticResource BorderBrush}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Undo" Command="{Binding UndoCommand}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Redo" Command="{Binding RedoCommand}" />
                                <Rectangle Width="1" Margin="6,2" Fill="{StaticResource BorderBrush}" />
                                <!-- Interaction modes: exactly one is active. -->
                                <RadioButton Style="{StaticResource ToolRadio}" Content="Select" ToolTip="Select, move, resize (Esc)"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Select}" />
                                <RadioButton Style="{StaticResource ToolRadio}" Content="Pan" ToolTip="Drag to pan"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Pan}" />
                                <RadioButton Style="{StaticResource ToolRadio}" Content="Frame" ToolTip="Drag a rectangle to draw a frame"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=CreateFrame}" />
                                <RadioButton Style="{StaticResource ToolRadio}" Content="Mullion" ToolTip="Click a glass panel to add a mullion (Shift = whole frame)"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=AddMullion}" />
                                <RadioButton Style="{StaticResource ToolRadio}" Content="Transom" ToolTip="Click a glass panel to add a transom (Shift = whole frame)"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=AddTransom}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Delete" ToolTip="Delete the selection (Del)"
                                        Command="{Binding DeleteSelectedCommand}" />
                                <Rectangle Width="1" Margin="6,2" Fill="{StaticResource BorderBrush}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Zoom In" Command="{Binding Canvas.ZoomInCommand}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Zoom Out" Command="{Binding Canvas.ZoomOutCommand}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Fit" ToolTip="Fit to screen (F)" Command="{Binding Canvas.FitCommand}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Reset" ToolTip="Reset view" Command="{Binding Canvas.ResetViewCommand}" />
                                <ToggleButton Style="{StaticResource ToolbarToggle}" Content="Grid" ToolTip="Show grid (G)"
                                              IsChecked="{Binding Canvas.ShowGrid}" />
                            </StackPanel>
                        </Border>

                        <!-- ── Main area: design | canvas | properties ──────────── -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="306" MinWidth="250" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" MinWidth="220" />
                            </Grid.ColumnDefinitions>

                            <!-- Design library: category rail + the chosen category's designs (or the frame tools) -->
                            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <ListBox DockPanel.Dock="Left" Width="64" Style="{StaticResource RailList}"
                                             ItemContainerStyle="{StaticResource RailItem}"
                                             ItemsSource="{Binding DesignLibrary.Categories}" SelectedValuePath="Name"
                                             SelectedValue="{Binding DesignLibrary.SelectedCategory}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel ToolTip="{Binding ToolTip}" Width="50" AutomationProperties.Name="{Binding Name}">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                               MaxWidth="54" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Text="{Binding DesignLibrary.Title}" />

                                        <!-- Frame tools (new frame, divisions, snapping) -->
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                                                      Visibility="{Binding DesignLibrary.IsFramePanel, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource PanelHeader}" Text="NEW FRAME" Margin="12,0,12,8" />
                                            <Grid Margin="12,0,12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Width" Style="{StaticResource FieldLabel}" />
                                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource NumberBox}"
                                                         Text="{Binding NewFrameWidthText, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                                                <TextBlock Grid.Row="1" Text="Height" Style="{StaticResource FieldLabel}" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}"
                                                         Text="{Binding NewFrameHeightText, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                                            </Grid>
                                            <Button Style="{StaticResource PanelButton}" Content="Create Frame" Command="{Binding CreateFrameCommand}" />

                                            <TextBlock Style="{StaticResource PanelHeader}" Text="DIVISIONS" Margin="12,20,12,8" />
                                            <Button Style="{StaticResource PanelButton}" Content="Add Mullion  │" Command="{Binding AddMullionCommand}" />
                                            <Button Style="{StaticResource PanelButton}" Content="Add Transom  ─" Command="{Binding AddTransomCommand}" />
                                            <TextBlock Margin="12,6,12,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                                       Text="With a glass panel selected, the division splits only that opening. Otherwise it spans the whole frame." />

                                            <Border Margin="12,12,12,0" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                                                    Visibility="{Binding HasDesignMessage, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding DesignMessage}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                                            </Border>

                                            <TextBlock Style="{StaticResource PanelHeader}" Text="SNAP" Margin="12,20,12,8" />
                                            <CheckBox Margin="12,2" Content="Object snap" IsChecked="{Binding ObjectSnapEnabled}" Focusable="False"
                                                      ToolTip="Intersection › endpoint › midpoint › centre › edge" />
                                            <CheckBox Margin="12,2" Content="Grid snap" IsChecked="{Binding Canvas.SnapToGrid}" Focusable="False" />
                                            <Grid Margin="12,4,12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Grid step" Style="{StaticResource FieldLabel}" />
                                                <TextBox Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding Canvas.GridSpacingMm}" />
                                                <TextBlock Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                                                <TextBlock Grid.Row="1" Text="Tolerance" Style="{StaticResource FieldLabel}" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding SnapTolerancePixels}" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="px" Style="{StaticResource UnitLabel}" />
                                            </Grid>

                                            <TextBlock Margin="12,20,12,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                                       Text="Click selects, Shift+click adds, Ctrl+click toggles, drag on empty space box-selects (→ inside, ← touching). Drag frames, mullions, transoms or the frame's handles. Esc cancels, Del deletes, Ctrl+A selects all, Ctrl+Z / Ctrl+Y undo / redo." />
                                        </StackPanel>
                                        </ScrollViewer>

                                        <!-- Designs of the chosen category -->
                                        <DockPanel Visibility="{Binding DesignLibrary.IsFramePanel, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock DockPanel.Dock="Top" Margin="12,0,12,4" TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="Click a design to apply it to the selected opening or frame, or drag it onto an opening. With no frame yet, it creates one." />
                                            <Border DockPanel.Dock="Top" Margin="12,4,12,4" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                                                    Visibility="{Binding DesignLibrary.HasMessage, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding DesignLibrary.Message}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                                            </Border>
                                            <ContentControl DockPanel.Dock="Top" Style="{StaticResource LockNotice}" Margin="12,4,12,4"
                                                            Content="{Binding Access.DesignLibraryLock}"
                                                            Visibility="{Binding Access.CanUseDesignLibrary, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" IsEnabled="{Binding Access.CanUseDesignLibrary}">
                                                <ItemsControl ItemsSource="{Binding DesignLibrary.Sections}" Margin="0,0,0,12">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,4,0,4">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="12,6,12,4"
                                                                           Foreground="{StaticResource TextBrush}" />
                                                                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="12,0,12,4" />
                                                                <ItemsControl ItemsSource="{Binding Items}" Margin="8,0">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Style="{StaticResource DesignTile}" Command="{Binding ApplyCommand}"
                                                                                    ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                                                                    views:DesignDragSource.TemplateId="{Binding DragId}">
                                                                                <Image Source="{Binding Thumbnail}" Width="56" Height="56" />
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </DockPanel>
                                </DockPanel>
                            </Border>

                            <!-- 2D drawing view -->
                            <Grid Grid.Column="1">
                                <controls:ViewportControl x:Name="Viewport" Viewport="{Binding Canvas}" Tool="{Binding ActiveTool}"
                                                          DropTarget="{Binding}" />
                                <!-- Inside / Outside view -->
                                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" Padding="3"
                                        CornerRadius="16" Background="#EEFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentRadio}" Content="Inside" IsChecked="{Binding IsInsideView}"
                                                     ToolTip="Seen from inside (editable)" />
                                        <RadioButton Style="{StaticResource SegmentRadio}" Content="Outside" IsChecked="{Binding IsOutsideView}"
                                                     ToolTip="Seen from outside: mirrored, hinges swapped (read-only)" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Properties -->
                            <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel>
                                <StackPanel DataContext="{Binding Properties}">
                                    <TextBlock Style="{StaticResource PanelHeader}" Text="PROPERTIES" />
                                    <TextBlock Margin="12,0,12,8" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" Text="{Binding Header}" />

                                    <!-- Design details (frame) and opening type (glass) -->
                                    <ContentControl Content="{Binding DesignEditor}" Focusable="False" />
                                    <ContentControl Content="{Binding OpeningEditor}" Focusable="False" />

                                    <!-- Frame size -->
                                    <StackPanel Visibility="{Binding IsFrameEditable, Converter={StaticResource BoolToVisibility}}">
                                        <Grid Margin="12,0,12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Width" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Column="1" Style="{StaticResource NumberBox}"
                                                     Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding ApplyFrameSizeCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <TextBlock Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                                            <TextBlock Grid.Row="1" Text="Height" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}"
                                                     Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding ApplyFrameSizeCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                                        </Grid>
                                        <Button Style="{StaticResource PanelButton}" Content="Apply" Command="{Binding ApplyFrameSizeCommand}" />
                                    </StackPanel>

                                    <!-- Division position -->
                                    <StackPanel Visibility="{Binding IsDivisionEditable, Converter={StaticResource BoolToVisibility}}">
                                        <Grid Margin="12,0,12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PositionLabel}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Column="1" Style="{StaticResource NumberBox}"
                                                     Text="{Binding PositionText, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding ApplyPositionCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <TextBlock Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                                        </Grid>
                                        <Button Style="{StaticResource PanelButton}" Content="Apply" Command="{Binding ApplyPositionCommand}" />
                                    </StackPanel>

                                    <Border Margin="12,8,12,4" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Items}" Margin="12,8,12,0" ItemTemplate="{StaticResource PropertyRow}" />

                                    <!-- Library assignments: the frame's system, then glass / profile after design -->
                                    <ContentControl Content="{Binding SystemPicker}" Focusable="False" />
                                    <ContentControl Content="{Binding ProfilePicker}" Focusable="False" />
                                    <ContentControl Content="{Binding GlassPicker}" Focusable="False" />

                                    <!-- Calculated values for the selection -->
                                    <StackPanel Visibility="{Binding HasCalculation, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource PanelHeader}" Text="CALCULATION" Margin="12,16,12,4" />
                                        <ItemsControl ItemsSource="{Binding CalculationItems}" Margin="12,0,12,0" ItemTemplate="{StaticResource PropertyRow}" />
                                    </StackPanel>
                                    <Border Margin="12,8,12,4" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                                            Visibility="{Binding HasCalculationMessage, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding CalculationMessage}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                                    </Border>
                                </StackPanel>

                                    <!-- Bill of materials and cutting plan for the whole project (also pages of Pricing and Production) -->
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource BillOfMaterialsPanel}" Focusable="False" />
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CuttingPlanPanel}" Focusable="False" />
                                </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </DockPanel>

                </Grid>
            </DockPanel>

        </Grid>
    </DockPanel>
</Window>
