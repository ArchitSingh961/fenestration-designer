<Window x:Class="Mark.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Resources/mark.ico" Title="MARK Setup" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="White" FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1E63C7" Padding="26,20">
            <StackPanel>
                <TextBlock Text="MARK" Foreground="White" FontSize="30" FontWeight="Bold" />
                <TextBlock x:Name="Subtitle" Foreground="#DCE8FA" FontSize="14" Text="Windows and doors: design, quotes, production and accounts" />
            </StackPanel>
        </Border>
        <StackPanel Margin="26,20,26,22">
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Text="Install MARK" />
            <TextBlock x:Name="Intro" TextWrapping="Wrap" Margin="0,6,0,14" Foreground="{StaticResource MutedBrush}" />

            <StackPanel x:Name="InstallOptionsPanel">
                <TextBlock Text="Install in" FontWeight="SemiBold" />
                <DockPanel Margin="0,4,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Secondary}" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" />
                    <TextBox x:Name="FolderBox" Padding="6,5" AutomationProperties.Name="Install folder" />
                </DockPanel>
                <CheckBox x:Name="DesktopBox" Content="Add a shortcut on the desktop" IsChecked="True" Margin="0,0,0,6" />
                <CheckBox x:Name="StartBox" Content="Start MARK when it is installed" IsChecked="True" />
            </StackPanel>

            <StackPanel x:Name="UninstallOptionsPanel" Visibility="Collapsed">
                <CheckBox x:Name="RemoveDataBox" Margin="0,0,0,6"
                          Content="Also remove MARK's data from this computer (quotes, settings, licence, backups)" />
                <TextBlock x:Name="DataNote" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <ProgressBar x:Name="Progress" Height="6" Margin="0,16,0,6" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CloseButton" Style="{StaticResource Secondary}" Content="Cancel" Margin="0,0,8,0" Click="Close_Click" />
                <Button x:Name="ActionButton" Style="{StaticResource Primary}" Content="Install" Click="Action_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
