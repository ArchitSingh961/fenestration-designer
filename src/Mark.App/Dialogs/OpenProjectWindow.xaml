<Window x:Class="Mark.App.Dialogs.OpenProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Project" Width="520" Height="440" MinWidth="380" MinHeight="300" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PanelBackgroundBrush}"
        FocusManager.FocusedElement="{Binding ElementName=Search}">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Search" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
            <TextBox x:Name="Search" Grid.Column="1" Padding="4,3" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Delete" Width="80" Command="{Binding DeleteCommand}" />
            <Button Content="Open" Width="80" Margin="24,0,0,0" IsDefault="True" Click="Open_Click" />
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{StaticResource MutedTextBrush}" />

        <ListView ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" MouseDoubleClick="List_DoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Project" Width="300" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Modified" Width="150" DisplayMemberBinding="{Binding Modified}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
