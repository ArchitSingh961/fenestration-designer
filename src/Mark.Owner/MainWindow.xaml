<Window x:Class="Mark.Owner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Mark.Designer.Views;assembly=Mark.Designer"
        Icon="pack://application:,,,/Resources/mark.ico" Title="MARK Owner" Width="1360" Height="860" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackgroundBrush}">
    <Window.Resources>
        <views:EnumToBooleanConverter x:Key="EnumToBool" />
        <views:EnumToVisibilityConverter x:Key="EnumToVisibility" />
        <views:CountToVisibilityConverter x:Key="CountToCollapsed" Invert="True" />

        <!-- Message line of a page (green done, red error). -->
        <Style x:Key="PageMessage" TargetType="Border">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#E8F6EE" />
            <Setter Property="Visibility" Value="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PageMessageText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#1D6B3A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- What a company gets from the catalogue: systems, then single items by kind. -->
        <DataTemplate x:Key="CatalogueChoiceTemplate">
            <StackPanel>
                <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" Foreground="#1F2A37" Margin="0,0,0,6" TextWrapping="Wrap" />
                <TextBlock Text="Systems (with their profiles, glass, hardware and bundles). Only systems of the company's licensed products are sent."
                           FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                <views:ItemsList ItemsSource="{Binding Systems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked}" Margin="0,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </views:ItemsList>
                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Universal items" FontWeight="SemiBold" Foreground="#1F2A37" />
                    <TextBlock Text="Single items of the universal catalogue, by series. Items that come with a ticked system are ticked already; tick a group to give all of it."
                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <views:ItemsList ItemsSource="{Binding ItemGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E3E6EA" BorderThickness="0,0,0,1" Padding="0,3">
                                    <Expander>
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding AllChecked}" IsThreeState="False" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding Title, StringFormat=Tick all of {0}}"
                                                          ToolTip="Tick or untick every item of this group" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#374151" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <views:ItemsList ItemsSource="{Binding Rows}" Margin="24,2,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,1">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" FontSize="10" Margin="8,0,0,0"
                                                                   Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                                        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanChange}">
                                                            <TextBlock>
                                                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Detail, Mode=OneWay}" FontSize="10" Foreground="#8A8A8A" />
                                                            </TextBlock>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </views:ItemsList>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </views:ItemsList>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Feature tick boxes grouped by area (packages). -->
        <DataTemplate x:Key="FeatureChoiceGroupTemplate">
            <StackPanel Margin="0,0,18,10">
                <TextBlock Text="{Binding Area}" Style="{StaticResource SectionTitle}" Margin="0,4,0,4" />
                <views:ItemsList ItemsSource="{Binding Features}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanChange}" Margin="0,3" ToolTip="{Binding Description}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Tag}" Margin="8,0,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </views:ItemsList>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ── Header ─────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="#1B2B44" Padding="16,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AdminName}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ServerText}" Foreground="#9FB2CF" FontSize="10" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Style="{StaticResource SecondaryButton}" Content="Sign out" Command="{Binding SignOutCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="MARK" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    <Border Background="#E8A33D" CornerRadius="4" Padding="6,0" Margin="8,0,22,0" VerticalAlignment="Center">
                        <TextBlock Text="OWNER" FontWeight="Bold" FontSize="10" Foreground="#1B2B44" />
                    </Border>
                    <RadioButton Style="{StaticResource OwnerTab}" Content="Companies"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Companies}" />
                    <RadioButton Style="{StaticResource OwnerTab}" Content="Licence keys"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Keys}" />
                    <RadioButton Style="{StaticResource OwnerTab}" Content="Packages"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Packages}" />
                    <RadioButton Style="{StaticResource OwnerTab}" Content="Company types"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=CompanyTypes}" />
                    <RadioButton Style="{StaticResource OwnerTab}" Content="Catalogue"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Catalogue}" />
                    <RadioButton Style="{StaticResource OwnerTab}" Content="Updates"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Updates}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <!-- ══ Companies ═══════════════════════════════════════════ -->
            <Grid x:Name="CompaniesPage" DataContext="{Binding Companies}"
                  Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Companies}">

                <!-- The list of companies (hidden while an account is open) -->
                <DockPanel Margin="24,18,24,20" Visibility="{Binding HasEditor, Converter={StaticResource InverseBoolToVisibility}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="+ New account" Padding="16,7" Command="{Binding NewAccountCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Companies" Style="{StaticResource PageTitle}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource SubtleTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PageMessage}">
                        <TextBlock Text="{Binding Message}" Style="{StaticResource PageMessageText}" />
                    </Border>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12" MaxWidth="520" HorizontalAlignment="Left" Width="520">
                        <TextBox x:Name="SearchBox" Style="{StaticResource FormBox}" Margin="0" Padding="30,7,8,7"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by company, User ID or type" />
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Foreground="{StaticResource SubtleTextBrush}" />
                        <TextBlock Text="Search companies, User IDs or types" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{StaticResource MutedTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Style="{StaticResource Card}" CornerRadius="8">
                        <DockPanel>
                            <!-- Column headings -->
                            <Border DockPanel.Dock="Top" Background="#F7F8FA" BorderBrush="#E8EBEF" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="18,10">
                                <Grid TextElement.FontSize="11" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource SubtleTextBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.4*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="1.1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="COMPANY" />
                                    <TextBlock Grid.Column="1" Text="PRODUCTS" />
                                    <TextBlock Grid.Column="2" Text="PACKAGE" />
                                    <TextBlock Grid.Column="3" Text="VALID UNTIL" />
                                    <TextBlock Grid.Column="4" Text="COMPUTERS" />
                                    <TextBlock Grid.Column="5" Text="STATUS" />
                                </Grid>
                            </Border>
                            <TextBlock DockPanel.Dock="Top" Margin="18,28" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}"
                                       Text="No companies yet. Choose + New account to create the first one: you set its name, type, products, package, validity, and the User ID and password it signs in to MARK with."
                                       Visibility="{Binding Companies.Count, Converter={StaticResource CountToCollapsed}}" />
                            <ListBox ItemsSource="{Binding Companies}" SelectedItem="{Binding Selected}" Style="{StaticResource SideList}"
                                     ToolTip="Click a company to open its account">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.4*" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="1.1*" />
                                            </Grid.ColumnDefinitions>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="#E8EEF7" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1F2A37" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="11" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                                                        <Run Text="{Binding UserIdText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding TypeText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding ProductsText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding PackageText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding ValidUntilText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding ComputersText}" VerticalAlignment="Center"
                                                       ToolTip="{Binding LastCheckInText, StringFormat=Last check-in: {0}}" />
                                            <DockPanel Grid.Column="5">
                                                <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                                <Border Style="{StaticResource StatePill}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </DockPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DockPanel>

                <!-- The account page: a new account or an opened one, in place of the list -->
                <DockPanel Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel x:Name="AccountPage" DataContext="{Binding Editor}" DataContextChanged="AccountPage_DataContextChanged">
                        <!-- Top bar: back, where you are, cancel and save -->
                        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E1E5EB" BorderThickness="0,0,0,1" Padding="14,10,20,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Padding="14,6"
                                            ToolTip="Back to the list without saving"
                                            Command="{Binding DataContext.CancelCommand, ElementName=CompaniesPage}" />
                                    <Button Style="{StaticResource PrimaryButton}" Padding="18,7" Margin="8,0,0,0"
                                            Command="{Binding DataContext.SaveCommand, ElementName=CompaniesPage}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,8,0" />
                                            <TextBlock Text="Save account" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BackButton}" Content="All companies"
                                            Command="{Binding DataContext.CancelCommand, ElementName=CompaniesPage}" />
                                    <TextBlock Text="/" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding HeaderName}" FontWeight="SemiBold" Foreground="#1F2A37" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="480" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Side panel: who it is, the sections, the account actions -->
                        <Border DockPanel.Dock="Left" Width="248" Background="White" BorderBrush="#E1E5EB" BorderThickness="0,0,1,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,14">
                                    <Border Width="52" Height="52" CornerRadius="26" Background="#E8EEF7" HorizontalAlignment="Left">
                                        <Grid>
                                            <TextBlock Text="{Binding Initials}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding HasLogo, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <Border CornerRadius="26" Background="White" BorderBrush="#E1E5EB" BorderThickness="1"
                                                    Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}">
                                                <Image Source="{Binding Logo}" Margin="8" Stretch="Uniform" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding HeaderName}" FontSize="16" FontWeight="SemiBold" Foreground="#1F2A37" Margin="0,12,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource FieldHelp}" Margin="0,3,0,0" />
                                    <Border CornerRadius="9" Padding="8,2" Background="#FBECEC" HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Visibility="{Binding IsSuspended, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Suspended" FontSize="11" FontWeight="SemiBold" Foreground="#A32020" />
                                    </Border>
                                </StackPanel>

                                <!-- Account actions (an existing account only) -->
                                <Border DockPanel.Dock="Bottom" BorderBrush="#EEF0F3" BorderThickness="0,1,0,0" Padding="20,14,20,18"
                                        Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="ACCOUNT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,8" />
                                        <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" Padding="12,6" HorizontalContentAlignment="Left"
                                                Content="{Binding DataContext.SuspendText, ElementName=CompaniesPage}"
                                                ToolTip="Suspended: MARK becomes read-only on their computers at the next check-in"
                                                Command="{Binding DataContext.ToggleSuspendCommand, ElementName=CompaniesPage}" />
                                        <Button Style="{StaticResource DangerButton}" Margin="0" Padding="12,6" Content="Delete account…"
                                                Command="{Binding DataContext.DeleteCommand, ElementName=CompaniesPage}" />
                                    </StackPanel>
                                </Border>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <StackPanel x:Name="SectionNav" Margin="10,4,12,12">
                                        <TextBlock Text="SECTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" Margin="12,0,0,6" />
                                        <RadioButton x:Name="NavCompany" Style="{StaticResource SideNavItem}" GroupName="AccountSections" Tag="&#xE80F;"
                                                     Content="Company" IsChecked="True" Click="SectionNav_Click" />
                                        <RadioButton x:Name="NavSignIn" Style="{StaticResource SideNavItem}" GroupName="AccountSections" Tag="&#xE77B;"
                                                     Content="Sign-in for MARK" Click="SectionNav_Click" />
                                        <RadioButton x:Name="NavProducts" Style="{StaticResource SideNavItem}" GroupName="AccountSections" Tag="&#xE7B8;"
                                                     Content="Products" Click="SectionNav_Click" />
                                        <RadioButton x:Name="NavPackage" Style="{StaticResource SideNavItem}" GroupName="AccountSections" Tag="&#xE787;"
                                                     Content="Package and validity" Click="SectionNav_Click" />
                                        <RadioButton x:Name="NavFeatures" Style="{StaticResource SideNavItem}" GroupName="AccountSections" Tag="&#xE71D;"
                                                     Content="Features" Click="SectionNav_Click" />
                                        <RadioButton x:Name="NavCatalogue" Style="{StaticResource SideNavItem}" GroupName="AccountSections" Tag="&#xE8F1;"
                                                     Content="Catalogue" Click="SectionNav_Click" />
                                        <RadioButton x:Name="NavQuotation" Style="{StaticResource SideNavItem}" GroupName="AccountSections" Tag="&#xE8A5;"
                                                     Content="Quotation details" Click="SectionNav_Click" />
                                        <RadioButton x:Name="NavComputers" Style="{StaticResource SideNavItem}" GroupName="AccountSections" Tag="&#xE7F4;"
                                                     Content="Computers and staff" Click="SectionNav_Click"
                                                     Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <RadioButton x:Name="NavNotes" Style="{StaticResource SideNavItem}" GroupName="AccountSections" Tag="&#xE70B;"
                                                     Content="Notes" Click="SectionNav_Click" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- The message of the last action, always in sight -->
                        <Border DockPanel.Dock="Top" DataContext="{Binding DataContext, ElementName=CompaniesPage}" Style="{StaticResource PageMessage}"
                                Margin="28,14,28,0" MaxWidth="1040">
                            <TextBlock Text="{Binding Message}" Style="{StaticResource PageMessageText}" />
                        </Border>

                        <!-- The sections -->
                        <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" Focusable="False" ScrollChanged="EditorScroll_ScrollChanged">
                            <StackPanel x:Name="EditorContent" Margin="28,18,28,28" MaxWidth="1040">

                                <!-- Company -->
                                <HeaderedContentControl x:Name="SecCompany" Style="{StaticResource FormSection}" Tag="&#xE80F;" Header="Company"
                                                        AutomationProperties.HelpText="The name and logo MARK shows on the company's screens and quotations.">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Logo" Style="{StaticResource FormLabel}" />
                                            <Border Style="{StaticResource PictureBox}" Height="96">
                                                <Grid>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Visibility="{Binding HasLogo, Converter={StaticResource InverseBoolToVisibility}}">
                                                        <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                        <TextBlock Text="No logo" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <Image Source="{Binding Logo}" Margin="8" Stretch="Uniform" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Style="{StaticResource SmallButton}" Margin="0" Content="Choose…"
                                                        Command="{Binding DataContext.ChooseLogoCommand, ElementName=CompaniesPage}" />
                                                <Button Style="{StaticResource SmallButton}" Margin="6,0,0,0" Content="Remove"
                                                        Command="{Binding DataContext.RemoveLogoCommand, ElementName=CompaniesPage}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Company name *" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Padding="8,6" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Company type" Style="{StaticResource FormLabel}" />
                                            <ComboBox ItemsSource="{Binding CompanyTypes}" SelectedItem="{Binding CompanyType}" DisplayMemberPath="Name"
                                                      Padding="8,6" Margin="0,0,0,6" />
                                            <TextBlock Text="For a new account, the type fills in the products, package and validity." Style="{StaticResource FieldHelp}"
                                                       Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </HeaderedContentControl>

                                <!-- Sign-in -->
                                <HeaderedContentControl x:Name="SecSignIn" Style="{StaticResource FormSection}" Tag="&#xE77B;" Header="Sign-in for MARK"
                                                        AutomationProperties.HelpText="The account owner signs in to MARK with this User ID and password, and can add staff logins there.">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Account owner's name" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Padding="8,6" Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="User ID *" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Padding="8,6" Text="{Binding OwnerUserId, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="{Binding PasswordLabel}" Style="{StaticResource FormLabel}" TextTrimming="CharacterEllipsis" />
                                            <TextBox Style="{StaticResource FormBox}" Padding="8,6" FontFamily="Consolas" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </HeaderedContentControl>

                                <!-- Products -->
                                <HeaderedContentControl x:Name="SecProducts" Style="{StaticResource FormSection}" Tag="&#xE7B8;" Header="Products"
                                                        AutomationProperties.HelpText="Each product is sold separately, with its own end date. Tick the ones the company buys.">
                                    <views:ItemsList ItemsSource="{Binding Products}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E1E5EB" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,12,12">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="White" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsIncluded}" Value="True">
                                                                    <Setter Property="Background" Value="#F7FAFF" />
                                                                    <Setter Property="BorderBrush" Value="#BFD5F5" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <CheckBox DockPanel.Dock="Right" Content="Suspended" IsChecked="{Binding IsSuspended}" VerticalAlignment="Center"
                                                                      IsEnabled="{Binding IsIncluded}" />
                                                            <CheckBox IsChecked="{Binding IsIncluded}" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                            </CheckBox>
                                                        </DockPanel>
                                                        <StackPanel Margin="22,10,0,0" IsEnabled="{Binding IsIncluded}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Valid until" Style="{StaticResource FieldLabel}" Width="66" VerticalAlignment="Center" />
                                                                <DatePicker SelectedDate="{Binding ValidUntil}" Width="140" />
                                                            </StackPanel>
                                                            <DockPanel Margin="0,8,0,0">
                                                                <TextBlock Text="Extend" Style="{StaticResource FieldLabel}" Width="66" VerticalAlignment="Center" />
                                                                <views:ItemsList ItemsSource="{Binding DataContext.ValidityChoices, ElementName=AccountPage}" Focusable="False">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Style="{StaticResource SmallButton}" Content="{Binding Name}" ContentStringFormat="+{0}"
                                                                                    CommandParameter="{Binding}" Margin="0,0,4,4"
                                                                                    ToolTip="Extend from today or from the current end, whichever is later"
                                                                                    Command="{Binding DataContext.ExtendCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </views:ItemsList>
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </views:ItemsList>
                                </HeaderedContentControl>

                                <!-- Package and validity -->
                                <HeaderedContentControl x:Name="SecPackage" Style="{StaticResource FormSection}" Tag="&#xE787;" Header="Package and validity"
                                                        AutomationProperties.HelpText="The package gives the features; computers and users are how many may be signed in at once.">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="1.3*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Package *" Style="{StaticResource FormLabel}" />
                                                <ComboBox ItemsSource="{Binding Packages}" SelectedItem="{Binding Package}" DisplayMemberPath="Name" Padding="8,6" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Computers *" Style="{StaticResource FormLabel}" />
                                                <TextBox Style="{StaticResource FormBox}" Margin="0" Padding="8,6" Text="{Binding MaxComputersText, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" ToolTip="How many people may sign in: the account owner and the staff they add in MARK">
                                                <TextBlock Text="Users *" Style="{StaticResource FormLabel}" />
                                                <TextBox Style="{StaticResource FormBox}" Margin="0" Padding="8,6" Text="{Binding MaxUsersText, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="Account valid until *" Style="{StaticResource FormLabel}" />
                                                <DatePicker SelectedDate="{Binding ValidUntil}" Padding="4,5" />
                                            </StackPanel>
                                        </Grid>
                                        <DockPanel Margin="0,14,0,0">
                                            <TextBlock Text="Extend the account" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <views:ItemsList ItemsSource="{Binding ValidityChoices}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource SmallButton}" Content="{Binding Name}" ContentStringFormat="+{0}"
                                                                CommandParameter="{Binding}" Margin="0,0,6,4" Padding="10,3"
                                                                ToolTip="Extend from today or from the current end, whichever is later"
                                                                Command="{Binding DataContext.ExtendCommand, ElementName=AccountPage}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </views:ItemsList>
                                        </DockPanel>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <!-- Features -->
                                <HeaderedContentControl x:Name="SecFeatures" Style="{StaticResource FormSection}" Tag="&#xE71D;" Header="Features"
                                                        AutomationProperties.HelpText="The package's features are ticked: untick one to leave it out for this company. Tick another feature to add it on, with its own end date.">
                                    <views:ItemsList ItemsSource="{Binding FeatureGroups}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FAFBFC" BorderBrush="#EEF0F3" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,12,12">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Area}" Style="{StaticResource SubHeading}" />
                                                        <views:ItemsList ItemsSource="{Binding Features}" Focusable="False">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <DockPanel Margin="0,3">
                                                                        <DatePicker DockPanel.Dock="Right" SelectedDate="{Binding ValidUntil}" Width="125"
                                                                                    ToolTip="Last day of the add-on (empty: same as the account)"
                                                                                    Visibility="{Binding IsAddOn, Converter={StaticResource BoolToVisibility}}" />
                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Tag}" FontSize="10" Margin="8,0" VerticalAlignment="Center"
                                                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                                                        <CheckBox IsChecked="{Binding IsIncluded}" IsEnabled="{Binding CanChange}" VerticalAlignment="Center"
                                                                                  ToolTip="{Binding Description}">
                                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                        </CheckBox>
                                                                    </DockPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </views:ItemsList>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </views:ItemsList>
                                </HeaderedContentControl>

                                <!-- Catalogue -->
                                <HeaderedContentControl x:Name="SecCatalogue" Style="{StaticResource FormSection}" Tag="&#xE8F1;" Header="Catalogue"
                                                        AutomationProperties.HelpText="What this company gets from your catalogue. Items made for it alone are on the Catalogue page.">
                                    <StackPanel>
                                        <ContentControl Content="{Binding CatalogueChoice}" ContentTemplate="{StaticResource CatalogueChoiceTemplate}" Focusable="False"
                                                        Visibility="{Binding HasCatalogue, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="No catalogue is published yet. Publish one on the Catalogue page; until then the company keeps its own library."
                                                   TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}"
                                                   Visibility="{Binding HasCatalogue, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </StackPanel>
                                </HeaderedContentControl>

                                <!-- Quotation details: printed on the company's quotations; only you set them -->
                                <HeaderedContentControl x:Name="SecQuotation" Style="{StaticResource FormSection}" Tag="&#xE8A5;" Header="Quotation details"
                                                        AutomationProperties.HelpText="Printed on every page of the company's quotation PDFs. Only you set them: the company does not see or change them in MARK.">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Details -->
                                            <StackPanel>
                                                <TextBlock Text="The company's details" Style="{StaticResource SubHeading}" />
                                                <TextBlock Text="Line above the company name, e.g. Authorised partner" Style="{StaticResource FormLabel}" />
                                                <TextBox Style="{StaticResource FormBox}" Padding="8,6" Text="{Binding PartnerLabel, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Address (one or more lines)" Style="{StaticResource FormLabel}" />
                                                <TextBox Style="{StaticResource FormBox}" Padding="8,6" MinHeight="58" TextWrapping="Wrap" AcceptsReturn="True"
                                                         VerticalContentAlignment="Top" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Contact no." Style="{StaticResource FormLabel}" />
                                                        <TextBox Style="{StaticResource FormBox}" Padding="8,6" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Text="Website" Style="{StaticResource FormLabel}" />
                                                        <TextBox Style="{StaticResource FormBox}" Padding="8,6" Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="E-mail" Style="{StaticResource FormLabel}" />
                                                        <TextBox Style="{StaticResource FormBox}" Padding="8,6" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Text="GSTIN" Style="{StaticResource FormLabel}" />
                                                        <TextBox Style="{StaticResource FormBox}" Padding="8,6" Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Bank -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Bank details" Style="{StaticResource SubHeading}" />
                                                <TextBlock Text="Account name" Style="{StaticResource FormLabel}" />
                                                <TextBox Style="{StaticResource FormBox}" Padding="8,6" Text="{Binding BankAccountName, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Account number" Style="{StaticResource FormLabel}" />
                                                <TextBox Style="{StaticResource FormBox}" Padding="8,6" Text="{Binding BankAccountNumber, UpdateSourceTrigger=PropertyChanged}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Bank" Style="{StaticResource FormLabel}" />
                                                        <TextBox Style="{StaticResource FormBox}" Padding="8,6" Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Text="IFSC" Style="{StaticResource FormLabel}" />
                                                        <TextBox Style="{StaticResource FormBox}" Padding="8,6" Text="{Binding BankIfsc, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Branch" Style="{StaticResource FormLabel}" />
                                                        <TextBox Style="{StaticResource FormBox}" Padding="8,6" Text="{Binding BankBranch, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <Border BorderBrush="#EEF0F3" BorderThickness="0,1,0,0" Margin="0,10,0,14" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Brand -->
                                            <StackPanel>
                                                <TextBlock Text="Brand" Style="{StaticResource SubHeading}" />
                                                <TextBlock Text="Top left of every page, e.g. the profile system the company sells. Leave empty for none."
                                                           Style="{StaticResource FieldHelp}" Margin="0,0,0,4" />
                                                <TextBlock Text="Brand name" Style="{StaticResource FormLabel}" />
                                                <TextBox Style="{StaticResource FormBox}" Padding="8,6" Text="{Binding BrandName, UpdateSourceTrigger=PropertyChanged}" />
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource PictureBox}" Width="160" Height="64" Margin="0,0,14,0">
                                                        <Grid>
                                                            <TextBlock Text="No brand logo" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding HasBrandLogo, Converter={StaticResource InverseBoolToVisibility}}" />
                                                            <Image Source="{Binding BrandLogo}" Stretch="Uniform" Margin="6" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SmallButton}" Content="Choose brand logo…" HorizontalAlignment="Left" Margin="0,0,0,6"
                                                                Command="{Binding DataContext.ChooseBrandLogoCommand, ElementName=CompaniesPage}" />
                                                        <Button Style="{StaticResource SmallButton}" Content="Remove" HorizontalAlignment="Left" Margin="0"
                                                                Command="{Binding DataContext.RemoveBrandLogoCommand, ElementName=CompaniesPage}"
                                                                Visibility="{Binding HasBrandLogo, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>

                                            <!-- Last page -->
                                            <StackPanel Grid.Column="2">
                                                <DockPanel Margin="0,0,0,6">
                                                    <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,1" Background="#F1F3F6" VerticalAlignment="Center">
                                                        <TextBlock Text="Optional" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
                                                    </Border>
                                                    <TextBlock Text="Last page picture" Style="{StaticResource SubHeading}" Margin="0" />
                                                </DockPanel>
                                                <TextBlock Text="One picture on a page of its own at the end, e.g. care instructions. Leave empty for no last page."
                                                           Style="{StaticResource FieldHelp}" Margin="0,0,0,10" />
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource PictureBox}" Width="88" Height="118" Margin="0,0,14,0">
                                                        <Grid>
                                                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource MutedTextBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding HasExtraPage, Converter={StaticResource InverseBoolToVisibility}}" />
                                                            <Image Source="{Binding ExtraPage}" Stretch="Uniform" Margin="4" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SmallButton}" Content="Choose picture…" HorizontalAlignment="Left" Margin="0,0,0,6"
                                                                Command="{Binding DataContext.ChooseExtraPageCommand, ElementName=CompaniesPage}" />
                                                        <Button Style="{StaticResource SmallButton}" Content="Remove" HorizontalAlignment="Left" Margin="0"
                                                                Command="{Binding DataContext.RemoveExtraPageCommand, ElementName=CompaniesPage}"
                                                                Visibility="{Binding HasExtraPage, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <!-- Computers and staff (an existing account) -->
                                <HeaderedContentControl x:Name="SecComputers" Style="{StaticResource FormSection}" Tag="&#xE7F4;" Header="Computers and staff"
                                                        AutomationProperties.HelpText="Where the company is signed in, and the staff logins its account owner added in MARK."
                                                        Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Computers signed in" Style="{StaticResource SubHeading}" />
                                            <TextBlock Text="None yet." Foreground="{StaticResource SubtleTextBrush}"
                                                       Visibility="{Binding HasComputers, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <views:ItemsList ItemsSource="{Binding Computers}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="0,8">
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Free" CommandParameter="{Binding}"
                                                                        VerticalAlignment="Center" ToolTip="Sign this computer out so another can be used"
                                                                        Command="{Binding DataContext.FreeComputerCommand, ElementName=CompaniesPage}" />
                                                                <TextBlock DockPanel.Dock="Left" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,2,10,0"
                                                                           Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Top" />
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock FontSize="11" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap">
                                                                        <Run Text="{Binding UserId, Mode=OneWay}" /><Run Text=" · last check-in " /><Run Text="{Binding LastCheckInUtc, Mode=OneWay, StringFormat={}{0:d MMM yyyy HH:mm} UTC}" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </views:ItemsList>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Staff logins" Style="{StaticResource SubHeading}" Margin="0,0,0,2" />
                                            <TextBlock Text="{Binding UsersInUseText}" Style="{StaticResource FieldHelp}" Margin="0,0,0,6" />
                                            <TextBlock Text="None. The account owner adds staff in MARK (Account › Staff logins)." TextWrapping="Wrap"
                                                       Foreground="{StaticResource SubtleTextBrush}"
                                                       Visibility="{Binding HasStaff, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <views:ItemsList ItemsSource="{Binding Staff}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="0,8">
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Remove" CommandParameter="{Binding}"
                                                                        VerticalAlignment="Center" ToolTip="Remove this staff login (MARK on their computers is signed out)"
                                                                        Command="{Binding DataContext.RemoveStaffCommand, ElementName=CompaniesPage}" />
                                                                <TextBlock DockPanel.Dock="Left" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,2,10,0"
                                                                           Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Top" />
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </views:ItemsList>
                                        </StackPanel>
                                    </Grid>
                                </HeaderedContentControl>

                                <!-- Notes -->
                                <HeaderedContentControl x:Name="SecNotes" Style="{StaticResource FormSection}" Tag="&#xE70B;" Header="Notes"
                                                        AutomationProperties.HelpText="Only you see these.">
                                    <TextBox Style="{StaticResource FormBox}" Padding="8,6" Margin="0" MinHeight="80" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalContentAlignment="Top" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                                </HeaderedContentControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </DockPanel>
            </Grid>

            <!-- ══ Updates: the latest MARK release ═══════════════════════ -->
            <ScrollViewer DataContext="{Binding Updates}" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Updates}">
                <StackPanel Margin="28,22" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="Updates" Style="{StaticResource PageTitle}" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource FieldHelp}" Margin="0,4,0,14" TextWrapping="Wrap"
                               Text="Publish a new MARK here: every MARK older than it shows &quot;Update available&quot; with your download link (e.g. the MARK Setup file on your website or a shared drive) and what is new. Customers run MARK Setup to update; their data stays." />
                    <TextBlock Text="{Binding CurrentText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding OwnerVersionText}" Style="{StaticResource FieldHelp}" Margin="0,0,0,14" />
                    <TextBlock Text="Version" Style="{StaticResource FormLabel}" />
                    <TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" Padding="8,6" Margin="0,0,0,10"
                             AutomationProperties.Name="Release version" ToolTip="e.g. 1.1.0" />
                    <TextBlock Text="Download link" Style="{StaticResource FormLabel}" />
                    <TextBox Text="{Binding DownloadUrl, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10" AutomationProperties.Name="Download link" />
                    <TextBlock Text="What is new" Style="{StaticResource FormLabel}" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,12" MinHeight="90"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" AutomationProperties.Name="What is new" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="Publish" Command="{Binding PublishCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Withdraw" Command="{Binding WithdrawCommand}" />
                    </StackPanel>
                    <Border Margin="0,12,0,0" Padding="10" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F5EC" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Background" Value="#FBECEC" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Licence keys ════════════════════════════════════════ -->
            <Grid DataContext="{Binding Keys}"
                  Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Keys}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Side panel: make keys -->
                <Border Background="White" BorderBrush="#E1E5EB" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="22,20,22,22">
                            <TextBlock Text="Licence keys" Style="{StaticResource PageTitle}" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource FieldHelp}" Margin="0,4,0,16"
                                       Text="A company enters a key on MARK's Account page. It renews the account, a product or a feature until the key's date (counted from today)." />

                            <TextBlock Text="For" Style="{StaticResource FormLabel}" />
                            <ComboBox ItemsSource="{Binding CompanyChoices}" SelectedItem="{Binding Company}" Padding="8,6" Margin="0,0,0,10" AutomationProperties.Name="Key for" />
                            <TextBlock Text="Gives" Style="{StaticResource FormLabel}" />
                            <ComboBox ItemsSource="{Binding Gifts}" SelectedItem="{Binding Gift}" Padding="8,6" Margin="0,0,0,10" AutomationProperties.Name="Key gives" />
                            <StackPanel Visibility="{Binding IsFeatureGift, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Feature" Style="{StaticResource FormLabel}" />
                                <ComboBox ItemsSource="{Binding FeatureChoices}" SelectedItem="{Binding Feature}" DisplayMemberPath="Name" Padding="8,6" Margin="0,0,0,10" AutomationProperties.Name="Feature" />
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Valid for" Style="{StaticResource FormLabel}" />
                                    <ComboBox ItemsSource="{Binding ValidityChoices}" SelectedItem="{Binding Validity}" Padding="8,6" AutomationProperties.Name="Valid for" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="How many" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Margin="0" Padding="8,6" Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding ValidUntilText}" Style="{StaticResource FieldHelp}" Margin="0,6,0,10" />
                            <TextBlock Text="Note (only you see it)" Style="{StaticResource FormLabel}" />
                            <TextBox Style="{StaticResource FormBox}" Padding="8,6" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Padding="16,9" HorizontalAlignment="Stretch" Command="{Binding GenerateCommand}"
                                    AutomationProperties.Name="Generate keys">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,8,0" />
                                    <TextBlock Text="Generate keys" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Border Background="#F7FAFF" BorderBrush="#BFD5F5" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,18,0,0"
                                    Visibility="{Binding HasNewKeys, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Copy all"
                                                Command="{Binding CopyCommand}" CommandParameter="{Binding NewKeysText}" />
                                        <TextBlock Text="New keys" Style="{StaticResource SubHeading}" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBox Text="{Binding NewKeysText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="13" Margin="0,10,0,0"
                                             TextWrapping="NoWrap" MaxHeight="200" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="White" Padding="8" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- All keys -->
                <DockPanel Grid.Column="1" Margin="28,20,28,22">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
                        <TextBlock Text="All keys" Style="{StaticResource CardTitle}" FontSize="18" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PageMessage}">
                        <TextBlock Text="{Binding Message}" Style="{StaticResource PageMessageText}" />
                    </Border>
                    <Border Style="{StaticResource Card}" CornerRadius="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="20,24" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}"
                                       Text="No keys yet. Make some with Generate keys on the left: they are listed here with whom they are for and whether they are used."
                                       Visibility="{Binding Keys.Count, Converter={StaticResource CountToCollapsed}}" />
                            <ListBox ItemsSource="{Binding Keys}" Style="{StaticResource SideList}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="230" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding KeyText}" FontFamily="Consolas" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="12,0">
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding GivesText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" until " /><Run Text="{Binding ValidUntilText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ForText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource SmallButton}" Content="Copy" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        Visibility="{Binding IsUnused, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Style="{StaticResource SmallButton}" Content="Cancel key" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        Visibility="{Binding CanRevoke, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- ══ Packages ════════════════════════════════════════════ -->
            <Grid DataContext="{Binding Packages}"
                  Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Packages}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Side panel: the packages -->
                <Border Background="White" BorderBrush="#E1E5EB" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="22,20,22,8">
                            <TextBlock Text="Packages" Style="{StaticResource PageTitle}" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource FieldHelp}" Margin="0,4,0,14"
                                       Text="A package is a set of features you sell. Each company gets one package, plus add-ons or removals in its account." />
                            <Button Style="{StaticResource PrimaryButton}" Margin="0" Padding="12,8" HorizontalAlignment="Stretch" Content="+ New package"
                                    Command="{Binding NewCommand}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding Selected}" Style="{StaticResource SideList}" Margin="4,0,4,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" CornerRadius="9" Padding="7,1" Background="#F1F3F6" VerticalAlignment="Center">
                                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}">
                                                    <Run Text="{Binding Features.Count, Mode=OneWay}" /><Run Text=" features" />
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1F2A37" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,3,0,0"
                                                   MaxHeight="32" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- The chosen package -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="28,20,28,28" MaxWidth="1040">
                        <Border Style="{StaticResource PageMessage}">
                            <TextBlock Text="{Binding Message}" Style="{StaticResource PageMessageText}" />
                        </Border>
                        <StackPanel Margin="0,60,0,0" HorizontalAlignment="Center" Visibility="{Binding HasEditor, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="32" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="Choose a package on the left, or make a new one." Foreground="{StaticResource SubtleTextBrush}" Margin="0,10,0,0" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel Margin="0,0,0,16">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource DangerButton}" Content="Delete" Command="{Binding DeleteCommand}" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Save package" Padding="18,7" Margin="8,0,0,0" Command="{Binding SaveCommand}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding EditorTitle}" FontSize="20" FontWeight="SemiBold" Foreground="#1F2A37" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding UsedByText}" Style="{StaticResource FieldHelp}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <HeaderedContentControl Style="{StaticResource FormSection}" Tag="&#xE70F;" Header="Details">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Name *" Style="{StaticResource FormLabel}" />
                                        <TextBox Style="{StaticResource FormBox}" Margin="0" Padding="8,6" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Description" Style="{StaticResource FormLabel}" />
                                        <TextBox Style="{StaticResource FormBox}" Margin="0" Padding="8,6" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource FormSection}" Tag="&#xE71D;" Header="Features in this package"
                                                    AutomationProperties.HelpText="Hover over a feature to see what it does.">
                                <views:ItemsList ItemsSource="{Binding FeatureGroups}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FAFBFC" BorderBrush="#EEF0F3" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,12,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Area}" Style="{StaticResource SubHeading}" />
                                                    <views:ItemsList ItemsSource="{Binding Features}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanChange}" Margin="0,3" ToolTip="{Binding Description}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Name}" />
                                                                        <TextBlock Text="{Binding Tag}" Margin="8,0,0,0" FontSize="10" Foreground="{StaticResource SubtleTextBrush}"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </CheckBox>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </views:ItemsList>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </views:ItemsList>
                            </HeaderedContentControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ══ Company types ═══════════════════════════════════════ -->
            <Grid DataContext="{Binding CompanyTypes}"
                  Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=CompanyTypes}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Side panel: the types -->
                <Border Background="White" BorderBrush="#E1E5EB" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="22,20,22,8">
                            <TextBlock Text="Company types" Style="{StaticResource PageTitle}" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource FieldHelp}" Margin="0,4,0,14"
                                       Text="The kinds of companies you sell to. Choosing a type for a new account fills in its products, package and validity." />
                            <Button Style="{StaticResource PrimaryButton}" Margin="0" Padding="12,8" HorizontalAlignment="Stretch" Content="+ New type"
                                    Command="{Binding NewCommand}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Types}" SelectedItem="{Binding Selected}" Style="{StaticResource SideList}" Margin="4,0,4,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1F2A37" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- The chosen type -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="28,20,28,28" MaxWidth="1040">
                        <Border Style="{StaticResource PageMessage}">
                            <TextBlock Text="{Binding Message}" Style="{StaticResource PageMessageText}" />
                        </Border>
                        <StackPanel Margin="0,60,0,0" HorizontalAlignment="Center" Visibility="{Binding HasEditor, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="32" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="Choose a company type on the left, or make a new one." Foreground="{StaticResource SubtleTextBrush}" Margin="0,10,0,0" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel Margin="0,0,0,16">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource DangerButton}" Content="Delete" Command="{Binding DeleteCommand}" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Save type" Padding="18,7" Margin="8,0,0,0" Command="{Binding SaveCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding EditorTitle}" FontSize="20" FontWeight="SemiBold" Foreground="#1F2A37" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <HeaderedContentControl Style="{StaticResource FormSection}" Tag="&#xE70F;" Header="Details"
                                                    AutomationProperties.HelpText="What a new account of this type starts with. You can still change it in the account.">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Name *" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Margin="0" Padding="8,6" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Package" Style="{StaticResource FormLabel}" />
                                            <ComboBox ItemsSource="{Binding Packages}" SelectedItem="{Binding Package}" DisplayMemberPath="Name" Padding="8,6" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Valid for (days)" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Margin="0" Padding="8,6" Text="{Binding ValidityDaysText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Products" Style="{StaticResource FormLabel}" Margin="0,14,0,6" />
                                    <views:ItemsList ItemsSource="{Binding Products}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E1E5EB" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,10,0">
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </views:ItemsList>
                                </StackPanel>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource FormSection}" Tag="&#xE8F1;" Header="Catalogue for new accounts of this type"
                                                    Visibility="{Binding HasCatalogue, Converter={StaticResource BoolToVisibility}}">
                                <ContentControl Content="{Binding CatalogueChoice}" ContentTemplate="{StaticResource CatalogueChoiceTemplate}" Focusable="False" />
                            </HeaderedContentControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ══ Catalogue ═══════════════════════════════════════════ -->
            <ScrollViewer DataContext="{Binding Catalogue}" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Catalogue}">
                <StackPanel Margin="20,16,20,16" MaxWidth="1100" HorizontalAlignment="Left">
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="Import file..." Command="{Binding ImportCommand}"
                                    ToolTip="Add a library file to the catalogue, replace the catalogue with it, or make it one company's own items" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Export file..." Command="{Binding ExportCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Edit catalogue..." Command="{Binding EditCommand}"
                                    ToolTip="Profiles, glass, hardware, systems and bundles, in the Library Manager" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Catalogue" Style="{StaticResource PageTitle}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource PageMessage}">
                        <TextBlock Text="{Binding Message}" Style="{StaticResource PageMessageText}" />
                    </Border>
                    <TextBlock TextWrapping="Wrap" Foreground="#4B5563" Margin="0,0,0,12"
                               Text="Everything companies can use comes from here: profiles, glass, hardware, systems and bundles. Only you can change it. In each company's account you tick the systems and items it gets; below you make items for one company only. Companies receive them at their next check-in and enter only their own prices." />

                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12"
                            Visibility="{Binding HasCatalogue, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Start your catalogue" Style="{StaticResource CardTitle}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,10"
                                       Text="Begin with the sample catalogue (aluminium casement, 62mm uPVC casement with steel reinforcement, aluminium 2-track sliding), import a library file, or start empty with Edit catalogue." />
                            <Button Style="{StaticResource PrimaryButton}" Margin="0" HorizontalAlignment="Left" Content="Use the sample catalogue"
                                    Command="{Binding UseSampleCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,16" Visibility="{Binding HasCatalogue, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding CountsText}" FontWeight="SemiBold" Foreground="#1F2A37" />
                            <TextBlock Text="SYSTEMS" Style="{StaticResource SectionTitle}" />
                            <views:ItemsList ItemsSource="{Binding SystemRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E3E6EA" BorderThickness="0,0,0,1" Padding="0,8">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" CornerRadius="9" Padding="8,1" Margin="0,1,12,0" VerticalAlignment="Top"
                                                        Background="#E8EEF7" Width="86">
                                                    <TextBlock Text="{Binding Material}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                                               HorizontalAlignment="Center" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1F2A37" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                    <views:ItemsList ItemsSource="{Binding Bundles}" Margin="0,4,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border CornerRadius="4" Padding="6,1" Margin="0,2,6,0" Background="#F1F3F6">
                                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="#374151" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </views:ItemsList>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </views:ItemsList>
                            <DockPanel Margin="0,16,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource SmallButton}" Content="+ Profile" Margin="0,0,6,0" Command="{Binding AddItemCommand}" CommandParameter="Profile"
                                            ToolTip="Add a profile to the catalogue" />
                                    <Button Style="{StaticResource SmallButton}" Content="+ Glass" Margin="0,0,6,0" Command="{Binding AddItemCommand}" CommandParameter="Glass"
                                            ToolTip="Add a glass type to the catalogue (thickness, price per m², look)" />
                                    <Button Style="{StaticResource SmallButton}" Content="+ Hardware" Margin="0,0,6,0" Command="{Binding AddItemCommand}" CommandParameter="Material"
                                            ToolTip="Add hardware or an accessory to the catalogue" />
                                    <Button Style="{StaticResource SmallButton}" Content="+ System" Command="{Binding AddItemCommand}" CommandParameter="System"
                                            ToolTip="Add a system: its profiles, glass and glass range" />
                                </StackPanel>
                                <TextBlock Text="ITEMS" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Background="#FFF7E6" BorderBrush="#F3D9A4" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                    Visibility="{Binding HasNoGlass, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Add glass…" Command="{Binding AddItemCommand}"
                                            CommandParameter="Glass" VerticalAlignment="Center" />
                                    <TextBlock TextWrapping="Wrap" Foreground="#7A4E00" VerticalAlignment="Center"
                                               Text="The catalogue has no glass yet, so windows made with it cannot be glazed or priced for glass. Add the glass types you sell (thickness, price per m², look)." />
                                </DockPanel>
                            </Border>
                            <TextBlock Text="Profiles by series, then glass and hardware. Open a group to see its items."
                                       FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                            <views:ItemsList ItemsSource="{Binding ItemGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E3E6EA" BorderThickness="0,0,0,1" Padding="0,4">
                                            <Expander>
                                                <Expander.Header>
                                                    <TextBlock>
                                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1F2A37" />
                                                        <Run Text="{Binding CountText, Mode=OneWay}" FontSize="11" Foreground="#8A8A8A" />
                                                    </TextBlock>
                                                </Expander.Header>
                                                <views:ItemsList ItemsSource="{Binding Rows}" Margin="22,4,0,6">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="70" />
                                                                    <ColumnDefinition Width="260" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Code}" Foreground="#4B5563" FontFamily="Consolas" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#1F2A37" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </views:ItemsList>
                                            </Expander>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </views:ItemsList>
                        </StackPanel>
                    </Border>

                    <!-- Items for one company only -->
                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Companies' own items" Style="{StaticResource CardTitle}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,8"
                                       Text="Profiles, glass, hardware, systems and bundles for one company only. They can use items of the catalogue, come on top of what is ticked in the company's account, and show in its MARK under the company's name. Own systems also appear as ready-made designs in its design library." />
                            <TextBlock Text="No companies yet." Foreground="{StaticResource MutedTextBrush}"
                                       Visibility="{Binding HasCompanies, Converter={StaticResource InverseBoolToVisibility}}" />
                            <views:ItemsList ItemsSource="{Binding OwnItemRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E3E6EA" BorderThickness="0,0,0,1" Padding="0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Edit own items…" VerticalAlignment="Center"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Edit own items of {0}}"
                                                        ToolTip="Opens the Library Manager with the catalogue and this company's own items. What you add there only this company gets."
                                                        Command="{Binding DataContext.EditOwnItemsCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1F2A37" />
                                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </views:ItemsList>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
