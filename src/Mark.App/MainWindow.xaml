<Window x:Class="Mark.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Mark.Designer.Controls;assembly=Mark.Designer"
        xmlns:views="clr-namespace:Mark.Designer.Views;assembly=Mark.Designer"
        xmlns:vm="clr-namespace:Mark.Designer.ViewModels;assembly=Mark.Designer"
        Icon="pack://application:,,,/Resources/mark.ico" Title="{Binding Title}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ChromeBackgroundBrush}">

    <Window.Resources>
        <views:EnumToBooleanConverter x:Key="EnumToBool" />
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <views:EnumToVisibilityConverter x:Key="EnumToVisibility" />
        <views:AllTrueToVisibilityConverter x:Key="AllTrueToVisibility" />
        <views:FractionToWidthConverter x:Key="FractionToWidth" />
        <views:CountToVisibilityConverter x:Key="CountToVisibility" />
        <views:CountToVisibilityConverter x:Key="CountToCollapsed" Invert="True" />

        <!-- Design details of the selected frame (reference, quantity, where it goes). -->
        <DataTemplate DataType="{x:Type vm:DesignInfoEditorViewModel}">
            <StackPanel Margin="12,0,12,8">
                <StackPanel.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ApplyCommand}" />
                </StackPanel.InputBindings>
                <TextBlock Text="DESIGN" Style="{StaticResource PanelHeader}" Margin="0,2,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Design ref." Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" Padding="4,2" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Shown above the drawing and in quotes, e.g. W1" />
                    <TextBlock Grid.Row="1" Text="Quantity" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="pcs" Style="{StaticResource UnitLabel}" />
                    <TextBlock Grid.Row="2" Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" Padding="4,2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="3" Text="Location" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" Padding="4,2" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" Text="Floor" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" Padding="4,2" Text="{Binding Floor, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="5" Text="Floor distance" Style="{StaticResource FieldLabel}"
                               ToolTip="Height of the bottom of the frame above the finished floor. Empty = no floor line." />
                    <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding FloorDistanceText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                    <TextBlock Grid.Row="6" Text="Profile colour" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,2" IsEditable="True" AutomationProperties.Name="Profile colour"
                              ItemsSource="{x:Static vm:DesignInfoEditorViewModel.Colours}" Text="{Binding ProfileColour, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Shown on the quotation, e.g. White or Golden Oak" />
                    <TextBlock Grid.Row="7" Text="Handle colour" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="7" Grid.Column="1" Margin="0,2" IsEditable="True" AutomationProperties.Name="Handle colour"
                              ItemsSource="{x:Static vm:DesignInfoEditorViewModel.Colours}" Text="{Binding HandleColour, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="8" Text="Mesh type" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="8" Grid.Column="1" Margin="0,2" IsEditable="True" AutomationProperties.Name="Mesh type"
                              ItemsSource="{x:Static vm:DesignInfoEditorViewModel.MeshTypes}" Text="{Binding MeshType, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="The insect mesh of the panes that have one, e.g. SS Flymesh" />
                    <TextBlock Grid.Row="9" Text="Extra cost" Style="{StaticResource FieldLabel}"
                               ToolTip="An extra cost per window for this design only: the Extra Cost line of the cost sheet" />
                    <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource NumberBox}" AutomationProperties.Name="Extra cost"
                             Text="{Binding ExtraCostText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="9" Grid.Column="2" Text="/ window" Style="{StaticResource UnitLabel}" />
                    <TextBlock Grid.Row="10" Text="Note" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,4,0,0" />
                    <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2" Padding="4,2" TextWrapping="Wrap" MinHeight="38"
                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Button Style="{StaticResource PanelButton}" Content="Apply" Command="{Binding ApplyCommand}" Margin="0,6,0,0" HorizontalAlignment="Left"
                        ToolTip="Apply everything typed in this panel (Enter). Save stores it with the quote." />
                <Border Margin="0,6,0,0" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- How the selected opening(s) open, and the mesh shutter. -->
        <DataTemplate DataType="{x:Type vm:OpeningEditorViewModel}">
            <StackPanel Margin="12,4,12,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                              DisplayMemberPath="Name" ToolTip="{Binding Hint}" AutomationProperties.HelpText="{Binding Hint}" />
                    <TextBlock Grid.Column="1" Text="{Binding MixedText}" Margin="7,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsMixed, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <CheckBox Margin="90,6,0,0" Content="Insect mesh shutter" IsChecked="{Binding HasMesh}" Focusable="False" />
                <Border Margin="0,6,0,0" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- A name / value / unit row of the properties panel. -->
        <DataTemplate x:Key="PropertyRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextAlignment="Right" TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding Unit}" Margin="4,0,0,0"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </DataTemplate>

        <!-- Searchable library selection (glass type / profile) in the properties panel. -->
        <DataTemplate DataType="{x:Type vm:LibraryPickerViewModel}">
            <StackPanel Margin="12,10,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding CurrentText}" TextWrapping="Wrap" TextAlignment="Right"
                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                </Grid>
                <ComboBox Margin="0,6,0,0" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                          views:SearchCombo.FiltersItems="False" views:SearchCombo.Query="{Binding SearchText}"
                          ToolTip="Choose a library item to assign it; type in the search box at the top of the list to find it by name, code, type or series">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,1">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding ResultSummary}" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0"
                           Foreground="{StaticResource MutedTextBrush}" />
                <Border Margin="0,4,0,0" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                </Border>
            </StackPanel>
        </DataTemplate>
        <!-- Bill of materials for the whole project (with the costing feature): properties panel and Pricing › Bill of materials. -->
        <DataTemplate x:Key="BillOfMaterialsPanel">
            <StackPanel>
                                    <!-- Bill of materials for the whole project (with the costing feature) -->
                                    <ContentControl Style="{StaticResource LockNotice}" Margin="10,18,10,6" Content="{Binding Access.CostingLock}"
                                                    Visibility="{Binding Access.CanSeeCosting, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <StackPanel Visibility="{Binding Access.CanSeeCosting, Converter={StaticResource BoolToVisibility}}">
                                    <!-- Bill of materials: total with a cost bar, then colour-coded groups -->
                                    <Border Margin="10,18,10,6" Padding="14,12" CornerRadius="8" Background="White"
                                            BorderBrush="#DDE1E6" BorderThickness="1"
                                            Visibility="{Binding BomGroups.Count, Converter={StaticResource CountToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="BILL OF MATERIALS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}" />
                                            <TextBlock Text="{Binding CostText}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"
                                                       Foreground="#1F2A37" />
                                            <TextBlock Text="{Binding BomSummaryText}" FontSize="10" TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <!-- Share of each group in the cost -->
                                            <Border x:Name="BomBar" Margin="0,10,0,4" Height="8" CornerRadius="4" Background="#EEF0F3" ClipToBounds="True">
                                                <views:ItemsList ItemsSource="{Binding BomGroups}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Rectangle Height="8" Fill="{Binding Accent}" ToolTip="{Binding Title}">
                                                                <Rectangle.Width>
                                                                    <MultiBinding Converter="{StaticResource FractionToWidth}">
                                                                        <Binding Path="Share" />
                                                                        <Binding Path="ActualWidth" ElementName="BomBar" />
                                                                    </MultiBinding>
                                                                </Rectangle.Width>
                                                            </Rectangle>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </views:ItemsList>
                                            </Border>
                                            <!-- Legend -->
                                            <views:ItemsList ItemsSource="{Binding BomGroups}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,10,0">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding Accent}" VerticalAlignment="Center" />
                                                            <TextBlock Margin="4,0,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}">
                                                                <Run Text="{Binding Title, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding ShareText, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </views:ItemsList>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="12,18,12,4" Style="{StaticResource PanelHeader}" Text="BILL OF MATERIALS"
                                               Visibility="{Binding BomGroups.Count, Converter={StaticResource CountToCollapsed}}" />
                                    <Border Margin="10,0,10,6" Padding="8" CornerRadius="6" Background="{StaticResource ErrorBackgroundBrush}"
                                            Visibility="{Binding HasCalculationStatus, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding CalculationStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource ErrorBrush}" />
                                    </Border>

                                    <views:ItemsList ItemsSource="{Binding BomGroups}" Margin="10,0,10,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" CornerRadius="8" Background="White" BorderBrush="#E3E6EA" BorderThickness="1"
                                                        ClipToBounds="True">
                                                    <StackPanel>
                                                        <ToggleButton IsChecked="{Binding IsExpanded}" Style="{StaticResource BomGroupHeader}" />
                                                        <views:ItemsList ItemsSource="{Binding Items}"
                                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="#F0F2F5" BorderThickness="0,1,0,0" Padding="12,7,12,7">
                                                                        <StackPanel>
                                                                            <DockPanel>
                                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Cost}" FontWeight="SemiBold"
                                                                                           Foreground="#1F2A37" Margin="8,0,0,0" />
                                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                                                           Foreground="#1F2A37" ToolTip="{Binding Name}" />
                                                                            </DockPanel>
                                                                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                                                       Margin="0,1,0,0" />
                                                                            <views:ItemsList ItemsSource="{Binding SubLines}" Margin="2,4,0,0"
                                                                                          Visibility="{Binding HasSubLines, Converter={StaticResource BoolToVisibility}}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Border BorderBrush="#BFE7EC" BorderThickness="2,0,0,0" Padding="7,1,0,1">
                                                                                            <DockPanel>
                                                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Cost}" FontSize="10"
                                                                                                           Foreground="#4B5563" />
                                                                                                <TextBlock Text="{Binding Text}" FontSize="10" Foreground="#4B5563"
                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                            </DockPanel>
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </views:ItemsList>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </views:ItemsList>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </views:ItemsList>

                                    </StackPanel>

            </StackPanel>
        </DataTemplate>

        <!-- Cutting plan for the whole project (with the cutting-plans feature): properties panel and Production › Cutting plan. -->
        <DataTemplate x:Key="CuttingPlanPanel">
            <StackPanel>
                                    <!-- Cutting plan (stock bars, remnants, waste) for the whole project (with the cutting-plans feature) -->
                                    <ContentControl Style="{StaticResource LockNotice}" Margin="10,8,10,12" Content="{Binding Access.CuttingPlansLock}"
                                                    Visibility="{Binding Access.CanSeeCuttingPlans, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <StackPanel DataContext="{Binding Cutting}"
                                                Visibility="{Binding DataContext.Access.CanSeeCuttingPlans, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource PanelHeader}" Text="CUTTING PLAN" Margin="12,8,12,4" />
                                        <TextBlock Margin="12,0,12,2" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                                                   Text="{Binding SummaryText}" />
                                        <TextBlock Margin="12,0,12,2" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Text="{Binding CostText}"
                                                   Visibility="{Binding ShowsCosts, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Margin="12,0,12,6" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding RulesText}" />
                                        <Border Margin="12,0,12,6" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                                                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                                        </Border>
                                        <views:ItemsList ItemsSource="{Binding Profiles}" Margin="12,0,12,12">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,4">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                        <TextBlock Text="{Binding Summary}" FontSize="10" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                        <views:ItemsList ItemsSource="{Binding Bars}" Margin="8,2,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="0,2">
                                                                        <!-- Runs on one line: XAML whitespace between them would show as a space. -->
                                                                        <TextBlock Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"><Run Text="{Binding Stock, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Cuts, Mode=OneWay}" /></TextBlock>
                                                                        <TextBlock Text="{Binding Leftover}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </views:ItemsList>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </views:ItemsList>
                                    </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- A tab of the current area in the header (lock: not in the package). -->
        <Style x:Key="AreaTabButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="14,6" Margin="2,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5FB" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3EDFB" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An area in the area bar on the left. -->
        <Style x:Key="AreaRailButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#C9D1DC" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" Margin="6,2" CornerRadius="6" Padding="2,8">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </Border>
                            <Rectangle x:Name="Marker" Width="3" HorizontalAlignment="Left" Margin="0,10" Fill="#6AA6F5" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B3A4D" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33465E" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A line of quote history (Client tab, dashboard). -->
        <DataTemplate x:Key="HistoryLine">
            <Border BorderBrush="#F0F2F5" BorderThickness="0,1,0,0" Padding="0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding When}" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Who}" FontWeight="SemiBold" Foreground="#1F2A37" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="#1F2A37" TextTrimming="CharacterEllipsis"><Run Text="{Binding What, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Quote, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewProjectCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding AreaByNumberCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding AreaByNumberCommand}" CommandParameter="2" />
        <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding AreaByNumberCommand}" CommandParameter="3" />
        <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding AreaByNumberCommand}" CommandParameter="4" />
        <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding AreaByNumberCommand}" CommandParameter="5" />
        <KeyBinding Modifiers="Ctrl" Key="D6" Command="{Binding AreaByNumberCommand}" CommandParameter="6" />
        <KeyBinding Modifiers="Ctrl" Key="D7" Command="{Binding AreaByNumberCommand}" CommandParameter="7" />
        <KeyBinding Modifiers="Ctrl" Key="D8" Command="{Binding AreaByNumberCommand}" CommandParameter="8" />
        <KeyBinding Modifiers="Ctrl" Key="D9" Command="{Binding AreaByNumberCommand}" CommandParameter="9" />
        <KeyBinding Key="F1" Command="{Binding ShortcutsCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- ── Menu ─────────────────────────────────────────────── -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource ChromeBackgroundBrush}" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_New Quote" InputGestureText="Ctrl+N" Command="{Binding NewProjectCommand}" />
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Command="{Binding OpenProjectCommand}" />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveProjectCommand}" />
                <MenuItem Header="Save a _Copy As..." Command="{Binding SaveProjectAsCommand}" />
                <Separator />
                <MenuItem Header="_Import Project File..." Command="{Binding ImportProjectFileCommand}" />
                <MenuItem Header="_Export Project File..." Command="{Binding ExportProjectFileCommand}" />
                <Separator />
                <MenuItem Header="_Library Manager..." Command="{Binding OpenLibraryManagerCommand}" />
                <Separator />
                <MenuItem Header="_Back Up..." Command="{Binding BackupCommand}" ToolTip="Everything in MARK on this computer, in one file" />
                <MenuItem Header="_Restore from Backup..." Command="{Binding RestoreCommand}" />
                <MenuItem Header="Open Backups _Folder" Command="{Binding OpenBackupsCommand}" ToolTip="Automatic backups: one a day, the newest 10 kept" />
                <Separator />
                <MenuItem Header="_Account" Command="{Binding ShowPageCommand}" CommandParameter="Account"
                          Visibility="{Binding HasAccount, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="S_taff Logins" Command="{Binding ShowViewCommand}" CommandParameter="Staff"
                          Visibility="{Binding HasStaff, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="Sign _Out" Command="{Binding Account.SignOutCommand}"
                          Visibility="{Binding HasAccount, Converter={StaticResource BoolToVisibility}}" />
                <Separator Visibility="{Binding HasAccount, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit" Visibility="{Binding Access.CanUseDrawing, Converter={StaticResource BoolToVisibility}}">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" />
                <MenuItem Header="_Delete" InputGestureText="Del" Command="{Binding DeleteSelectedCommand}" />
            </MenuItem>
            <MenuItem Header="_View" Visibility="{Binding Access.CanUseDrawing, Converter={StaticResource BoolToVisibility}}">
                <MenuItem Header="Zoom _In" Command="{Binding Canvas.ZoomInCommand}" />
                <MenuItem Header="Zoom _Out" Command="{Binding Canvas.ZoomOutCommand}" />
                <MenuItem Header="_Fit to Screen" InputGestureText="F" Command="{Binding Canvas.FitCommand}" />
                <MenuItem Header="_Reset View" Command="{Binding Canvas.ResetViewCommand}" />
                <Separator />
                <MenuItem Header="Show _Grid" InputGestureText="G" IsCheckable="True" IsChecked="{Binding Canvas.ShowGrid}" />
                <MenuItem Header="Show _Axes" IsCheckable="True" IsChecked="{Binding Canvas.ShowAxes}" />
                <Separator />
                <MenuItem Header="_Inside View" IsCheckable="True" IsChecked="{Binding IsInsideView}" />
                <MenuItem Header="_Outside View" IsCheckable="True" IsChecked="{Binding IsOutsideView}" />
            </MenuItem>
            <!-- The areas this login may see. -->
            <MenuItem Header="_Go" ItemsSource="{Binding Areas}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <Setter Property="Command" Value="{Binding ShowCommand}" />
                        <Setter Property="CommandParameter" Value="{Binding Area}" />
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="_Design" Visibility="{Binding Access.CanUseDrawing, Converter={StaticResource BoolToVisibility}}">
                <MenuItem Header="Create _Frame (typed size)" Command="{Binding CreateFrameCommand}" />
                <MenuItem Header="Add _Mullion (centred)" Command="{Binding AddMullionCommand}" />
                <MenuItem Header="Add _Transom (centred)" Command="{Binding AddTransomCommand}" />
            </MenuItem>
            <MenuItem Header="_Tools" Visibility="{Binding Access.CanUseDrawing, Converter={StaticResource BoolToVisibility}}">
                <MenuItem Header="_Select" Command="{Binding SetModeCommand}" CommandParameter="Select" />
                <MenuItem Header="_Pan" Command="{Binding SetModeCommand}" CommandParameter="Pan" />
                <MenuItem Header="Draw _Frame" Command="{Binding SetModeCommand}" CommandParameter="CreateFrame" />
                <MenuItem Header="Place _Mullion" Command="{Binding SetModeCommand}" CommandParameter="AddMullion" />
                <MenuItem Header="Place _Transom" Command="{Binding SetModeCommand}" CommandParameter="AddTransom" />
                <Separator />
                <MenuItem Header="_Object Snap" IsCheckable="True" IsChecked="{Binding ObjectSnapEnabled}" />
                <MenuItem Header="Snap to _Grid" IsCheckable="True" IsChecked="{Binding Canvas.SnapToGrid}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard Shortcuts" InputGestureText="F1" Command="{Binding ShortcutsCommand}" />
                <MenuItem Header="_Drawing Key" Command="{Binding DrawingKeyCommand}" ToolTip="What the labels on the drawing mean" />
                <MenuItem Header="Check for _Updates" Command="{Binding CheckUpdatesCommand}" />
                <Separator />
                <MenuItem Header="_About MARK" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- ── Header: navigation and the open quote ──────────────── -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,14,0" Padding="10,4" Cursor="Hand" Command="{Binding DownloadUpdateCommand}" ToolTip="{Binding UpdateTip}"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Download update"
                            Background="#FFF4E0" BorderBrush="#F0C987" Foreground="#7A4A00" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UpdateText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RowButton}" Margin="0,0,14,0" Command="{Binding ShowPageCommand}" CommandParameter="Account"
                            ToolTip="Your account: licence, package and licence keys"
                            Visibility="{Binding HasAccount, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Access.Logo}" Height="28" MaxWidth="90" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Visibility="{Binding Access.HasLogo, Converter={StaticResource BoolToVisibility}}" />
                            <Border Width="28" Height="28" CornerRadius="14" Background="#E8EEF7" Margin="0,0,8,0"
                                    Visibility="{Binding Access.HasLogo, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="&#xE731;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Access.CompanyName}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                           MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Access.UserName}" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                           MaxWidth="220" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding QuoteTotalText}" VerticalAlignment="Center" Margin="0,0,14,0"
                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               Visibility="{Binding IsQuoteView, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="New quote" Command="{Binding NewProjectCommand}"
                            ToolTip="Start a new quote (Ctrl+N)"
                            Visibility="{Binding Access.CanEditQuotes, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Save" Command="{Binding SaveProjectCommand}"
                            ToolTip="Save the quote, with everything typed on its tabs (Ctrl+S)"
                            Visibility="{Binding IsQuoteView, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="MARK" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" Margin="6,0,14,0" />
                    <Rectangle Width="1" Height="22" Fill="{StaticResource BorderBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#1F2A37"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <!-- The tabs of the current area (only those this login may see; locked: not in the package). -->
                    <views:ItemsList ItemsSource="{Binding Tabs}" VerticalAlignment="Center" Focusable="False"
                                  Visibility="{Binding ShowsTabs, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AreaTabButton}" Command="{Binding ShowCommand}" CommandParameter="{Binding View}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
                                                   Foreground="#B7791F" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Title}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </views:ItemsList>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Licence notice: why MARK is read-only, or a warning (licence ending, offline) ── -->
        <Border DockPanel.Dock="Top" Padding="14,7" BorderThickness="0,0,0,1"
                Visibility="{Binding Access.HasNotice, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFF8E6" />
                    <Setter Property="BorderBrush" Value="#F2D9A0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Access.IsReadOnly}" Value="True">
                            <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="#EBC4C4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Account" Command="{Binding ShowPageCommand}"
                        CommandParameter="Account" Visibility="{Binding HasAccount, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="#B7791F" />
                <TextBlock Text="{Binding Access.Notice}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#3F2A00" />
            </DockPanel>
        </Border>

        <!-- ── Notice: what the last action did, or why it did not happen (on every page) ── -->
        <Border DockPanel.Dock="Top" Padding="14,7" BorderThickness="0,0,0,1"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E8F6EE" />
                    <Setter Property="BorderBrush" Value="#BFE3CC" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NoticeIsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="#EBC4C4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Command="{Binding DismissNoticeCommand}"
                        AutomationProperties.Name="Dismiss message" ToolTip="Dismiss" Padding="6,2">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                </Button>
                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" FontFamily="Segoe MDL2 Assets" FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE73E;" />
                            <Setter Property="Foreground" Value="#1D6B3A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NoticeIsError}" Value="True">
                                    <Setter Property="Text" Value="&#xE783;" />
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1D4D2E" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NoticeIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ── Status bar ───────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Background="{StaticResource PanelBackgroundBrush}" Padding="12,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding Canvas.CursorText}" Foreground="{StaticResource TextBrush}"
                               MinWidth="230" FontFamily="Consolas" />
                    <TextBlock Text="Zoom:" Margin="16,0,4,0" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding Canvas.ZoomPercentage}" Foreground="{StaticResource TextBrush}"
                               MinWidth="48" FontFamily="Consolas" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding ModeHint}" Margin="24,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding Hint}" Margin="24,0,0,0" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HintIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Area bar: the areas this login may see (lock: not in the package; dim: coming later) ── -->
        <Border DockPanel.Dock="Left" Background="#1F2A37" Width="80">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                <views:ItemsList ItemsSource="{Binding Areas}" Margin="0,8" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource AreaRailButton}" Command="{Binding ShowCommand}" CommandParameter="{Binding Area}"
                                    ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Name}"
                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Width="62">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsComingLater}" Value="True">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Grid HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" />
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="0,-3,-13,0"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#F2C14E"
                                                   Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </views:ItemsList>
            </ScrollViewer>
        </Border>

        <!-- ── Pages ──────────────────────────────────────────────── -->
        <Grid>
            <!-- ══ Dashboard ══════════════════════════════════════════ -->
            <ScrollViewer DataContext="{Binding Dashboard}" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Background="{StaticResource PageBackgroundBrush}"
                          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Dashboard}">
                <StackPanel Margin="24,18,24,24">
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="New quote"
                                Command="{Binding NewQuoteCommand}" />
                        <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                    </DockPanel>
                    <Border Padding="10" Margin="0,0,0,12" Background="{StaticResource ErrorBackgroundBrush}"
                            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                    </Border>

                    <!-- Get started: what a new company sets up first -->
                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,14"
                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                            Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Hide" Command="{Binding HideSetupCommand}"
                                        ToolTip="Hide this list (everything here is also in the menus)" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SetupProgressText}" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="Get started" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <views:ItemsList ItemsSource="{Binding SetupSteps}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{Binding ActionText}"
                                                        Command="{Binding Action}" VerticalAlignment="Center" />
                                                <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xEA3A;" />
                                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE930;" />
                                                                    <Setter Property="Foreground" Value="#2E9D63" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </views:ItemsList>
                        </StackPanel>
                    </Border>

                    <views:ItemsList ItemsSource="{Binding Tiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,14">
                                    <DockPanel>
                                        <Rectangle DockPanel.Dock="Left" Width="4" RadiusX="2" RadiusY="2" Margin="0,0,12,0"
                                                   Fill="{Binding Accent}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Count}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </views:ItemsList>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Quote value by status" Style="{StaticResource CardTitle}" />
                                <views:ItemsList ItemsSource="{Binding ValueByStatus}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                                <StackPanel Grid.Column="1">
                                                    <ProgressBar Height="12" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                                                 Foreground="{Binding Accent}" Background="#EEF0F3" BorderThickness="0" />
                                                    <TextBlock Text="{Binding Value}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </views:ItemsList>
                                <TextBlock Text="{Binding WinRateText}" Margin="0,12,0,0" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Recent quotes" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="No quotes saved yet. Create a quote, add the client and their designs, then Save."
                                           Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecentQuotes.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <views:ItemsList ItemsSource="{Binding RecentQuotes}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Open this quote">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="140" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Client}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Value}" TextAlignment="Right" Foreground="{StaticResource TextBrush}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </views:ItemsList>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Sales charts: by week or month; by person and city -->
                    <ContentControl Style="{StaticResource LockNotice}" Margin="0,16,0,0" MaxWidth="560" HorizontalAlignment="Left"
                                    Content="{Binding DataContext.Access.SalesChartsLock, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding DataContext.Access.CanSeeSalesCharts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                    <StackPanel DataContext="{Binding DataContext.SalesCharts, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding DataContext.Access.CanSeeSalesCharts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="16">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource FilterTab}" Content="By week" IsChecked="{Binding IsWeeks}" />
                                            <RadioButton Style="{StaticResource FilterTab}" Content="By month" IsChecked="{Binding IsMonths}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Enquiries, quotes, won and lost" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- Legend -->
                                    <views:ItemsList ItemsSource="{Binding Legend}" Margin="0,8,0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                    <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Color}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" Margin="5,0,0,0" FontSize="11" Foreground="#374151" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </views:ItemsList>
                                    <!-- Grouped bars per period, from a common baseline -->
                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,6,0,0">
                                        <views:ItemsList ItemsSource="{Binding Columns}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <views:ItemsList ItemsSource="{Binding Bars}" Height="124" HorizontalAlignment="Center" Background="Transparent">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="7" Height="{Binding Height}" Margin="1,0" CornerRadius="3,3,0,0" Background="{Binding Color}"
                                                                        VerticalAlignment="Bottom" ToolTip="{Binding ToolTip}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </views:ItemsList>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </views:ItemsList>
                                    </Border>
                                    <views:ItemsList ItemsSource="{Binding Columns}" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </views:ItemsList>

                                    <TextBlock Text="Value won" FontWeight="SemiBold" Foreground="#1F2A37" Margin="0,16,0,4" />
                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                        <views:ItemsList ItemsSource="{Binding Columns}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="124" Background="Transparent" ToolTip="{Binding ValueToolTip}">
                                                        <Border Width="16" Height="{Binding ValueHeight}" CornerRadius="3,3,0,0" Background="#2A78D6"
                                                                VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </views:ItemsList>
                                    </Border>
                                    <views:ItemsList ItemsSource="{Binding Columns}" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </views:ItemsList>

                                    <!-- The same numbers as a table -->
                                    <Expander Header="Show the numbers" Margin="0,12,0,0" Foreground="#374151">
                                        <ListView ItemsSource="{Binding Columns}" BorderThickness="0" Margin="0,6,0,0" MaxHeight="320">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Period" Width="170" DisplayMemberBinding="{Binding LongLabel}" />
                                                    <GridViewColumn Header="Enquiries" Width="75" DisplayMemberBinding="{Binding Counts[0]}" />
                                                    <GridViewColumn Header="Quotes" Width="65" DisplayMemberBinding="{Binding Counts[1]}" />
                                                    <GridViewColumn Header="Won" Width="55" DisplayMemberBinding="{Binding Counts[2]}" />
                                                    <GridViewColumn Header="Lost" Width="55" DisplayMemberBinding="{Binding Counts[3]}" />
                                                    <GridViewColumn Header="Value won" Width="110" DisplayMemberBinding="{Binding WonValueText}" />
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Expander>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Sales by person" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Quotes each person created in the period." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" />
                                        <ListView ItemsSource="{Binding People}" BorderThickness="0" MaxHeight="240">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Person" Width="120" DisplayMemberBinding="{Binding Name}" />
                                                    <GridViewColumn Header="Quotes" Width="55" DisplayMemberBinding="{Binding Quotes}" />
                                                    <GridViewColumn Header="Won" Width="45" DisplayMemberBinding="{Binding Won}" />
                                                    <GridViewColumn Header="Win rate" Width="65" DisplayMemberBinding="{Binding WinRate}" />
                                                    <GridViewColumn Header="Value won" Width="95" DisplayMemberBinding="{Binding WonValue}" />
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Sales by city" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="The client's city of quotes created in the period." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" />
                                        <ListView ItemsSource="{Binding Cities}" BorderThickness="0" MaxHeight="240">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="City" Width="140" DisplayMemberBinding="{Binding City}" />
                                                    <GridViewColumn Header="Quotes" Width="60" DisplayMemberBinding="{Binding Quotes}" />
                                                    <GridViewColumn Header="Won" Width="50" DisplayMemberBinding="{Binding Won}" />
                                                    <GridViewColumn Header="Value won" Width="110" DisplayMemberBinding="{Binding WonValue}" />
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Who did what: the latest changes to all quotes -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0"
                            Visibility="{Binding HasRecentActivity, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Recent activity" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Who created, saved or deleted which quote, and what changed." FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" />
                            <views:ItemsList ItemsSource="{Binding RecentActivity}" ItemTemplate="{StaticResource HistoryLine}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Quotes ═════════════════════════════════════════════ -->
            <DockPanel DataContext="{Binding Quotes}" Background="{StaticResource PageBackgroundBrush}"
                       Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Quotes}">
                <DockPanel DockPanel.Dock="Top" Margin="24,18,24,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="New quote"
                            Command="{Binding NewQuoteCommand}" />
                    <TextBlock Text="Quotes" Style="{StaticResource PageTitle}" />
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="24,0,24,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBox Width="240" Style="{StaticResource SearchBox}" Tag="Search quotes…" ToolTip="Search by quote number, project or client"
                                 AutomationProperties.Name="Search quotes" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource FilterTab}" Content="{Binding ActiveHeader}"
                                     IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Active}" />
                        <RadioButton Style="{StaticResource FilterTab}" Content="{Binding WonHeader}"
                                     IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Won}" />
                        <RadioButton Style="{StaticResource FilterTab}" Content="{Binding LostHeader}"
                                     IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Lost}" />
                        <RadioButton Style="{StaticResource FilterTab}" Content="{Binding AllHeader}"
                                     IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=All}" />
                    </StackPanel>
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="24,8,24,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="Delete" Command="{Binding DeleteCommand}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Open" Command="{Binding OpenCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding CountText}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                </DockPanel>
                <Border DockPanel.Dock="Top" Padding="10" Margin="24,0,24,10" CornerRadius="6"
                        Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#E8F6EE" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                </Border>
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,14" Margin="24,0,24,10"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                </Border>
                <Border Style="{StaticResource Card}" Margin="24,0,24,0" Padding="0">
                    <ListView ItemsSource="{Binding Quotes}" SelectedItem="{Binding SelectedQuote}" BorderThickness="0"
                              Background="Transparent">
                        <ListView.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}" />
                            <KeyBinding Key="Enter" Command="{Binding OpenCommand}" />
                        </ListView.InputBindings>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="4,6" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Quote no." Width="100" DisplayMemberBinding="{Binding Number}" />
                                <GridViewColumn Header="Project" Width="170" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Client" Width="150" DisplayMemberBinding="{Binding Client}" />
                                <GridViewColumn Header="Status" Width="70" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="Order" Width="85" DisplayMemberBinding="{Binding Order}" />
                                <GridViewColumn Header="Designs" Width="65" DisplayMemberBinding="{Binding Designs}" />
                                <GridViewColumn Header="Qty" Width="50" DisplayMemberBinding="{Binding Quantity}" />
                                <GridViewColumn Header="Area" Width="80" DisplayMemberBinding="{Binding Area}" />
                                <GridViewColumn Header="Value" Width="125" DisplayMemberBinding="{Binding Value}" />
                                <GridViewColumn Header="Saved by" Width="105">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ModifiedBy}" ToolTip="{Binding AuthorsText}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Last change" Width="120" DisplayMemberBinding="{Binding Modified}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </DockPanel>

            <!-- ══ Account: company, licence, products, package features, licence keys ══ -->
            <ScrollViewer DataContext="{Binding Account}" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Background="{StaticResource PageBackgroundBrush}"
                          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Account}">
                <StackPanel Margin="24,18,24,24" MaxWidth="1100">
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="Staff logins"
                                    Command="{Binding DataContext.ShowViewCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Staff"
                                    ToolTip="Give your staff their own sign-in, with only the parts of MARK they need"
                                    Visibility="{Binding DataContext.HasStaff, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Check now" Command="{Binding CheckNowCommand}"
                                    ToolTip="Ask the licence server for your current licence" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Sign out" Command="{Binding SignOutCommand}"
                                    ToolTip="Sign out of MARK on this computer (frees it for another computer)" />
                        </StackPanel>
                        <TextBlock Text="Account" Style="{StaticResource PageTitle}" />
                    </DockPanel>

                    <Border Padding="10" Margin="0,0,0,12" CornerRadius="6" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F6EE" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1D6B3A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <!-- Company and licence -->
                        <Border Style="{StaticResource Card}" Padding="20,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <Grid DockPanel.Dock="Left" Width="64" Height="64" Margin="0,0,16,0">
                                        <Border CornerRadius="8" Background="#E8EEF7"
                                                Visibility="{Binding DataContext.Access.HasLogo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock Text="&#xE731;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{Binding DataContext.Access.Logo, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="Uniform" />
                                    </Grid>
                                    <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,3" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E8F6EE" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1D6B3A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CompanyName}" FontSize="20" FontWeight="SemiBold" Foreground="#1F2A37" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding CompanyType}" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </DockPanel>
                                <Border Padding="10" Margin="0,0,0,12" CornerRadius="6" Background="#FFF8E6"
                                        Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#3F2A00" />
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Signed in as" Style="{StaticResource FormLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UserText}" Margin="0,4,0,3" Foreground="#1F2A37" />
                                    <TextBlock Grid.Row="1" Text="Package" Style="{StaticResource FormLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PackageName}" Margin="0,4,0,3" Foreground="#1F2A37" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Text="Licence valid until" Style="{StaticResource FormLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ValidUntilText}" Margin="0,4,0,3" Foreground="#1F2A37" />
                                    <TextBlock Grid.Row="3" Text="Computers" Style="{StaticResource FormLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ComputersText}" Margin="0,4,0,3" Foreground="#1F2A37" />
                                    <TextBlock Grid.Row="4" Text="Licence server" Style="{StaticResource FormLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ServerText}" Margin="0,4,0,3" Foreground="#1F2A37" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastCheckText}" Margin="0,4,0,3" FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Products and licence key -->
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Products" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                    <views:ItemsList ItemsSource="{Binding Products}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#C9CED6" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                                        <Setter Property="Fill" Value="#2F9E5B" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1F2A37" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </views:ItemsList>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="Licence key" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Enter a key from your MARK supplier to renew, or to add a product or feature." TextWrapping="Wrap"
                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Use key" Command="{Binding RedeemKeyCommand}" />
                                        <TextBox Style="{StaticResource FormBox}" Margin="0" FontFamily="Consolas" CharacterCasing="Upper"
                                                 Text="{Binding KeyText, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding RedeemKeyCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Package features by area -->
                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding FeaturesTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                            <views:ItemsList ItemsSource="{Binding FeatureGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,8,18,4">
                                            <TextBlock Text="{Binding Area}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}"
                                                       Margin="0,0,0,4" />
                                            <views:ItemsList ItemsSource="{Binding Features}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,3" ToolTip="{Binding Description}">
                                                            <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,2,8,0"
                                                                       VerticalAlignment="Top">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="&#xE72E;" />
                                                                        <Setter Property="Foreground" Value="#A0A7B1" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsIncluded}" Value="True">
                                                                                <Setter Property="Text" Value="&#xE73E;" />
                                                                                <Setter Property="Foreground" Value="#2F9E5B" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" Foreground="#1F2A37" />
                                                                <TextBlock Text="{Binding State}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </views:ItemsList>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </views:ItemsList>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Library: the company's systems and products; the Library Manager ══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Background="{StaticResource PageBackgroundBrush}"
                          Visibility="{Binding Page, Converter={StaticResource EnumToVisibility}, ConverterParameter=Library}">
                <StackPanel Margin="24,18,24,24" MaxWidth="1100">
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Open Library Manager"
                                Command="{Binding OpenLibraryManagerCommand}" />
                        <TextBlock Text="Library" Style="{StaticResource PageTitle}" />
                    </DockPanel>
                    <ContentControl Style="{StaticResource LockNotice}" Content="{Binding Access.LibraryLock}" Margin="0,0,0,12"
                                    MaxWidth="560" HorizontalAlignment="Left"
                                    Visibility="{Binding Access.CanUseLibrary, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding LibraryModeText}" TextWrapping="Wrap" Foreground="#1F2A37" />
                            <TextBlock Text="{Binding LibraryCountsText}" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="Systems" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                            <TextBlock Text="A window is made in a system: its profiles, glass, steel and hardware come from it." FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                            <views:ItemsList ItemsSource="{Binding LibrarySystems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0F2F5" BorderThickness="0,1,0,0" Padding="0,7">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1F2A37" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </views:ItemsList>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ An area still to come (Orders, Purchasing, Inventory, Accounts): what it will do ══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Background="{StaticResource PageBackgroundBrush}"
                          Visibility="{Binding Page, Converter={StaticResource EnumToVisibility}, ConverterParameter=Overview}">
                <StackPanel Margin="24,18,24,24" MaxWidth="900" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding AreaInfo.Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding AreaInfo.Name}" Style="{StaticResource PageTitle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AreaInfo.Description}" Foreground="#4B5563" Margin="0,0,0,14" />
                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="Coming in a later version of MARK" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="This area is being built. When it is released it opens here, for everyone whose package includes it."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8" />
                            <views:ItemsList ItemsSource="{Binding OverviewFeatures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0F2F5" BorderThickness="0,1,0,0" Padding="0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1F2A37" />
                                                <TextBlock Text="{Binding Description}" Foreground="#4B5563" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding State}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </views:ItemsList>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Staff: logins for the company's people (the account owner only) ══ -->
            <ScrollViewer x:Name="StaffPage" DataContext="{Binding Staff}" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Background="{StaticResource PageBackgroundBrush}"
                          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Staff}">
                <StackPanel Margin="24,18,24,24" MaxWidth="1150">
                    <DockPanel Margin="0,0,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Add staff login" Command="{Binding AddCommand}" />
                        </StackPanel>
                        <TextBlock Text="Staff logins" Style="{StaticResource PageTitle}" />
                    </DockPanel>
                    <TextBlock Text="{Binding UsersText}" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"
                               Text="Give each person their own User ID and password, and only the parts of MARK they need: a cutter can see only Production, a salesperson Sales, Design and Pricing. Changes reach their MARK at its next check-in, or when they sign in." />

                    <Border Padding="10" Margin="0,0,0,12" CornerRadius="6" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F6EE" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1D6B3A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="6*" />
                        </Grid.ColumnDefinitions>

                        <!-- The staff logins -->
                        <Border Style="{StaticResource Card}" Padding="16,12" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="No staff logins yet. Add one for each person who works in MARK." TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,4"
                                           Visibility="{Binding HasStaff, Converter={StaticResource InverseBoolToVisibility}}" />
                                <views:ItemsList ItemsSource="{Binding Staff}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Command="{Binding DataContext.EditCommand, ElementName=StaffPage}"
                                                    CommandParameter="{Binding}" ToolTip="Change this login" AutomationProperties.Name="{Binding Name}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="#E8EEF7" Margin="0,0,12,0">
                                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel>
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.55" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Foreground="#1F2A37"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding UserId, Mode=OneWay}" Foreground="#6B7280" /></TextBlock>
                                                        <TextBlock Text="{Binding AreasText}" Foreground="#374151" />
                                                        <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </views:ItemsList>
                            </StackPanel>
                        </Border>

                        <!-- The login being added or changed -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16" VerticalAlignment="Top" DataContext="{Binding Editor}"
                                Visibility="{Binding DataContext.HasEditor, ElementName=StaffPage, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Name *" Style="{StaticResource FormLabel}" />
                                        <TextBox Style="{StaticResource FormBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="User ID *" Style="{StaticResource FormLabel}" />
                                        <TextBox Style="{StaticResource FormBox}" Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding PasswordLabel}" Style="{StaticResource FormLabel}" />
                                <TextBox Style="{StaticResource FormBox}" FontFamily="Consolas" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="At least 6 characters. Tell the person their User ID and password." />
                                <CheckBox Content="Turned off (cannot sign in, does not count towards your logins)" IsChecked="{Binding IsDisabled}"
                                          Margin="0,0,0,10" Foreground="#374151" />

                                <TextBlock Text="What this person may use" FontWeight="SemiBold" Foreground="#1F2A37" Margin="0,4,0,2" />
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Quick choice:" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,2,0" />
                                    <views:ItemsList ItemsSource="{Binding DataContext.Presets, ElementName=StaffPage}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SecondaryButton}" Content="{Binding Name}" ToolTip="{Binding Description}"
                                                        Padding="10,3" Margin="6,2,0,2" AutomationProperties.Name="{Binding Name, StringFormat=Quick choice {0}}"
                                                        Command="{Binding DataContext.PresetCommand, ElementName=StaffPage}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </views:ItemsList>
                                </DockPanel>
                                <views:ItemsList ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemWidth="275" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,6,12,4">
                                                <TextBlock Text="{Binding Area}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}" Margin="0,0,0,2" />
                                                <views:ItemsList ItemsSource="{Binding Features}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" ToolTip="{Binding Description}"
                                                                      Margin="0,2" Foreground="#1F2A37" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </views:ItemsList>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </views:ItemsList>

                                <DockPanel Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="Remove login" Margin="0"
                                            Command="{Binding DataContext.DeleteCommand, ElementName=StaffPage}"
                                            Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding DataContext.CancelCommand, ElementName=StaffPage}" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="Save login" Command="{Binding DataContext.SaveCommand, ElementName=StaffPage}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ Enquiries: the list, and the two-step form ══ -->
            <Grid x:Name="EnquiriesPage" DataContext="{Binding Enquiries}" Background="{StaticResource PageBackgroundBrush}"
                  Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Enquiries}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="24,18,24,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="New enquiry" Command="{Binding NewCommand}" />
                        <StackPanel>
                            <TextBlock Text="Enquiries" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{Binding DueText}" Foreground="#B7791F" FontWeight="SemiBold" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="24,0,24,8">
                        <TextBox DockPanel.Dock="Right" Width="240" Style="{StaticResource SearchBox}" Tag="Search enquiries…"
                                 ToolTip="Search by number, client, city, phone, source, salesperson or quote" AutomationProperties.Name="Search enquiries"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource FilterTab}" Content="{Binding OpenHeader}"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Open}" />
                            <RadioButton Style="{StaticResource FilterTab}" Content="{Binding QuotedHeader}"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Quoted}" />
                            <RadioButton Style="{StaticResource FilterTab}" Content="{Binding WonHeader}"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Won}" />
                            <RadioButton Style="{StaticResource FilterTab}" Content="{Binding LostHeader}"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Lost}" />
                            <RadioButton Style="{StaticResource FilterTab}" Content="{Binding AllHeader}"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=All}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="24,8,24,16" Text="{Binding Message}" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <Border Style="{StaticResource Card}" Margin="24,0,24,0" Padding="0">
                        <ListView ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="4,6" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Number}" />
                                    <EventSetter Event="MouseDoubleClick" Handler="EnquiryRow_DoubleClick" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Enquiry" Width="90" DisplayMemberBinding="{Binding Number}" />
                                    <GridViewColumn Header="Client" Width="160" DisplayMemberBinding="{Binding Client}" />
                                    <GridViewColumn Header="City" Width="90" DisplayMemberBinding="{Binding City}" />
                                    <GridViewColumn Header="Phone" Width="105" DisplayMemberBinding="{Binding Phone}" />
                                    <GridViewColumn Header="Stage" Width="80" DisplayMemberBinding="{Binding Stage}" />
                                    <GridViewColumn Header="Source" Width="85" DisplayMemberBinding="{Binding Source}" />
                                    <GridViewColumn Header="Salesperson" Width="100" DisplayMemberBinding="{Binding Owner}" />
                                    <GridViewColumn Header="Expected value" Width="105">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Value}" TextAlignment="Right" MinWidth="90" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Follow-up" Width="95">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FollowUp}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDue}" Value="True">
                                                                    <Setter Property="Foreground" Value="#B45309" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Quote" Width="90" DisplayMemberBinding="{Binding Quote}" />
                                    <GridViewColumn Header="" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Open" Padding="10,2" Margin="0"
                                                        Command="{Binding DataContext.EditCommand, ElementName=EnquiriesPage}" CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Number, StringFormat=Open {0}}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </DockPanel>

                <!-- The form: step 1 client and site, step 2 the enquiry -->
                <Border Grid.Column="1" Width="460" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                        DataContext="{Binding Editor}" Visibility="{Binding DataContext.HasEditor, ElementName=EnquiriesPage, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="20,16,20,8">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding StepText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="Delete" Margin="0"
                                        Command="{Binding DataContext.DeleteCommand, ElementName=EnquiriesPage}"
                                        Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding DataContext.CancelCommand, ElementName=EnquiriesPage}" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Back" Command="{Binding DataContext.BackCommand, ElementName=EnquiriesPage}"
                                            Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Next" Command="{Binding DataContext.NextCommand, ElementName=EnquiriesPage}"
                                            Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Save enquiry" Command="{Binding DataContext.SaveCommand, ElementName=EnquiriesPage}"
                                            Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Create quote" Command="{Binding DataContext.CreateQuoteCommand, ElementName=EnquiriesPage}"
                                            ToolTip="Save the enquiry and start a quote with its client, site and requirements"
                                            Visibility="{Binding CanCreateQuote, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Bottom" Margin="20,0,20,8" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}"
                                   Text="{Binding DataContext.Message, ElementName=EnquiriesPage}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel Margin="20,0,20,12">
                                <!-- Step 1: client and site -->
                                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Title" Style="{StaticResource FormLabel}" />
                                            <ComboBox IsEditable="True" Padding="6,4" Margin="0,0,0,8" ItemsSource="{x:Static vm:EnquiryEditorViewModel.Titles}"
                                                      Text="{Binding ClientTitle, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="First name" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Last name" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Company" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Phone *" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="E-mail" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="SITE ADDRESS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}" Margin="0,8,0,2" />
                                    <TextBlock Text="Address 1" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Address 2" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="City" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="State" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="PIN code" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Step 2: the enquiry -->
                                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Stage" Style="{StaticResource FormLabel}" />
                                            <ComboBox Padding="6,4" Margin="0,0,0,8" ItemsSource="{x:Static vm:EnquiryEditorViewModel.Stages}" SelectedItem="{Binding Stage}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Source" Style="{StaticResource FormLabel}" />
                                            <ComboBox IsEditable="True" Padding="6,4" Margin="0,0,0,8" ItemsSource="{x:Static vm:EnquiryEditorViewModel.Sources}"
                                                      Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Salesperson" Style="{StaticResource FormLabel}" />
                                            <ComboBox IsEditable="True" Padding="6,4" Margin="0,0,0,8"
                                                      ItemsSource="{Binding DataContext.Owners, ElementName=EnquiriesPage}"
                                                      Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Expected value" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding ExpectedValue, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Follow up on" Style="{StaticResource FormLabel}" />
                                            <DatePicker SelectedDate="{Binding FollowUp}" Margin="0,0,0,8" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Expected decision" Style="{StaticResource FormLabel}" />
                                            <DatePicker SelectedDate="{Binding ExpectedClose}" Margin="0,0,0,8" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Requirements" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" MinHeight="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                             Text="{Binding Requirements, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Rooms, window types, glass, colour, budget, timing, site conditions" />
                                    <StackPanel Visibility="{Binding IsLost, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Why it was lost" Style="{StaticResource FormLabel}" />
                                        <TextBox Style="{StaticResource FormBox}" Text="{Binding LostReason, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Open its quote" Margin="0,6,0,0" HorizontalAlignment="Left"
                                            Command="{Binding DataContext.OpenQuoteCommand, ElementName=EnquiriesPage}"
                                            Visibility="{Binding HasQuote, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ══ Production orders (Milestone 16) ════════════════════ -->
            <Grid x:Name="ProductionPage" DataContext="{Binding Production}" Background="{StaticResource PageBackgroundBrush}"
                  Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=ProductionOrders}">
                <ContentControl Style="{StaticResource LockNotice}" Margin="24,18,24,0" VerticalAlignment="Top"
                                Content="{Binding DataContext.Access.ProductionOrdersLock, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding DataContext.Access.CanUseProductionOrders, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                <Grid Visibility="{Binding DataContext.Access.CanUseProductionOrders, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Side panel: start one, and every production order -->
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="20,18,20,10">
                                <TextBlock Text="Production orders" Style="{StaticResource PageTitle}" HorizontalAlignment="Left" />
                                <TextBlock Text="The workshop's jobs: one for each confirmed order, with its papers and the progress of every window."
                                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,12" />
                                <Border Background="#F7FAFF" BorderBrush="#D5E2F5" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="START PRODUCTION OF AN ORDER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}"
                                                   Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding AvailableOrders}" SelectedItem="{Binding NewFrom}" Padding="6,4"
                                                  Visibility="{Binding HasAvailableOrders, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="Every order is in production. Convert a won quote to an order (Sales › its header) to start another."
                                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                                   Visibility="{Binding HasAvailableOrders, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="Start production" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                Command="{Binding CreateCommand}"
                                                Visibility="{Binding HasAvailableOrders, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="No production orders yet." Margin="20,6" Foreground="{StaticResource MutedTextBrush}"
                                       Visibility="{Binding HasOrders, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ListBox ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="8,0,8,8">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding OrderNumber}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Grid Margin="0,2">
                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,9">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,9" CornerRadius="2"
                                                                Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#F3F6FA" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#EAF2FD" />
                                                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Height="4" Margin="0,6,0,2" BorderThickness="0"
                                                         Background="#E5E9EF" Foreground="#2E9D63" />
                                            <TextBlock Text="{Binding StageText}" FontSize="11" Foreground="#1D6B3A" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- The chosen production order -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="26,18,26,26" MaxWidth="1120">
                            <Border Padding="10" Margin="0,0,0,12" CornerRadius="6" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E8F6EE" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                            </Border>

                            <TextBlock Text="Choose a production order on the left, or start one from an order." Margin="0,40,0,0" HorizontalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}" Visibility="{Binding HasOrder, Converter={StaticResource InverseBoolToVisibility}}" />

                            <StackPanel Visibility="{Binding HasOrder, Converter={StaticResource BoolToVisibility}}">
                                <!-- Header -->
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Delete" Foreground="#A32020" VerticalAlignment="Top"
                                            Command="{Binding DeleteCommand}" ToolTip="Delete this production order and its progress (the order stays)" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding OrderTitle}" FontSize="20" FontWeight="SemiBold" Foreground="#1F2A37" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding OrderDetail}" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Stage, due date, notes -->
                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="1.4*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding StageText}" FontWeight="SemiBold" FontSize="14" Foreground="#1D6B3A" />
                                            </DockPanel>
                                            <ProgressBar Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Height="8" Margin="0,8,0,0" BorderThickness="0"
                                                         Background="#E5E9EF" Foreground="#2E9D63" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Due" Style="{StaticResource FormLabel}" />
                                            <DatePicker SelectedDate="{Binding DueDate}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Notes for the workshop" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Margin="0" MinHeight="42" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                                     Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Papers -->
                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Workshop papers" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Each is made as a PDF from the designs as they were when production started, and opened for printing."
                                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,10" />
                                        <WrapPanel>
                                            <Button Style="{StaticResource PrimaryButton}" Content="Cutting list" Margin="0,0,8,6" Command="{Binding PaperCommand}" CommandParameter="CuttingList"
                                                    ToolTip="Profiles and steel, bar by bar, with each piece's label number" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="Glass order" Margin="0,0,8,6" Command="{Binding PaperCommand}" CommandParameter="GlassOrder"
                                                    ToolTip="Glass sizes and quantities for the glass supplier" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="Hardware pick list" Margin="0,0,8,6" Command="{Binding PaperCommand}" CommandParameter="HardwarePickList"
                                                    ToolTip="Hardware and accessories to take from the store" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="Shop drawings" Margin="0,0,8,6" Command="{Binding PaperCommand}" CommandParameter="ShopDrawings"
                                                    ToolTip="A page per window with its drawing, pieces, glass and hardware" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="Piece labels" Margin="0,0,8,6" Command="{Binding PaperCommand}" CommandParameter="Labels"
                                                    ToolTip="A label for every piece and glass pane (3 × 7 on an A4 sheet)" />
                                        </WrapPanel>
                                        <Border BorderBrush="#EEF0F3" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,10,0,0">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Update offcuts…" VerticalAlignment="Center"
                                                        Command="{Binding UpdateOffcutsCommand}"
                                                        ToolTip="After cutting: take the offcuts used out of stock and put this order's new offcuts in (once)" />
                                                <StackPanel>
                                                    <CheckBox Content="Cut from offcuts in stock first" IsChecked="{Binding UseOffcuts}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding OffcutsText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                                               Margin="22,2,12,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Progress per window -->
                                <Border Style="{StaticResource Card}" Padding="18,14">
                                    <StackPanel>
                                        <TextBlock Text="Progress" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Click a step to mark it done for all of a design's windows (again to undo); − and + count one window. The buttons above each column mark every window."
                                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,10" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="WINDOW" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="3,0" Padding="4,3" Content="All cut" FontSize="11"
                                                    Command="{Binding MarkAllCommand}" CommandParameter="Cut" />
                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="3,0" Padding="4,3" Content="All assembled" FontSize="11"
                                                    Command="{Binding MarkAllCommand}" CommandParameter="Assembled" />
                                            <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Margin="3,0" Padding="4,3" Content="All glazed" FontSize="11"
                                                    Command="{Binding MarkAllCommand}" CommandParameter="Glazed" />
                                            <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Margin="3,0" Padding="4,3" Content="All ready" FontSize="11"
                                                    Command="{Binding MarkAllCommand}" CommandParameter="Ready" />
                                            <Button Grid.Column="5" Style="{StaticResource SecondaryButton}" Margin="3,0" Padding="4,3" Content="All dispatched" FontSize="11"
                                                    Command="{Binding MarkAllCommand}" CommandParameter="Dispatched" />
                                        </Grid>
                                        <views:ItemsList ItemsSource="{Binding Windows}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#EEF0F3" BorderThickness="0,1,0,0" Padding="0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2.2*" />
                                                                <ColumnDefinition Width="5*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">
                                                                    <Run Text="{Binding Reference, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Name, Mode=OneWay}" FontWeight="Normal" />
                                                                </TextBlock>
                                                                <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}">
                                                                    <Run Text="{Binding SizeText, Mode=OneWay}" /><Run Text=" mm  ·  " /><Run Text="{Binding Quantity, Mode=OneWay}" /><Run Text=" pcs" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <views:ItemsList Grid.Column="1" ItemsSource="{Binding Steps}" Focusable="False">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Rows="1" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <DockPanel Margin="3,0">
                                                                            <Button DockPanel.Dock="Left" Content="−" Width="20" Padding="0" Margin="0,0,2,0" Command="{Binding LessCommand}"
                                                                                    Visibility="{Binding HasCounts, Converter={StaticResource BoolToVisibility}}"
                                                                                    AutomationProperties.Name="{Binding Name, StringFormat=One less {0}}" />
                                                                            <Button DockPanel.Dock="Right" Content="+" Width="20" Padding="0" Margin="2,0,0,0" Command="{Binding MoreCommand}"
                                                                                    Visibility="{Binding HasCounts, Converter={StaticResource BoolToVisibility}}"
                                                                                    AutomationProperties.Name="{Binding Name, StringFormat=One more {0}}" />
                                                                            <Button Command="{Binding ToggleCommand}" Cursor="Hand" ToolTip="{Binding Name}"
                                                                                    AutomationProperties.Name="{Binding Name}">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border x:Name="Pill" CornerRadius="12" Padding="6,4" Background="#F1F3F6" BorderBrush="#E1E5EB" BorderThickness="1">
                                                                                            <TextBlock x:Name="Label" Text="{Binding Text}" HorizontalAlignment="Center" FontWeight="SemiBold"
                                                                                                       Foreground="{StaticResource MutedTextBrush}" />
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsStarted}" Value="True">
                                                                                                <Setter TargetName="Pill" Property="Background" Value="#FFF4D6" />
                                                                                                <Setter TargetName="Pill" Property="BorderBrush" Value="#F2D9A0" />
                                                                                                <Setter TargetName="Label" Property="Foreground" Value="#8A5A00" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                                                                <Setter TargetName="Pill" Property="Background" Value="#E3F4EA" />
                                                                                                <Setter TargetName="Pill" Property="BorderBrush" Value="#A9DBBE" />
                                                                                                <Setter TargetName="Label" Property="Foreground" Value="#1D6B3A" />
                                                                                            </DataTrigger>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                            </Button>
                                                                        </DockPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </views:ItemsList>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </views:ItemsList>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ══ Orders (Milestone 17) ═══════════════════════════════ -->
            <Grid x:Name="OrdersPage" DataContext="{Binding OrderBook}" Background="{StaticResource PageBackgroundBrush}"
                  Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Orders}">
                <ContentControl Style="{StaticResource LockNotice}" Margin="24,18,24,0" VerticalAlignment="Top"
                                Content="{Binding DataContext.Access.OrdersLock, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding DataContext.Access.CanManageOrders, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                <Grid Visibility="{Binding DataContext.Access.CanManageOrders, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Side panel: every order -->
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="20,18,20,10">
                                <TextBlock Text="Orders" Style="{StaticResource PageTitle}" HorizontalAlignment="Left" />
                                <TextBlock Text="Every order from confirmation to installation: payments, dispatch and sign-off. A quote becomes an order with Convert to order."
                                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,12" />
                                <Grid Margin="0,0,0,6">
                                    <TextBox x:Name="OrderSearchBox" Padding="26,6,6,6" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Search orders" />
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                               Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <TextBlock Text="Search order, client, stage…" Foreground="{StaticResource MutedTextBrush}" Margin="28,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=OrderSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ListSummary}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <ComboBox ItemsSource="{x:Static vm:OrdersViewModel.Filters}" SelectedItem="{Binding Filter}" Padding="6,4"
                                              AutomationProperties.Name="Show" />
                                </DockPanel>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="No orders here. Convert a won quote to an order (the quote's header in Sales or Design)."
                                       TextWrapping="Wrap" Margin="20,6" Foreground="{StaticResource MutedTextBrush}"
                                       Visibility="{Binding HasOrders, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ListBox ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="8,0,8,8">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding OrderNumber}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Grid Margin="0,2">
                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,9">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,9" CornerRadius="2"
                                                                Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#F3F6FA" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#EAF2FD" />
                                                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" CornerRadius="9" Padding="7,1" Background="#EEF2F7">
                                                    <TextBlock Text="{Binding StageText}" FontSize="10" FontWeight="SemiBold" Foreground="#374151" />
                                                </Border>
                                                <TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Value="{Binding PaidFraction, Mode=OneWay}" Maximum="1" Height="4" Margin="0,6,0,2" BorderThickness="0"
                                                         Background="#E5E9EF" Foreground="#2E9D63" ToolTip="Received of the order's value" />
                                            <TextBlock Text="{Binding PaidText}" FontSize="11" Foreground="#1D6B3A" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- The chosen order -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="26,18,26,26" MaxWidth="1120">
                            <Border Padding="10" Margin="0,0,0,12" CornerRadius="6" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E8F6EE" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="Choose an order on the left." Foreground="{StaticResource MutedTextBrush}" Margin="0,8"
                                       Visibility="{Binding HasOrder, Converter={StaticResource InverseBoolToVisibility}}" />

                            <StackPanel Visibility="{Binding HasOrder, Converter={StaticResource BoolToVisibility}}">
                                <!-- Header: order, client, site, money -->
                                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="300" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,20,0">
                                            <TextBlock Text="{Binding OrderTitle}" FontSize="19" FontWeight="SemiBold" Foreground="#1F2A37" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding OrderDetail}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
                                                <Run Text="Site: " Foreground="{StaticResource MutedTextBrush}" /><Run Text="{Binding SiteText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding ProductionText}" Foreground="#1D6B3A" Margin="0,6,0,0" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button Style="{StaticResource SecondaryButton}" Content="Open quote" Margin="0,0,6,0" Command="{Binding OpenQuoteCommand}"
                                                        ToolTip="Open the order's quote (client, designs and prices) in Sales" />
                                                <Button Style="{StaticResource SecondaryButton}" Content="Production" Command="{Binding OpenProductionCommand}"
                                                        ToolTip="Open (or start) the order's production order"
                                                        Visibility="{Binding DataContext.Access.CanUseProductionOrders, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#F7FAFF" BorderBrush="#D5E2F5" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontWeight="SemiBold" />
                                                    <TextBlock Text="Order value" Foreground="{StaticResource MutedTextBrush}" />
                                                </DockPanel>
                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PaidText}" FontWeight="SemiBold" Foreground="#1D6B3A" />
                                                    <TextBlock Text="Received" Foreground="{StaticResource MutedTextBrush}" />
                                                </DockPanel>
                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding BalanceText}" FontSize="15" FontWeight="SemiBold" Foreground="#1F2A37" />
                                                    <TextBlock Text="Balance" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <ProgressBar Value="{Binding PaidFraction, Mode=OneWay}" Maximum="1" Height="6" Margin="0,8,0,2" BorderThickness="0"
                                                             Background="#E5E9EF" Foreground="#2E9D63" />
                                                <TextBlock Text="{Binding PaidPercentText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="4" Background="#FFF8E6"
                                                        Visibility="{Binding HasCredit, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding CreditText}" TextWrapping="Wrap" FontSize="11" Foreground="#7A4A00" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Stage -->
                                <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="STAGE" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                        <views:ItemsList ItemsSource="{Binding StageSteps}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,6,0" Padding="8,8" Cursor="Hand" BorderThickness="1"
                                                            Command="{Binding DataContext.SetStageCommand, ElementName=OrdersPage}" CommandParameter="{Binding Stage}"
                                                            AutomationProperties.Name="{Binding Name}" ToolTip="Set the order to this stage">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="White" />
                                                                <Setter Property="BorderBrush" Value="#D5DAE1" />
                                                                <Setter Property="Foreground" Value="#4B5563" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                        <Setter Property="Background" Value="#E8F6EE" />
                                                                        <Setter Property="BorderBrush" Value="#B7E1C6" />
                                                                        <Setter Property="Foreground" Value="#1D6B3A" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Background" Value="#2E9D63" />
                                                                        <Setter Property="BorderBrush" Value="#2E9D63" />
                                                                        <Setter Property="Foreground" Value="White" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding DateText}" FontSize="10" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </views:ItemsList>
                                        <TextBlock Text="Production, a dispatch note for the last windows and the sign-off move the stage on by themselves; click a stage to set it by hand."
                                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Payments -->
                                    <Border Style="{StaticResource Card}" Padding="18,14">
                                        <StackPanel>
                                            <TextBlock Text="PAYMENTS" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                            <TextBlock Text="No payments recorded yet." Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"
                                                       Visibility="{Binding Payments.Count, Converter={StaticResource CountToCollapsed}}" />
                                            <views:ItemsList ItemsSource="{Binding Payments}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="0,5">
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="24" Height="24"
                                                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0" ToolTip="Remove this payment"
                                                                        AutomationProperties.Name="Remove payment"
                                                                        Command="{Binding DataContext.RemovePaymentCommand, ElementName=OrdersPage}" CommandParameter="{Binding}" />
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <StackPanel>
                                                                    <TextBlock>
                                                                        <Run Text="{Binding DateText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding KindText, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}">
                                                                        <Run Text="{Binding MethodText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Reference, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding RecordedBy, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </views:ItemsList>
                                            <TextBlock Text="RECORD A PAYMENT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}" Margin="0,12,0,4" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Amount" Style="{StaticResource FormLabel}" />
                                                <TextBox Grid.Row="1" Style="{StaticResource FormBox}" Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Amount" />
                                                <TextBlock Grid.Column="2" Text="Received on" Style="{StaticResource FormLabel}" />
                                                <DatePicker Grid.Row="1" Grid.Column="2" SelectedDate="{Binding PaymentDate}" Margin="0,0,0,8" AutomationProperties.Name="Received on" />
                                                <TextBlock Grid.Row="2" Text="For" Style="{StaticResource FormLabel}" />
                                                <ComboBox Grid.Row="3" ItemsSource="{x:Static vm:OrdersViewModel.PaymentKinds}" DisplayMemberPath="Name" SelectedValuePath="Value"
                                                          SelectedValue="{Binding PaymentKind}" Padding="6,4" Margin="0,0,0,8" AutomationProperties.Name="Payment for" />
                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Paid by" Style="{StaticResource FormLabel}" />
                                                <ComboBox Grid.Row="3" Grid.Column="2" ItemsSource="{x:Static vm:OrdersViewModel.PaymentMethods}" DisplayMemberPath="Name"
                                                          SelectedValuePath="Value" SelectedValue="{Binding PaymentMethod}" Padding="6,4" Margin="0,0,0,8"
                                                          AutomationProperties.Name="Paid by" />
                                            </Grid>
                                            <TextBlock Text="Reference (cheque no., transaction id)" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding PaymentReference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Reference" />
                                            <Button Style="{StaticResource PrimaryButton}" Content="Record payment" Margin="0,2,0,0" HorizontalAlignment="Left"
                                                    Command="{Binding AddPaymentCommand}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Schedule -->
                                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
                                        <StackPanel>
                                            <TextBlock Text="DELIVERY AND INSTALLATION" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                            <TextBlock Text="Nothing planned yet." Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"
                                                       Visibility="{Binding Visits.Count, Converter={StaticResource CountToCollapsed}}" />
                                            <views:ItemsList ItemsSource="{Binding Visits}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="0,5">
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="24" Height="24"
                                                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0" ToolTip="Remove from the schedule"
                                                                        AutomationProperties.Name="Remove visit"
                                                                        Command="{Binding DataContext.RemoveVisitCommand, ElementName=OrdersPage}" CommandParameter="{Binding}" />
                                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Done, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                          ToolTip="Done" AutomationProperties.Name="Done"
                                                                          Command="{Binding DataContext.ToggleVisitCommand, ElementName=OrdersPage}" CommandParameter="{Binding}" />
                                                                <StackPanel>
                                                                    <TextBlock>
                                                                        <Run Text="{Binding DateText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Time, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding KindText, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap">
                                                                        <Run Text="{Binding Team, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Note, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                    <TextBlock Text="Overdue" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}"
                                                                               Visibility="{Binding IsLate, Converter={StaticResource BoolToVisibility}}" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </views:ItemsList>
                                            <TextBlock Text="PLAN A VISIT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}" Margin="0,12,0,4" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="What" Style="{StaticResource FormLabel}" />
                                                <ComboBox Grid.Row="1" ItemsSource="{x:Static vm:OrdersViewModel.VisitKinds}" DisplayMemberPath="Name" SelectedValuePath="Value"
                                                          SelectedValue="{Binding VisitKind}" Padding="6,4" Margin="0,0,0,8" AutomationProperties.Name="Visit" />
                                                <TextBlock Grid.Column="2" Text="Day" Style="{StaticResource FormLabel}" />
                                                <DatePicker Grid.Row="1" Grid.Column="2" SelectedDate="{Binding VisitDate}" Margin="0,0,0,8" AutomationProperties.Name="Day" />
                                                <TextBlock Grid.Row="2" Text="Time" Style="{StaticResource FormLabel}" />
                                                <TextBox Grid.Row="3" Style="{StaticResource FormBox}" Text="{Binding VisitTime, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Time" ToolTip="e.g. 10:30 or morning" />
                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Team" Style="{StaticResource FormLabel}" />
                                                <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource FormBox}" Text="{Binding VisitTeam, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Team" />
                                            </Grid>
                                            <TextBlock Text="Note" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding VisitNote, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Visit note" />
                                            <Button Style="{StaticResource PrimaryButton}" Content="Add to schedule" Margin="0,2,0,0" HorizontalAlignment="Left"
                                                    Command="{Binding AddVisitCommand}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Dispatch -->
                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="DISPATCH" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                        <views:ItemsList ItemsSource="{Binding Dispatches}" Margin="0,0,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="0,5">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="24" Height="24"
                                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0" ToolTip="Remove this dispatch note"
                                                                    AutomationProperties.Name="Remove dispatch note"
                                                                    Command="{Binding DataContext.RemoveDispatchCommand, ElementName=OrdersPage}" CommandParameter="{Binding}" />
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="PDF…" Padding="10,3"
                                                                    Command="{Binding DataContext.DispatchPdfCommand, ElementName=OrdersPage}" CommandParameter="{Binding}"
                                                                    ToolTip="Print this dispatch note again" />
                                                            <TextBlock VerticalAlignment="Center">
                                                                <Run Text="{Binding Number, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding DateText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="#6B7280" />
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </views:ItemsList>
                                        <TextBlock Text="NEW DISPATCH NOTE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}" Margin="0,8,0,4" />
                                        <TextBlock Text="Every window of this order has been dispatched." Foreground="#1D6B3A" Margin="0,0,0,6"
                                                   Visibility="{Binding HasDispatchLeft, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Ref." FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="Design" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="2" Text="Size" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="3" Text="So far" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="4" Text="Goes now" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        </Grid>
                                        <views:ItemsList ItemsSource="{Binding DispatchLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="80" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Description}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="4" Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" TextAlignment="Right"
                                                                 AutomationProperties.Name="{Binding Reference, StringFormat=How many of {0} go}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </views:ItemsList>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Day" Style="{StaticResource FormLabel}" />
                                            <DatePicker Grid.Row="1" SelectedDate="{Binding DispatchDate}" Margin="0,0,0,8" AutomationProperties.Name="Dispatch day" />
                                            <TextBlock Grid.Column="2" Text="Vehicle" Style="{StaticResource FormLabel}" />
                                            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource FormBox}" Text="{Binding Vehicle, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Vehicle" ToolTip="e.g. RJ14 GA 1234" />
                                            <TextBlock Grid.Column="4" Text="Driver" Style="{StaticResource FormLabel}" />
                                            <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource FormBox}" Text="{Binding Driver, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Driver" />
                                        </Grid>
                                        <TextBlock Text="Note" Style="{StaticResource FormLabel}" />
                                        <TextBox Style="{StaticResource FormBox}" Text="{Binding DispatchNoteText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dispatch note text" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="Make dispatch note (PDF)…" Margin="0,2,0,0" HorizontalAlignment="Left"
                                                Command="{Binding CreateDispatchCommand}" ToolTip="Saves the dispatch note (DN-…) and makes its PDF to print and sign" />
                                    </StackPanel>
                                </Border>

                                <!-- Installation sign-off -->
                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="INSTALLATION SIGN-OFF" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding SignOffText}" Margin="0,0,0,8" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSignOff}" Value="True">
                                                            <Setter Property="Foreground" Value="#1D6B3A" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Day" Style="{StaticResource FormLabel}" />
                                            <DatePicker Grid.Row="1" SelectedDate="{Binding SignOffDate}" Margin="0,0,0,8" AutomationProperties.Name="Sign-off day" />
                                            <TextBlock Grid.Column="2" Text="Signed by (client)" Style="{StaticResource FormLabel}" />
                                            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource FormBox}" Text="{Binding SignedBy, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Signed by" />
                                            <TextBlock Grid.Column="4" Text="Installed by" Style="{StaticResource FormLabel}" />
                                            <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource FormBox}" Text="{Binding InstalledBy, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Installed by" />
                                        </Grid>
                                        <TextBlock Text="Remarks (snags, pending work)" Style="{StaticResource FormLabel}" />
                                        <TextBox Style="{StaticResource FormBox}" Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"
                                                 MinHeight="44" AutomationProperties.Name="Remarks" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="Record sign-off" Margin="0,0,6,0" Command="{Binding SaveSignOffCommand}"
                                                    ToolTip="The client accepts the installation; the order is Installed" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="Installation certificate (PDF)…" Command="{Binding CertificateCommand}"
                                                    ToolTip="The certificate for the client to sign" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Notes -->
                                <Border Style="{StaticResource Card}" Padding="18,14">
                                    <StackPanel>
                                        <TextBlock Text="NOTES" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Padding="6,4"
                                                 AutomationProperties.Name="Order notes" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ══ Schedule of deliveries and installations (Milestone 17) ══ -->
            <Grid DataContext="{Binding OrderBook}" Background="{StaticResource PageBackgroundBrush}"
                  Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Schedule}">
                <ContentControl Style="{StaticResource LockNotice}" Margin="24,18,24,0" VerticalAlignment="Top"
                                Content="{Binding DataContext.Access.OrdersLock, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding DataContext.Access.CanManageOrders, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                <ScrollViewer x:Name="SchedulePage" VerticalScrollBarVisibility="Auto" Focusable="False"
                              Visibility="{Binding DataContext.Access.CanManageOrders, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="26,18,26,26" MaxWidth="1120" HorizontalAlignment="Left" MinWidth="760">
                        <DockPanel Margin="0,0,0,10">
                            <ComboBox DockPanel.Dock="Right" ItemsSource="{x:Static vm:OrdersViewModel.ScheduleFilters}" SelectedItem="{Binding ScheduleFilter}"
                                      Padding="8,5" MinWidth="150" VerticalAlignment="Center" AutomationProperties.Name="Show visits" />
                            <StackPanel>
                                <TextBlock Text="Schedule" Style="{StaticResource PageTitle}" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding ScheduleSummary}" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource Card}" Padding="18,10">
                            <StackPanel>
                                <TextBlock Text="Nothing here." Foreground="{StaticResource MutedTextBrush}" Margin="0,6"
                                           Visibility="{Binding HasSchedule, Converter={StaticResource InverseBoolToVisibility}}" />
                                <views:ItemsList ItemsSource="{Binding Schedule}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Done, Mode=OneWay}" VerticalAlignment="Top" Margin="0,2,0,0" ToolTip="Done"
                                                              AutomationProperties.Name="Done"
                                                              Command="{Binding DataContext.ToggleVisitCommand, ElementName=SchedulePage}" CommandParameter="{Binding}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                        <TextBlock Text="Overdue" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}"
                                                                   Visibility="{Binding IsLate, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" CornerRadius="9" Padding="8,1" Background="#EEF2F7" VerticalAlignment="Top" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding KindText}" FontSize="11" FontWeight="SemiBold" Foreground="#374151" />
                                                    </Border>
                                                    <StackPanel Grid.Column="3" Margin="8,0">
                                                        <TextBlock>
                                                            <Run Text="{Binding OrderNumber, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding Title, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding SiteAddress}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                                        <TextBlock FontSize="11" Foreground="#4B5563" TextWrapping="Wrap">
                                                            <Run Text="{Binding Team, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Note, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="Open order" Padding="10,3" VerticalAlignment="Top"
                                                            Command="{Binding DataContext.OpenVisitOrderCommand, ElementName=SchedulePage}" CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </views:ItemsList>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ══ Inventory › Stock (Milestone 18) ════════════════════ -->
            <DockPanel x:Name="StockPage" DataContext="{Binding Inventory}" Background="{StaticResource PageBackgroundBrush}"
                       Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Stock}">
                <DockPanel DockPanel.Dock="Top" Margin="24,16,24,0">
                    <TextBlock Text="Stock" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="  Bars, glass and hardware: on hand, reserved for production orders, available and on order."
                               VerticalAlignment="Bottom" Margin="0,0,0,4" Foreground="{StaticResource MutedTextBrush}" />
                </DockPanel>
                <ContentControl DockPanel.Dock="Top" Style="{StaticResource LockNotice}" Margin="24,12,24,0" VerticalAlignment="Top" MaxWidth="560" HorizontalAlignment="Left"
                                Content="{Binding DataContext.Access.InventoryLock, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding DataContext.Access.CanUseInventory, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                <DockPanel Margin="24,10,24,18" Visibility="{Binding DataContext.Access.CanUseInventory, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                    <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,10" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F5EC" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,10" Background="#FFF4E0" BorderBrush="#F0C987" BorderThickness="1" CornerRadius="4"
                            Visibility="{Binding HasLow, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock TextWrapping="Wrap" Foreground="#7A4A00" FontWeight="SemiBold">
                            <Run Text="&#x26A0; " /><Run Text="{Binding LowText, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <!-- Right: the selected item, and production orders to issue. -->
                    <ScrollViewer DockPanel.Dock="Right" Width="380" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Keep stock of" Style="{StaticResource CardTitle}" />
                                    <ComboBox Margin="0,6,0,0" ItemsSource="{Binding Choices}" SelectedItem="{Binding NewStockItem}" AutomationProperties.Name="Item to keep in stock" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Add to stock list" Margin="0,6,0,0" HorizontalAlignment="Left"
                                            Command="{Binding AddStockItemCommand}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12" Visibility="{Binding HasSelectedStock, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedStock.Name}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap">
                                        <Run Text="On hand " /><Run Text="{Binding SelectedStock.OnHand, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding SelectedStock.Unit, Mode=OneWay}" /><Run Text="  ·  for orders " /><Run Text="{Binding SelectedStock.Reserved, Mode=OneWay}" /><Run Text="  ·  on order " /><Run Text="{Binding SelectedStock.OnOrder, Mode=OneWay}" />
                                    </TextBlock>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Count found" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Margin="0,2" Padding="4,3" TextAlignment="Right" AutomationProperties.Name="Count found"
                                                 Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" ToolTip="What a stock count found: on hand becomes this" />
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Set" Margin="6,2,0,2" Command="{Binding CountCommand}"
                                                AutomationProperties.Name="Set count" />
                                        <TextBlock Grid.Row="1" Text="Add / take out" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Padding="4,3" TextAlignment="Right" AutomationProperties.Name="Add or take out"
                                                 Text="{Binding AdjustText, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. 10 to add, -2 to take out" />
                                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Book" Margin="6,2,0,2" Command="{Binding AdjustCommand}"
                                                AutomationProperties.Name="Book adjustment" />
                                        <TextBlock Grid.Row="2" Text="Note" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2" Padding="4,3" AutomationProperties.Name="Stock note"
                                                 Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Why: damaged, returned, found in the store …" />
                                        <TextBlock Grid.Row="3" Text="Reorder level" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,2" Padding="4,3" TextAlignment="Right" AutomationProperties.Name="Reorder level"
                                                 Text="{Binding ReorderText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Warn when this much or less is free (0: no warning)" />
                                        <TextBlock Grid.Row="4" Text="Kept at" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" Padding="4,3" AutomationProperties.Name="Kept at"
                                                 Text="{Binding LocationText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Rack, bay or store" />
                                        <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Save" Margin="6,2,0,2"
                                                Command="{Binding SaveStockSettingsCommand}" AutomationProperties.Name="Save stock settings" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Issue to production" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Production orders whose material is still reserved. Issue it when it goes to the workshop: it leaves stock."
                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,6" />
                                    <TextBlock Text="Nothing to issue." Foreground="{StaticResource MutedTextBrush}"
                                               Visibility="{Binding HasIssues, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <views:ItemsList ItemsSource="{Binding Issues}" AutomationProperties.Name="Production orders to issue">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Issue" VerticalAlignment="Center"
                                                                Command="{Binding IssueCommand}" AutomationProperties.Name="{Binding OrderNumber, StringFormat=Issue stock of {0}}" />
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold"><Run Text="{Binding OrderNumber, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Project, Mode=OneWay}" FontWeight="Normal" /></TextBlock>
                                                            <TextBlock Text="{Binding Needs}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </views:ItemsList>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ComboBox DockPanel.Dock="Right" Width="200" VerticalAlignment="Center" ItemsSource="{x:Static vm:InventoryViewModel.StockFilters}" SelectedItem="{Binding StockFilter}"
                                  AutomationProperties.Name="Show stock" />
                        <TextBox Width="260" HorizontalAlignment="Left" Style="{StaticResource SearchBox}" Tag="Search items"
                                 Text="{Binding StockSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search stock" />
                    </DockPanel>
                    <Grid DockPanel.Dock="Bottom" Height="190" Margin="0,10,0,0">
                        <Border Style="{StaticResource Card}" Padding="12,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="Stock moves (newest first; of the selected item when one is chosen)" />
                                <ListView ItemsSource="{Binding Moves}" BorderThickness="0" Margin="0,4,0,0" AutomationProperties.Name="Stock moves">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="When" Width="135" DisplayMemberBinding="{Binding When}" />
                                            <GridViewColumn Header="Item" Width="210" DisplayMemberBinding="{Binding Item}" />
                                            <GridViewColumn Header="Qty" Width="70" DisplayMemberBinding="{Binding Quantity}" />
                                            <GridViewColumn Header="Why" Width="80" DisplayMemberBinding="{Binding Reason}" />
                                            <GridViewColumn Header="Reference" Width="120" DisplayMemberBinding="{Binding Reference}" />
                                            <GridViewColumn Header="By" Width="100" DisplayMemberBinding="{Binding By}" />
                                            <GridViewColumn Header="Note" Width="160" DisplayMemberBinding="{Binding Note}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <Grid>
                        <ListView ItemsSource="{Binding Stock}" SelectedItem="{Binding SelectedStock}" AutomationProperties.Name="Stock list">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                                            <Setter Property="Foreground" Value="#9A3B00" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Item" Width="230" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Kind" Width="140" DisplayMemberBinding="{Binding Kind}" />
                                    <GridViewColumn Header="Unit" Width="45" DisplayMemberBinding="{Binding Unit}" />
                                    <GridViewColumn Header="On hand" Width="70" DisplayMemberBinding="{Binding OnHand}" />
                                    <GridViewColumn Header="For orders" Width="75" DisplayMemberBinding="{Binding Reserved}" />
                                    <GridViewColumn Header="Free" Width="60" DisplayMemberBinding="{Binding Available}" />
                                    <GridViewColumn Header="On order" Width="65" DisplayMemberBinding="{Binding OnOrder}" />
                                    <GridViewColumn Header="Reorder at" Width="75" DisplayMemberBinding="{Binding Reorder}" />
                                    <GridViewColumn Header="To buy" Width="60" DisplayMemberBinding="{Binding ToBuy}" />
                                    <GridViewColumn Header="Kept at" Width="80" DisplayMemberBinding="{Binding Location}" />
                                    <GridViewColumn Header="Orders" Width="130" DisplayMemberBinding="{Binding ForOrders}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Margin="16,40,16,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False"
                                   Visibility="{Binding IsStockEmpty, Converter={StaticResource BoolToVisibility}}"
                                   Text="Nothing here yet. Items appear when a production order needs them, when they are bought, or when you add them with Keep stock of." />
                    </Grid>
                </DockPanel>
            </DockPanel>

            <!-- ══ Purchasing › Purchase orders (Milestone 18) ══════════ -->
            <DockPanel x:Name="PurchaseOrdersPage" DataContext="{Binding Inventory}" Background="{StaticResource PageBackgroundBrush}"
                       Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=PurchaseOrders}">
                <DockPanel DockPanel.Dock="Top" Margin="24,16,24,0">
                    <TextBlock Text="Purchase orders" Style="{StaticResource PageTitle}" />
                </DockPanel>
                <ContentControl DockPanel.Dock="Top" Style="{StaticResource LockNotice}" Margin="24,12,24,0" VerticalAlignment="Top" MaxWidth="560" HorizontalAlignment="Left"
                                Content="{Binding DataContext.Access.PurchasingLock, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding DataContext.Access.CanUsePurchasing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                <DockPanel Margin="24,10,24,18" Visibility="{Binding DataContext.Access.CanUsePurchasing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                    <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,10" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F5EC" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                    </Border>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding ShortfallText}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Supplier" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Width="240" ItemsSource="{Binding ActiveSuppliers}" SelectedItem="{Binding PurchaseSupplier}" AutomationProperties.Name="Supplier" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Order what is short" Margin="8,0,0,0" Command="{Binding SuggestCommand}"
                                        ToolTip="A draft purchase order with everything this supplier supplies that open orders and reorder levels need, after stock and what is on order" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Empty purchase order" Margin="8,0,0,0" Command="{Binding NewPurchaseCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Left" Width="560" Margin="0,0,14,0">
                        <ComboBox DockPanel.Dock="Top" Width="160" HorizontalAlignment="Left" Margin="0,0,0,6" ItemsSource="{x:Static vm:InventoryViewModel.PurchaseFilters}"
                                  SelectedItem="{Binding PurchaseFilter}" AutomationProperties.Name="Show purchase orders" />
                        <ListView ItemsSource="{Binding Purchases}" SelectedItem="{Binding SelectedPurchase}" AutomationProperties.Name="Purchase orders">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Number" Width="85" DisplayMemberBinding="{Binding Number}" />
                                    <GridViewColumn Header="Supplier" Width="150" DisplayMemberBinding="{Binding Supplier}" />
                                    <GridViewColumn Header="Date" Width="85" DisplayMemberBinding="{Binding Date}" />
                                    <GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding Status}" />
                                    <GridViewColumn Header="Total" Width="120" DisplayMemberBinding="{Binding Total}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <Grid>
                            <TextBlock Text="Choose a purchase order, or make one above." Foreground="{StaticResource MutedTextBrush}"
                                       Visibility="{Binding HasPurchase, Converter={StaticResource InverseBoolToVisibility}}" />
                            <DockPanel Visibility="{Binding HasPurchase, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel DockPanel.Dock="Top">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PurchaseStatusText}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding PurchaseTitle}" Style="{StaticResource CardTitle}" />
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Purchase.ForOrders, StringFormat=For orders: {0}}"
                                           Visibility="{Binding Purchase.ForOrders.Length, Converter={StaticResource CountToVisibility}}" />
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Wanted by" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="1" Padding="4,3" Text="{Binding ExpectedText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Wanted by"
                                                 ToolTip="dd-mm-yyyy" />
                                        <TextBlock Grid.Column="2" Text="Note" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="12,0,8,0" />
                                        <TextBox Grid.Column="3" Padding="4,3" Text="{Binding PurchaseNote, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Purchase note" />
                                    </Grid>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Style="{StaticResource SecondaryButton}" Content="Save" Margin="0,0,6,6" Command="{Binding SavePurchaseCommand}" AutomationProperties.Name="Save purchase order" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="Place order" Margin="0,0,6,6" Command="{Binding PlaceOrderCommand}"
                                                Visibility="{Binding IsDraft, Converter={StaticResource BoolToVisibility}}" ToolTip="Its items are on order from now on" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="Purchase order PDF…" Margin="0,0,6,6" Command="{Binding PurchasePdfCommand}" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel order" Margin="0,0,6,6" Command="{Binding CancelPurchaseCommand}" />
                                    </WrapPanel>
                                    <StackPanel Visibility="{Binding CanReceive, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                                        <TextBlock Text="Goods received" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Enter what came in on each line (Received column), then book it: it goes into stock with a GRN number."
                                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="Supplier's invoice / challan" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox Width="160" Padding="4,3" Text="{Binding SupplierInvoice, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Supplier invoice" />
                                            <Button Style="{StaticResource PrimaryButton}" Content="Receive goods" Margin="8,0,0,0" Command="{Binding ReceiveCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ReceiptsText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding IsDraft, Converter={StaticResource BoolToVisibility}}">
                                    <ComboBox Width="280" ItemsSource="{Binding Choices}" SelectedItem="{Binding LineItem}" AutomationProperties.Name="Item to buy" />
                                    <TextBox Width="80" Margin="6,0,0,0" Padding="4,3" TextAlignment="Right" Text="{Binding LineQuantityText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Quantity to buy" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Add item" Margin="6,0,0,0" Command="{Binding AddLineCommand}" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Bottom" HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,6,0,0"
                                           Text="{Binding PurchaseTotalText, StringFormat=Total {0}}" />
                                <Grid DockPanel.Dock="Top" Margin="0,10,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="45" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Item" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="Quantity" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="Rate" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="Came in" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="Received" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Right"
                                               Visibility="{Binding CanReceive, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <views:ItemsList ItemsSource="{Binding Lines}" AutomationProperties.Name="Purchase order lines">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="45" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="34" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    <TextBox Grid.Column="1" Padding="4,2" TextAlignment="Right" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding DataContext.IsLocked, RelativeSource={RelativeSource AncestorType=views:ItemsList}}"
                                                             AutomationProperties.Name="{Binding Name, StringFormat=Quantity of {0}}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Unit}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBox Grid.Column="3" Padding="4,2" TextAlignment="Right" Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding DataContext.IsLocked, RelativeSource={RelativeSource AncestorType=views:ItemsList}}"
                                                             AutomationProperties.Name="{Binding Name, StringFormat=Rate of {0}}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding ReceivedText}" TextAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="5" Margin="6,0,0,0" Padding="4,2" TextAlignment="Right" Text="{Binding ReceiveText, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding DataContext.CanReceive, RelativeSource={RelativeSource AncestorType=views:ItemsList}, Converter={StaticResource BoolToVisibility}}"
                                                             AutomationProperties.Name="{Binding Name, StringFormat=Received now of {0}}" />
                                                    <Button Grid.Column="6" Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="4,0,0,0" Content="&#x2715;"
                                                            Command="{Binding RemoveCommand}" ToolTip="Remove"
                                                            Visibility="{Binding DataContext.IsDraft, RelativeSource={RelativeSource AncestorType=views:ItemsList}, Converter={StaticResource BoolToVisibility}}"
                                                            AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </views:ItemsList>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                </DockPanel>
            </DockPanel>

            <!-- ══ Purchasing › Suppliers (Milestone 18) ════════════════ -->
            <DockPanel x:Name="SuppliersPage" DataContext="{Binding Inventory}" Background="{StaticResource PageBackgroundBrush}"
                       Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Suppliers}">
                <DockPanel DockPanel.Dock="Top" Margin="24,16,24,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="New supplier" Command="{Binding NewSupplierCommand}" />
                    <TextBlock Text="Suppliers" Style="{StaticResource PageTitle}" />
                </DockPanel>
                <ContentControl DockPanel.Dock="Top" Style="{StaticResource LockNotice}" Margin="24,12,24,0" VerticalAlignment="Top" MaxWidth="560" HorizontalAlignment="Left"
                                Content="{Binding DataContext.Access.PurchasingLock, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding DataContext.Access.CanUsePurchasing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                <DockPanel Margin="24,10,24,18" Visibility="{Binding DataContext.Access.CanUsePurchasing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                    <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,10" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F5EC" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                    </Border>
                    <ListView DockPanel.Dock="Left" Width="460" Margin="0,0,14,0" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                              AutomationProperties.Name="Suppliers">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Supplier" Width="180" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Contact" Width="120" DisplayMemberBinding="{Binding ContactPerson}" />
                                <GridViewColumn Header="Phone" Width="120" DisplayMemberBinding="{Binding Phone}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Border Style="{StaticResource Card}" Padding="18,14" VerticalAlignment="Top" MaxWidth="560" HorizontalAlignment="Left">
                        <Grid>
                            <TextBlock Text="Choose a supplier, or New supplier." Foreground="{StaticResource MutedTextBrush}"
                                       Visibility="{Binding IsEditingSupplier, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Grid DataContext="{Binding Editing}" Visibility="{Binding DataContext.IsEditingSupplier, RelativeSource={RelativeSource AncestorType=DockPanel}, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="380" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Name *" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Margin="0,3" Padding="4,3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Supplier name" />
                                <TextBlock Grid.Row="1" Text="Contact person" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Padding="4,3" Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Contact person" />
                                <TextBlock Grid.Row="2" Text="Phone" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Padding="4,3" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Supplier phone" />
                                <TextBlock Grid.Row="3" Text="E-mail" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3" Padding="4,3" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Supplier e-mail" />
                                <TextBlock Grid.Row="4" Text="Address" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,3" Padding="4,3" MinHeight="48" TextWrapping="Wrap" AcceptsReturn="True"
                                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Supplier address" />
                                <TextBlock Grid.Row="5" Text="GSTIN" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,3" Padding="4,3" Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Supplier GSTIN" />
                                <TextBlock Grid.Row="6" Text="Supplies" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                    <CheckBox Content="Profiles" Margin="0,0,14,0" IsChecked="{Binding DataContext.SuppliesProfiles, RelativeSource={RelativeSource AncestorType=DockPanel}}" />
                                    <CheckBox Content="Glass" Margin="0,0,14,0" IsChecked="{Binding DataContext.SuppliesGlass, RelativeSource={RelativeSource AncestorType=DockPanel}}" />
                                    <CheckBox Content="Hardware and accessories" IsChecked="{Binding DataContext.SuppliesMaterials, RelativeSource={RelativeSource AncestorType=DockPanel}}" />
                                </StackPanel>
                                <TextBlock Grid.Row="7" Text="Note" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="7" Grid.Column="1" Margin="0,3" Padding="4,3" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Supplier note" />
                                <CheckBox Grid.Row="8" Grid.Column="1" Margin="0,6" Content="Active (offered for new purchase orders)" IsChecked="{Binding IsActive}" />
                                <Button Grid.Row="9" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Save supplier" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Command="{Binding DataContext.SaveSupplierCommand, RelativeSource={RelativeSource AncestorType=DockPanel}}" />
                            </Grid>
                        </Grid>
                    </Border>
                </DockPanel>
