                                <TextBox Grid.Row="8" Grid.Column="1" Margin="0,3,16,3" Padding="4,3" Text="{Binding TallyCompany, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tally company" />
                                    </Grid>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Save setup" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding SaveSettingsCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>

            <!-- ══ Offcuts in stock (Milestone 16) ═════════════════════ -->
            <Grid DataContext="{Binding Offcuts}" Background="{StaticResource PageBackgroundBrush}"
                  Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Offcuts}">
                <ContentControl Style="{StaticResource LockNotice}" Margin="24,18,24,0" VerticalAlignment="Top"
                                Content="{Binding DataContext.Access.ProductionOrdersLock, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding DataContext.Access.CanUseProductionOrders, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                <Grid Visibility="{Binding DataContext.Access.CanUseProductionOrders, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Text="Offcuts" Style="{StaticResource PageTitle}" HorizontalAlignment="Left" />
                            <TextBlock Text="Reusable leftover bars kept in the workshop. Cutting lists cut from them first; after cutting an order, Update offcuts takes the used ones out and puts its new ones in."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,16" />
                            <TextBlock Text="ADD OFFCUTS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="Profile" Style="{StaticResource FormLabel}" />
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" DisplayMemberPath="Name" Padding="6,4" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Length (mm)" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding LengthText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="How many" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <Button Style="{StaticResource PrimaryButton}" Content="Add to stock" Margin="0,4,0,0" HorizontalAlignment="Stretch" Command="{Binding AddCommand}" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,10,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#1D6B3A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="26,18,26,26" MaxWidth="900" HorizontalAlignment="Left" MinWidth="560">
                            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />
                            <views:ItemsList ItemsSource="{Binding Groups}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding Profile}" Style="{StaticResource CardTitle}" />
                                                </DockPanel>
                                                <views:ItemsList ItemsSource="{Binding Offcuts}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#EEF0F3" BorderThickness="0,1,0,0" Padding="0,6">
                                                                <DockPanel>
                                                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Remove" Padding="8,2" FontSize="11"
                                                                            CommandParameter="{Binding}" ToolTip="Take this offcut out of stock (used, damaged or not found)"
                                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                                                                    <TextBlock Text="{Binding LengthText}" FontWeight="SemiBold" Width="110" VerticalAlignment="Center" />
                                                                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}">
                                                                        <Run Text="{Binding Source, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Added, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </views:ItemsList>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </views:ItemsList>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ══ Quotation setup: what every quotation PDF prints ══ -->
            <ScrollViewer DataContext="{Binding QuotationSetup}" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Background="{StaticResource PageBackgroundBrush}"
                          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=QuotationSetup}">
                <StackPanel Margin="24,18,24,24" MaxWidth="1150">
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="Discard changes" Command="{Binding RevertCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Save setup" Command="{Binding SaveCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Company details and quotation" Style="{StaticResource PageTitle}" HorizontalAlignment="Left" />
                            <TextBlock Text="Changes are also saved when you leave this page or make a quotation." FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"
                               Visibility="{Binding IsManaged, Converter={StaticResource BoolToVisibility}}"
                               Text="What every quotation PDF prints. You set the covering letter, terms, acceptance, notes and units here; your company's details, brand and bank details are set up with your MARK account. Make a quotation with Quotation PDF… on an open, saved quote." />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"
                               Visibility="{Binding CanEditDetails, Converter={StaticResource BoolToVisibility}}"
                               Text="What every quotation PDF prints: your details, brand, bank details, the covering letter, terms, acceptance, notes and units. Make a quotation with Quotation PDF… on an open, saved quote." />
                    <Border Padding="10" Margin="0,0,0,12" CornerRadius="6" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F6EE" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#1F2A37" />
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14"
                                    Visibility="{Binding CanEditDetails, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Your details" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                    <StackPanel>
                                    <TextBlock Text="Company name" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Line above your name, e.g. Authorised partner" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding PartnerLabel, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Address (one or more lines)" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" MinHeight="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Contact no." Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Website" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="E-mail" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="GSTIN" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14"
                                    Visibility="{Binding CanEditDetails, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Brand (top left of every page)" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                    <StackPanel>
                                    <TextBlock Text="E.g. the profile system you sell. Leave empty for none." FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="Brand name" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding BrandName, UpdateSourceTrigger=PropertyChanged}" />
                                    <DockPanel Margin="0,4,0,0">
                                        <Border DockPanel.Dock="Left" Width="150" Height="60" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                            <Image Source="{Binding BrandLogoImage}" Stretch="Uniform" Margin="4" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryButton}" Content="Choose logo…" Margin="0,0,0,4" HorizontalAlignment="Left" Command="{Binding ChooseBrandLogoCommand}" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="Remove" Margin="0" HorizontalAlignment="Left" Command="{Binding RemoveBrandLogoCommand}"
                                                    Visibility="{Binding HasBrandLogo, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14"
                                    Visibility="{Binding CanEditDetails, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Bank details" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                    <StackPanel>
                                    <TextBlock Text="Account name" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Text="{Binding BankAccountName, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Account number" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding BankAccountNumber, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="IFSC" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding BankIfsc, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Bank" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Branch" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding BankBranch, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Units" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                        <TextBlock Text="Areas in" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#4B5563" />
                                        <RadioButton Content="Square feet" IsChecked="{Binding IsSquareFeet}" Margin="0,0,14,0" />
                                        <RadioButton Content="Square metres" IsChecked="{Binding IsSquareMetres}" />
                                    </StackPanel>
                                    <TextBlock Text="Money label after amounts" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" Width="120" HorizontalAlignment="Left" Margin="0" Text="{Binding CurrencyLabel, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20,16"
                                    Visibility="{Binding CanEditDetails, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Last page (optional)" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                    <TextBlock Text="One picture on a page of its own at the end, e.g. care instructions." FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,0,0,8" TextWrapping="Wrap" />
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="90" Height="120" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                            <Image Source="{Binding ExtraPageImage}" Stretch="Uniform" Margin="3" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryButton}" Content="Choose picture…" Margin="0,0,0,4" HorizontalAlignment="Left" Command="{Binding ChooseExtraPageCommand}" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="Remove" Margin="0" HorizontalAlignment="Left" Command="{Binding RemoveExtraPageCommand}"
                                                    Visibility="{Binding HasExtraPage, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Use MARK's texts" Padding="10,3"
                                                Command="{Binding DefaultTextsCommand}" ToolTip="Replace the letter, terms and acceptance with MARK's standard texts" />
                                        <TextBlock Text="Covering letter" Style="{StaticResource CardTitle}" />
                                    </DockPanel>
                                    <TextBlock Text="After &quot;Dear Customer,&quot; — one paragraph per line." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" />
                                    <TextBox Style="{StaticResource FormBox}" MinHeight="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                             Text="{Binding Letter, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Terms and conditions" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="One term per line; they are numbered on the quotation (lines you number yourself, like 1. or a., are printed as written)." FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" TextWrapping="Wrap" />
                                    <TextBox Style="{StaticResource FormBox}" MinHeight="200" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto" Text="{Binding Terms, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Use MARK's text" Padding="10,3"
                                                Command="{Binding DefaultSectionCommand}" CommandParameter="cancellation"
                                                ToolTip="Replace this section with MARK's standard text, to change as you like" />
                                        <TextBlock Text="Cancellation policy" Style="{StaticResource CardTitle}" />
                                    </DockPanel>
                                    <TextBlock Text="One point per line, printed after the terms. Leave empty to leave it out." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" TextWrapping="Wrap" />
                                    <TextBox Style="{StaticResource FormBox}" MinHeight="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto" Text="{Binding CancellationPolicy, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Use MARK's text" Padding="10,3"
                                                Command="{Binding DefaultSectionCommand}" CommandParameter="warranty"
                                                ToolTip="Replace this section with MARK's standard text, to change as you like" />
                                        <TextBlock Text="Warranty" Style="{StaticResource CardTitle}" />
                                    </DockPanel>
                                    <TextBlock Text="What the warranty covers and does not, one point per line. Leave empty to leave it out." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" TextWrapping="Wrap" />
                                    <TextBox Style="{StaticResource FormBox}" MinHeight="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto" Text="{Binding Warranty, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Use MARK's text" Padding="10,3"
                                                Command="{Binding DefaultSectionCommand}" CommandParameter="installation"
                                                ToolTip="Replace this section with MARK's standard text, to change as you like" />
                                        <TextBlock Text="Pre-requisites for installation" Style="{StaticResource CardTitle}" />
                                    </DockPanel>
                                    <TextBlock Text="What must be ready on site before installation, one point per line. Leave empty to leave it out." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" TextWrapping="Wrap" />
                                    <TextBox Style="{StaticResource FormBox}" MinHeight="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto" Text="{Binding InstallationPrerequisites, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20,16">
                                <StackPanel>
                                    <TextBlock Text="Acceptance and notes" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                    <TextBlock Text="Above the signatures" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" MinHeight="48" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                             Text="{Binding Acceptance, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Notes under the quote total" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" MinHeight="48" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ The open quote: Client | Designs | Drawing ═══════════ -->
            <DockPanel Background="{StaticResource PageBackgroundBrush}"
                       Visibility="{Binding Page, Converter={StaticResource EnumToVisibility}, ConverterParameter=Quote}">
                <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="18,6">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Open quote…" VerticalAlignment="Center"
                                Command="{Binding OpenProjectCommand}" ToolTip="Open a saved quote (Ctrl+O)" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Documents" VerticalAlignment="Center"
                                Command="{Binding ShowViewCommand}" CommandParameter="Documents" AutomationProperties.Name="Quote documents"
                                ToolTip="The quote's files: survey report, quotations, margins, credit approval, sales order, typology history" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding Access.CanEditQuotes, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource SecondaryButton}" Content="New revision" Command="{Binding NewRevisionCommand}"
                                    ToolTip="Keep the saved quote as a revision and continue as the next (R1, R2…)" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Convert to order" Command="{Binding ConvertToOrderCommand}"
                                    ToolTip="Mark the quote won and give it an order number"
                                    Visibility="{Binding IsOrder, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Order" Command="{Binding ShowOrderCommand}"
                                    ToolTip="This order's page: stage, payments, delivery and installation, dispatch notes and sign-off">
                                <Button.Visibility>
                                    <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                                        <Binding Path="IsOrder" />
                                        <Binding Path="Access.CanManageOrders" />
                                    </MultiBinding>
                                </Button.Visibility>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Content="Start production" Command="{Binding StartProductionCommand}"
                                    ToolTip="Make this order's production order (or open it): cutting list, glass order, labels and progress">
                                <Button.Visibility>
                                    <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                                        <Binding Path="IsOrder" />
                                        <Binding Path="Access.CanUseProductionOrders" />
                                    </MultiBinding>
                                </Button.Visibility>
                            </Button>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Quotation PDF…" VerticalAlignment="Center" Margin="6,0,6,0"
                                Command="{Binding ExportQuotationCommand}" ToolTip="Make the quotation of this quote as a PDF, with your setup"
                                Visibility="{Binding Access.CanMakeQuotation, Converter={StaticResource BoolToVisibility}}" />
                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,3" Margin="0,0,10,0" Background="#E8F6EE" VerticalAlignment="Center"
                                Visibility="{Binding IsOrder, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding OrderText}" FontWeight="SemiBold" FontSize="11" Foreground="#1D6B3A" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding QuoteHeader}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"><Run Text="{Binding QuoteSubHeader, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding QuoteAuthorsText, Mode=OneWay}" /></TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid>
                    <!-- Client: project, client, site address, requirements -->
                    <ScrollViewer DataContext="{Binding Details}" VerticalScrollBarVisibility="Auto" Focusable="False"
                                  Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Client}">
                        <StackPanel Margin="24,16,24,24" MaxWidth="1100">
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Quote" Style="{StaticResource CardTitle}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Project name *" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource FormBox}" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Quote number" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource FormBox}" Text="{Binding Number, Mode=OneWay}" IsReadOnly="True"
                                                 Background="#F4F5F7" />
                                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Status" Style="{StaticResource FormLabel}" />
                                        <ComboBox Grid.Row="1" Grid.Column="4" Margin="0,2,0,8" Padding="6,4" ItemsSource="{Binding Statuses}"
                                                  SelectedItem="{Binding Status}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Client" Style="{StaticResource CardTitle}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" Style="{StaticResource FormLabel}" />
                                        <ComboBox Grid.Row="1" Grid.Column="0" Margin="0,2,8,8" Padding="6,4" IsEditable="True"
                                                  ItemsSource="{Binding Titles}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="First name" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormBox}" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Last name" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource FormBox}" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="0" Grid.Column="5" Text="Company" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="5" Style="{StaticResource FormBox}" Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Phone" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource FormBox}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Email" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="3" Grid.Column="3" Style="{StaticResource FormBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="2" Grid.Column="5" Text="GSTIN (business client)" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="3" Grid.Column="5" Style="{StaticResource FormBox}" Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}"
                                                 CharacterCasing="Upper" MaxLength="15" AutomationProperties.Name="Client GSTIN"
                                                 ToolTip="Printed on the tax invoice; with it, the invoice is a B2B invoice" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Site address" Style="{StaticResource CardTitle}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Address 1" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource FormBox}" Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Address 2" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource FormBox}" Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="3" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="City" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="3" Grid.Column="0" Style="{StaticResource FormBox}" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="State" Style="{StaticResource FormLabel}" />
                                        <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource FormBox}" Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Postal code / Country" Style="{StaticResource FormLabel}" />
                                        <Grid Grid.Row="3" Grid.Column="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource FormBox}" Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="2" Style="{StaticResource FormBox}" Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Requirements and notes" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="What the client needs: rooms, window types, glass, colour, budget, deadlines, site conditions."
                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,6" />
                                    <TextBox Style="{StaticResource FormBox}" MinHeight="110" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="Save" Margin="0,0,8,0"
                                        Command="{Binding DataContext.SaveProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Save the quote with these details (Ctrl+S)" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Discard changes" Command="{Binding RevertCommand}"
                                        IsEnabled="{Binding HasChanges}" />
                                <TextBlock Text="Not saved yet: Save, or Ctrl+S" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <Border Margin="0,10,0,0" Padding="10" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E8F5EC" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                            </Border>

                            <!-- Who did what: the quote's history -->
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel>
                                    <TextBlock Text="History" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding QuoteAuthorsText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" />
                                    <views:ItemsList ItemsSource="{Binding QuoteHistory}" ItemTemplate="{StaticResource HistoryLine}" />
                                </StackPanel>
                            </Border>

                            <!-- Earlier revisions of the quote -->
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding HasQuoteRevisions, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Earlier revisions" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Kept as they were when the next revision was started. Open one as a copy to look at it or start again from it."
                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" TextWrapping="Wrap" />
                                    <views:ItemsList ItemsSource="{Binding QuoteRevisions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F0F2F5" BorderThickness="0,1,0,0" Padding="0,6">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Open a copy" Padding="10,2"
                                                                Command="{Binding OpenCommand}" />
                                                        <TextBlock VerticalAlignment="Center" Foreground="#1F2A37"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding When, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding By, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Value, Mode=OneWay}" /></TextBlock>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </views:ItemsList>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Designs: one card per window type -->
                    <DockPanel DataContext="{Binding Designs}"
                               Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Designs}">
                        <DockPanel DockPanel.Dock="Top" Margin="24,16,24,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="New design"
                                    Command="{Binding NewDesignCommand}" ToolTip="Add a frame and open it in the Drawing tab" />
                            <StackPanel>
                                <TextBlock Text="{Binding TotalsText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding ValueText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="24,0,24,8" Text="{Binding Message}" Foreground="{StaticResource ErrorBrush}"
                                   Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock DockPanel.Dock="Top" Margin="24,12,24,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                                   Text="No designs yet. Click New design, or pick a design from the library in the Drawing tab." />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <views:ItemsList ItemsSource="{Binding Cards}" Margin="18,0,18,18">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Width="270" Margin="6" Padding="14,12">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Quantity, StringFormat=Qty {0}}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding Reference}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                <Button Style="{StaticResource RowButton}" Command="{Binding EditCommand}" Margin="0,8" ToolTip="Edit this design">
                                                    <Image Source="{Binding Picture}" Width="200" Height="150" />
                                                </Button>
                                                <TextBlock Text="{Binding SizeText}" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding OpeningsText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding GlassText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                <DockPanel Margin="0,8,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalPriceText}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding UnitPriceText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                </DockPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Content="Edit design" Command="{Binding EditCommand}" />
                                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Content="Duplicate" Command="{Binding DuplicateCommand}" />
                                                    <Button Style="{StaticResource SecondaryButton}" Margin="0" Content="Delete" Command="{Binding DeleteCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </views:ItemsList>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Documents: files kept with the quote, by category -->
                    <Grid x:Name="DocumentsPage" DataContext="{Binding QuoteDocuments}" Background="{StaticResource PageBackgroundBrush}"
                          Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Documents}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                            <views:ItemsList ItemsSource="{Binding Categories}" Margin="0,8,0,0" AutomationProperties.Name="Document categories">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=views:ItemsList}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}" Cursor="Hand"
                                                HorizontalContentAlignment="Stretch" Padding="18,13" BorderThickness="0" ToolTip="{Binding Description}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F2F6FC" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#EAF2FB" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <DockPanel>
                                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </views:ItemsList>
                        </Border>

                        <DockPanel Grid.Column="1" Margin="24,18,24,18">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding CategoryTitle}" Style="{StaticResource PageTitle}" Margin="0,0,0,10" />
                            <Border DockPanel.Dock="Top" Background="#E9ECF1" Padding="12,10" CornerRadius="4,4,0,0">
                                <DockPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Upload" Command="{Binding UploadCommand}" Margin="0,0,8,0"
                                            IsEnabled="{Binding IsAvailable}" ToolTip="Add a file (PDF, picture, document…) to this category" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Make margin report" Command="{Binding MakeMarginsCommand}"
                                            IsEnabled="{Binding IsAvailable}" Visibility="{Binding IsMargins, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Cost, price and margin of every design, with each design's cost sheet (for you, not the client)" />
                                    <ComboBox DockPanel.Dock="Right" Width="150" Margin="8,0,0,0" VerticalAlignment="Center" ItemsSource="{x:Static vm:DocumentsViewModel.SortOptions}"
                                              SelectedItem="{Binding Sort}" AutomationProperties.Name="Sort by" ToolTip="Sort by" />
                                    <TextBlock DockPanel.Dock="Right" Text="Sort by" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox DockPanel.Dock="Right" Width="260" VerticalAlignment="Center" Style="{StaticResource SearchBox}" Tag="Search"
                                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search documents" />
                                    <Border />
                                </DockPanel>
                            </Border>
                            <Border DockPanel.Dock="Top" Padding="10" Margin="0,8,0,0" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E8F5EC" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                            </Border>
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,1" CornerRadius="0,0,4,4">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Unavailable}" Margin="16,14" Foreground="#9A5B00" TextWrapping="Wrap"
                                                       Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <!-- Typology history: the designs of every saved revision. -->
                                            <StackPanel Margin="16,12,16,4" Visibility="{Binding IsTypologyHistory, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Designs of each saved revision" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                           Visibility="{Binding Typologies.Count, Converter={StaticResource CountToVisibility}}" />
                                                <TextBlock Text="When the quote has revisions (New revision), the designs of each one are listed here." FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                                           Visibility="{Binding Typologies.Count, Converter={StaticResource CountToCollapsed}}" />
                                                <views:ItemsList ItemsSource="{Binding Typologies}" Margin="0,6,0,0" AutomationProperties.Name="Typology history">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="60" />
                                                                        <ColumnDefinition Width="210" />
                                                                        <ColumnDefinition Width="130" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Revision}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Saved}" Foreground="{StaticResource MutedTextBrush}" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{StaticResource TextBrush}" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding Designs}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </views:ItemsList>
                                                <TextBlock Text="Files" FontWeight="SemiBold" Margin="0,14,0,0" Foreground="{StaticResource TextBrush}"
                                                           Visibility="{Binding Documents.Count, Converter={StaticResource CountToVisibility}}" />
                                            </StackPanel>
                                            <views:ItemsList ItemsSource="{Binding Documents}" AutomationProperties.Name="Documents">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="4" Background="#EAF2FB" Margin="0,0,12,0">
                                                                    <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource SecondaryButton}" Content="Open" Margin="0,0,6,0" Command="{Binding OpenCommand}"
                                                                            AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}" />
                                                                    <Button Style="{StaticResource SecondaryButton}" Content="Save a copy" Margin="0,0,6,0" Command="{Binding SaveCommand}"
                                                                            AutomationProperties.Name="{Binding Name, StringFormat=Save a copy of {0}}" />
                                                                    <Button Style="{StaticResource SecondaryButton}" Content="Delete" Command="{Binding DeleteCommand}"
                                                                            AutomationProperties.Name="{Binding Name, StringFormat=Delete {0}}" />
                                                                </StackPanel>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding FileName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Size, Mode=OneWay}" /><Run Text="  ·  added " /><Run Text="{Binding Added, Mode=OneWay}" /><Run Text=" by " /><Run Text="{Binding AddedBy, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </views:ItemsList>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <!-- Nothing here yet. -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsEmpty}" Value="True" />
                                                            <Condition Binding="{Binding IsTypologyHistory}" Value="False" />
                                                            <Condition Binding="{Binding IsAvailable}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="44" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="No data found" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Grid>

                    <!-- Pricing: the quote's price structure and the price summary -->
                    <Grid DataContext="{Binding Pricing}"
                          Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Pricing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="215" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" MinWidth="330" />
                        </Grid.ColumnDefinitions>

                        <!-- Not in the package: the price structure is locked (the quote keeps the default pricing). -->
                        <Border Grid.ColumnSpan="3" Panel.ZIndex="10" Background="{StaticResource PageBackgroundBrush}"
                                Visibility="{Binding DataContext.Access.CanUsePriceStructure, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}">
                            <ContentControl Style="{StaticResource LockNotice}" MaxWidth="520" Margin="24" VerticalAlignment="Top"
                                            Content="{Binding DataContext.Access.PriceStructureLock, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Border>
                        <!-- The pages of the Pricing tab -->
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                            <ListBox ItemsSource="{x:Static vm:PricingViewModel.Pages}" SelectedValuePath="Page" SelectedValue="{Binding Page}"
                                     BorderThickness="0" Background="Transparent" Margin="0,8,0,0" AutomationProperties.Name="Pricing pages"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" Padding="18,12">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#F2F6FC" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#EAF2FB" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                            <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <DockPanel Grid.Column="1">
                            <!-- Apply: for every page (leaving the tab or Save applies too) -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="24,0,12,16">
                            <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Content="Apply to this quote" Command="{Binding ApplyCommand}" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Discard changes" Command="{Binding RevertCommand}"
                                            IsEnabled="{Binding HasChanges}" />
                                    <TextBlock Text="Not applied to the quote yet" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <Border Margin="0,10,0,0" Padding="10" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E8F5EC" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                </Border>
                            </StackPanel>
                            <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                                      Visibility="{Binding IsStructurePage, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="24,16,12,24">
                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryButton}" Content="Product prices..."
                                                    Command="{Binding OpenProductPricesCommand}"
                                                    ToolTip="Your prices of profiles (per metre), glass (per m²) and accessories: Library Manager" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="Use my default" Command="{Binding UseDefaultCommand}"
                                                    ToolTip="Load your saved default pricing into this form" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="Save as my default" Command="{Binding SaveAsDefaultCommand}"
                                                    ToolTip="New quotes will start with this pricing" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Price structure" Style="{StaticResource CardTitle}" />
                                            <TextBox Margin="0,6,0,0" Padding="6,4" Width="260" HorizontalAlignment="Left"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. Retail, Builder projects" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Cost heads (per window)" Style="{StaticResource CardTitle}" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,4" TextWrapping="Wrap"
                                                   Text="Every window's cost sheet starts with its material lines (Profile, RI, Hardware, Glass, Accessories and Mesh cost) and then adds these, top to bottom. A subtotal adds nothing: it totals the lines above it so formulas below can use it, e.g. Profit = 20 % of @Sub Total Including Labour." />
                                        <Expander Header="What a formula can use" Margin="0,0,0,8" FontSize="11" Foreground="{StaticResource MutedTextBrush}">
                                            <TextBlock Text="{x:Static vm:PricingViewModel.FormulaHelp}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </Expander>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="150" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="84" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Cost head" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="Calculation type" Foreground="{StaticResource MutedTextBrush}" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="2" Text="Rate" Foreground="{StaticResource MutedTextBrush}" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="4" Text="On quote" FontSize="11" TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        </Grid>
                                        <views:ItemsList ItemsSource="{Binding Heads}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="150" />
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="76" />
                                                            <ColumnDefinition Width="66" />
                                                            <ColumnDefinition Width="50" />
                                                            <ColumnDefinition Width="84" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBox Padding="4,3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cost head name" ToolTip="{Binding Name}" />
                                                        <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{x:Static vm:PricingViewModel.HeadBases}"
                                                                  SelectedValuePath="Basis" DisplayMemberPath="Name" SelectedValue="{Binding Basis}"
                                                                  AutomationProperties.Name="Calculation type" />
                                                        <TextBox Grid.Column="2" Margin="6,0,0,0" Padding="4,3" TextAlignment="Right" AutomationProperties.Name="Rate"
                                                                 Visibility="{Binding UsesRate, Converter={StaticResource BoolToVisibility}}"
                                                                 Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}" />
                                                        <DockPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="18,3,0,2"
                                                                   Visibility="{Binding UsesFormula, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock DockPanel.Dock="Left" Text="&#x21B3;" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource MutedTextBrush}" />
                                                            <TextBox Padding="4,3" FontFamily="Consolas" AutomationProperties.Name="Formula"
                                                                     Text="{Binding Formula, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HintBox}"
                                                                     Tag="{Binding FormulaHint}" />
                                                        </DockPanel>
                                                        <TextBlock Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"
                                                                   Foreground="{StaticResource MutedTextBrush}" Text="{Binding UnitText}" />
                                                        <CheckBox Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                  IsChecked="{Binding ShowOnQuote}" ToolTip="Show as its own line on the quotation" />
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="2,0,0,0" Content="&#x2191;"
                                                                    Command="{Binding MoveUpCommand}" ToolTip="Move up" />
                                                            <Button Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="2,0,0,0" Content="&#x2193;"
                                                                    Command="{Binding MoveDownCommand}" ToolTip="Move down" />
                                                            <Button Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="2,0,0,0" Content="&#x2715;"
                                                                    Command="{Binding RemoveCommand}" ToolTip="Remove" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </views:ItemsList>
                                        <Button Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                Content="Add cost line" Command="{Binding AddHeadCommand}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Discount and tax" Style="{StaticResource CardTitle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Discount" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                            <TextBox Width="70" Margin="8,0" Padding="4,3" TextAlignment="Right"
                                                     Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,28,0" />
                                            <TextBlock Text="Tax" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                            <TextBox Width="80" Margin="8,0" Padding="4,3" Text="{Binding TaxName, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Width="70" Margin="0,0,8,0" Padding="4,3" TextAlignment="Right"
                                                     Text="{Binding TaxText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="%" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Charges (after the discount)" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Added once to the quote after the discount, e.g. transportation, loading and unloading." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8" TextWrapping="Wrap" />
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="150" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="84" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Cost head" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="Calculation type" Foreground="{StaticResource MutedTextBrush}" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="2" Text="Rate" Foreground="{StaticResource MutedTextBrush}" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="4" Text="On quote" FontSize="11" TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        </Grid>
                                        <views:ItemsList ItemsSource="{Binding Charges}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="150" />
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="76" />
                                                            <ColumnDefinition Width="66" />
                                                            <ColumnDefinition Width="50" />
                                                            <ColumnDefinition Width="84" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Padding="4,3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                        <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{x:Static vm:PricingViewModel.ChargeBases}"
                                                                  SelectedValuePath="Basis" DisplayMemberPath="Name" SelectedValue="{Binding Basis}" />
                                                        <TextBox Grid.Column="2" Margin="6,0,0,0" Padding="4,3" TextAlignment="Right"
                                                                 Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"
                                                                   Foreground="{StaticResource MutedTextBrush}" Text="{Binding UnitText}" />
                                                        <CheckBox Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                  IsChecked="{Binding ShowOnQuote}" ToolTip="Show as its own line on the quotation" />
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="2,0,0,0" Content="&#x2191;"
                                                                    Command="{Binding MoveUpCommand}" ToolTip="Move up" />
                                                            <Button Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="2,0,0,0" Content="&#x2193;"
                                                                    Command="{Binding MoveDownCommand}" ToolTip="Move down" />
                                                            <Button Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="2,0,0,0" Content="&#x2715;"
                                                                    Command="{Binding RemoveCommand}" ToolTip="Remove" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </views:ItemsList>
                                        <Button Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                Content="Add charge" Command="{Binding AddChargeCommand}" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                            <!-- Profile, reinforcement, hardware, accessory, glass and mesh rates: the items the designs use -->
                            <DockPanel Margin="24,16,12,12"
                                       Visibility="{Binding IsStructurePage, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
                                <TextBlock DockPanel.Dock="Top" Text="{Binding PageHelp}" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0"
                                        Visibility="{Binding Page, Converter={StaticResource EnumToVisibility}, ConverterParameter=HardwareRate}">
                                    <StackPanel>
                                        <TextBlock Text="Hardware without a set in the library" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Per sash, by opening type: used for openings that have no hardware set in the library (a set is priced above)."
                                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" TextWrapping="Wrap" />
                                        <WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                                            <TextBlock Text="Casement" Width="118" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                            <TextBox Width="90" Padding="4,3" TextAlignment="Right" AutomationProperties.Name="Casement"
                                                     Text="{Binding CasementText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="per sash" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                                            <TextBlock Text="Top / bottom hung" Width="118" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                            <TextBox Width="90" Padding="4,3" TextAlignment="Right" AutomationProperties.Name="Top / bottom hung"
                                                     Text="{Binding HungText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="per sash" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                                            <TextBlock Text="Tilt &amp; turn" Width="118" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                            <TextBox Width="90" Padding="4,3" TextAlignment="Right" AutomationProperties.Name="Tilt &amp; turn"
                                                     Text="{Binding TiltTurnText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="per sash" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                                            <TextBlock Text="Pivot" Width="118" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                            <TextBox Width="90" Padding="4,3" TextAlignment="Right" AutomationProperties.Name="Pivot"
                                                     Text="{Binding PivotText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="per sash" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                                            <TextBlock Text="Sliding" Width="118" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                            <TextBox Width="90" Padding="4,3" TextAlignment="Right" AutomationProperties.Name="Sliding"
                                                     Text="{Binding SlidingText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="per panel" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0"
                                        Visibility="{Binding Page, Converter={StaticResource EnumToVisibility}, ConverterParameter=MeshRate}">
                                    <StackPanel>
                                        <TextBlock Text="Any other mesh" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="For designs whose mesh type has no rate of its own above (or no mesh type)."
                                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                                            <TextBlock Text="Insect mesh" Width="118" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                            <TextBox Width="90" Padding="4,3" TextAlignment="Right" AutomationProperties.Name="Insect mesh"
                                                     Text="{Binding MeshText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="per m²" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0"
                                        Visibility="{Binding Page, Converter={StaticResource EnumToVisibility}, ConverterParameter=ReinforcementRate}">
                                    <StackPanel>
                                        <TextBlock Text="Reinforcement not in the library" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Per metre of profile, for designs whose profiles list no reinforcement (uPVC); 0 for aluminium."
                                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                                            <TextBlock Text="Reinforcement" Width="118" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                            <TextBox Width="90" Padding="4,3" TextAlignment="Right" AutomationProperties.Name="Reinforcement"
                                                     Text="{Binding ReinforcementText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="per m" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                <!-- Design add-on cost heads: each design's extra cost per window -->
                                <Border Style="{StaticResource Card}" Padding="0"
                                        Visibility="{Binding IsDesignAddOnPage, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Background="#E9ECF1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" MinWidth="120" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Ref." FontWeight="SemiBold" Margin="14,9" />
                                            <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" Margin="6,9" />
                                            <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" Margin="6,9" />
                                            <TextBlock Grid.Column="3" Text="Qty" FontWeight="SemiBold" Margin="6,9" />
                                            <TextBlock Grid.Column="4" Text="Extra cost / window" FontWeight="SemiBold" Margin="6,9" />
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Top" Text="No designs in this quote yet." Margin="14,12" Foreground="{StaticResource MutedTextBrush}"
                                                   Visibility="{Binding DesignAddOns.Count, Converter={StaticResource CountToCollapsed}}" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                            <views:ItemsList ItemsSource="{Binding DesignAddOns}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="80" />
                                                                    <ColumnDefinition Width="*" MinWidth="120" />
                                                                    <ColumnDefinition Width="130" />
                                                                    <ColumnDefinition Width="44" />
                                                                    <ColumnDefinition Width="130" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" Margin="14,9" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="6,9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Size}" Margin="6,9" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="3" Text="{Binding Quantity}" Margin="6,9" VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="4" Margin="6,5,14,5" Padding="6,4" TextAlignment="Right"
                                                                         AutomationProperties.Name="{Binding Reference, StringFormat=Extra cost of {0}}"
                                                                         Text="{Binding ExtraCostText, UpdateSourceTrigger=LostFocus}"
                                                                         ToolTip="Changes the design when you leave the box (Tab)" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </views:ItemsList>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!-- The items and their rates -->
                                <Border Style="{StaticResource Card}" Padding="0"
                                        Visibility="{Binding IsDesignAddOnPage, Converter={StaticResource InverseBoolToVisibility}}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Background="#E9ECF1" Padding="12,10" CornerRadius="6,6,0,0">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Use library rates"
                                                        Command="{Binding UseLibraryRatesCommand}"
                                                        ToolTip="The ticked rows (or every row, if none is ticked) go back to the library's price" />
                                                <Grid Width="260" HorizontalAlignment="Left">
                                                    <TextBox Padding="26,6,6,6" Text="{Binding RateSearch, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Search the rates" />
                                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="9,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False" />
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                        <Grid DockPanel.Dock="Top">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" MinWidth="110" />
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="112" />
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource RowButton}" Command="{Binding SelectAllRatesCommand}" Margin="12,8,0,8"
                                                    ToolTip="Tick every row (or none)" AutomationProperties.Name="Tick every row">
                                                <TextBlock Text="&#xE73A;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedTextBrush}" />
                                            </Button>
                                            <TextBlock Grid.Column="1" Text="Code" FontWeight="SemiBold" Margin="6,9" />
                                            <TextBlock Grid.Column="2" Text="Item name" FontWeight="SemiBold" Margin="6,9" />
                                            <TextBlock Grid.Column="3" Text="Unit" FontWeight="SemiBold" Margin="6,9" />
                                            <TextBlock Grid.Column="4" Text="Library rate" FontWeight="SemiBold" Margin="6,9" TextAlignment="Right" />
                                            <TextBlock Grid.Column="5" Text="This quote" FontWeight="SemiBold" Margin="6,9,14,9" />
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding NoRowsText}" Margin="14,12" Foreground="{StaticResource MutedTextBrush}"
                                                   Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVisibility}}" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                            <views:ItemsList ItemsSource="{Binding RateRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="40" />
                                                                    <ColumnDefinition Width="96" />
                                                                    <ColumnDefinition Width="*" MinWidth="110" />
                                                                    <ColumnDefinition Width="66" />
                                                                    <ColumnDefinition Width="84" />
                                                                    <ColumnDefinition Width="112" />
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="14,0,0,0" VerticalAlignment="Center"
                                                                          AutomationProperties.Name="{Binding Name}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Code}" Margin="6,9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="6,9" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="3" Text="{Binding Unit}" Margin="6,9" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource MutedTextBrush}" />
                                                                <TextBlock Grid.Column="4" Text="{Binding LibraryRateText}" Margin="6,9" VerticalAlignment="Center"
                                                                           TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                                                                <StackPanel Grid.Column="5" Margin="6,5,14,5">
                                                                    <TextBox Padding="6,4" TextAlignment="Right" AutomationProperties.Name="{Binding Name, StringFormat=Rate of {0}}"
                                                                             Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}">
                                                                        <TextBox.Style>
                                                                            <Style TargetType="TextBox">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsOwnRate}" Value="True">
                                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                                        <Setter Property="Background" Value="#FFF8E6" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBox.Style>
                                                                    </TextBox>
                                                                    <TextBlock Text="{Binding SourceText}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </views:ItemsList>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                                </Grid>
                            </DockPanel>
                            </Grid>
                        </DockPanel>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel Margin="12,16,24,24">
                                <Border Style="{StaticResource Card}" Padding="18,14" Background="#F3FAF5" BorderBrush="#BFE3CB">
                                    <StackPanel>
                                        <TextBlock Text="Price summary" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding PreviewNote}" FontSize="11" Foreground="#9A5B00" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <views:ItemsList ItemsSource="{Binding Summary}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,4">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" Foreground="{StaticResource TextBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </views:ItemsList>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Content="Calculation type"
                                                      IsChecked="{Binding ShowTypes}" ToolTip="Show how each line is worked out" />
                                            <TextBlock Text="Cost sheet" Style="{StaticResource CardTitle}" />
                                        </DockPanel>
                                        <TextBlock Text="One window of the design, line by line: what each cost head works out to."
                                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                                        <ComboBox ItemsSource="{Binding SheetDesigns}" SelectedItem="{Binding SelectedSheetDesign}" Margin="0,0,0,8"
                                                  AutomationProperties.Name="Cost sheet design" />
                                        <TextBlock Text="Add a design to see its cost sheet." FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                                   Visibility="{Binding Sheet.Count, Converter={StaticResource CountToCollapsed}}" />
                                        <Grid Margin="0,0,0,2" Visibility="{Binding Sheet.Count, Converter={StaticResource CountToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Cost head" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="Calculation type" FontSize="11" FontWeight="SemiBold" Width="120" Margin="6,0,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}" Visibility="{Binding ShowTypes, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Grid.Column="2" Text="Formula" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" Foreground="{StaticResource MutedTextBrush}"
                                                       ToolTip="{x:Static vm:PricingViewModel.FormulaHelp}" />
                                            <TextBlock Grid.Column="3" Text="Amount" FontSize="11" FontWeight="SemiBold" TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                                        </Grid>
                                        <views:ItemsList ItemsSource="{Binding Sheet}" AutomationProperties.Name="Cost sheet">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                                        <Setter Property="Background" Value="#EAF2FB" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.3*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="1.4*" />
                                                                <ColumnDefinition Width="90" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="1" Text="{Binding Type}" Width="120" Margin="6,0,0,0" FontSize="11" TextWrapping="Wrap"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       Visibility="{Binding DataContext.ShowTypes, RelativeSource={RelativeSource AncestorType=views:ItemsList}, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Formula}" Margin="6,0,0,0" FontSize="11" FontFamily="Consolas"
                                                                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Amount}" TextAlignment="Right" Foreground="{StaticResource TextBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </views:ItemsList>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Per design" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Per window: material (library prices), hardware/mesh/reinforcement (rates) and cost lines; price after discount."
                                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Ref." FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="Qty" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="2" Text="Material" FontSize="11" TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="3" Text="Hardware…" FontSize="11" TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="4" Text="Cost lines" FontSize="11" TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="5" Text="Price each" FontSize="11" TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="6" Text="Total" FontSize="11" TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                                        </Grid>
                                        <views:ItemsList ItemsSource="{Binding DesignPrices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44" />
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Material}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Rated}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="4" Text="{Binding Heads}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="5" Text="{Binding UnitPrice}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="6" Text="{Binding Total}" TextAlignment="Right" FontWeight="SemiBold" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </views:ItemsList>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Products: what the designs use, and this quote's bar lengths -->
                    <Grid DataContext="{Binding Products}" Background="{StaticResource PageBackgroundBrush}"
                          Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Products}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="215" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                            <ListBox ItemsSource="{x:Static vm:ProductsViewModel.Pages}" SelectedValuePath="Page" SelectedValue="{Binding Page}"
                                     BorderThickness="0" Background="Transparent" Margin="0,8,0,0" AutomationProperties.Name="Product pages"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" Padding="18,12">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#F2F6FC" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#EAF2FB" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                            <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <DockPanel Grid.Column="1" Margin="24,16,24,16">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
                            <TextBlock DockPanel.Dock="Top" Text="{Binding PageHelp}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                            <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,10" CornerRadius="6"
                                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E8F6EE" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="#E9ECF1" Padding="12,10" CornerRadius="6,6,0,0">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                        Visibility="{Binding HasLengths, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Bar length" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBox Width="80" Padding="6,5" TextAlignment="Right" Text="{Binding BulkLength, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Bar length for the ticked rows">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Enter" Command="{Binding SetLengthCommand}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                                <TextBlock Text="mm" VerticalAlignment="Center" Margin="6,0,8,0" Foreground="{StaticResource MutedTextBrush}" />
                                                <Button Style="{StaticResource PrimaryButton}" Content="Set for ticked (or all)" Command="{Binding SetLengthCommand}" Margin="0,0,6,0"
                                                        ToolTip="Give the ticked profiles (or every profile listed, if none is ticked) this bar length, for this quote" />
                                                <Button Style="{StaticResource SecondaryButton}" Content="Use library lengths" Command="{Binding UseLibraryLengthsCommand}"
                                                        ToolTip="The ticked profiles (or all) go back to the library's bar length" />
                                            </StackPanel>
                                            <Grid Width="240" HorizontalAlignment="Left">
                                                <TextBox Padding="26,6,6,6" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search the products" />
                                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="9,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False" />
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                    <Grid DockPanel.Dock="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" MinWidth="150" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource RowButton}" Command="{Binding SelectAllCommand}" Margin="12,8,0,8"
                                                ToolTip="Tick every row (or none)" AutomationProperties.Name="Tick every row">
                                            <TextBlock Text="&#xE73A;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedTextBrush}" />
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="Code" FontWeight="SemiBold" Margin="6,9" />
                                        <TextBlock Grid.Column="2" Text="Item name" FontWeight="SemiBold" Margin="6,9" />
                                        <TextBlock Grid.Column="3" Text="Used" FontWeight="SemiBold" Margin="6,9" />
                                        <TextBlock Grid.Column="4" Text="Bars (cutting plan)" FontWeight="SemiBold" Margin="6,9" />
                                        <TextBlock Grid.Column="5" Text="Library" FontWeight="SemiBold" Margin="6,9" TextAlignment="Right" />
                                        <TextBlock Grid.Column="6" Text="This quote (mm)" FontWeight="SemiBold" Margin="6,9,14,9" />
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding NoRowsText}" Margin="14,12" Foreground="{StaticResource MutedTextBrush}"
                                               Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVisibility}}" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <views:ItemsList ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40" />
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="*" MinWidth="150" />
                                                                <ColumnDefinition Width="170" />
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="120" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="14,0,0,0" VerticalAlignment="Center"
                                                                      AutomationProperties.Name="{Binding Name}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Code}" Margin="6,9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="6,9" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="3" Text="{Binding UsedText}" Margin="6,9" VerticalAlignment="Center" TextWrapping="Wrap"
                                                                       Foreground="{StaticResource MutedTextBrush}" />
                                                            <TextBlock Grid.Column="4" Text="{Binding BarsText}" Margin="6,9" VerticalAlignment="Center" TextWrapping="Wrap"
                                                                       Foreground="{StaticResource MutedTextBrush}" />
                                                            <TextBlock Grid.Column="5" Text="{Binding LibraryLengthText}" Margin="6,9" VerticalAlignment="Center"
                                                                       TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                                                            <StackPanel Grid.Column="6" Margin="6,5,14,5" Visibility="{Binding HasLength, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBox Padding="6,4" TextAlignment="Right" AutomationProperties.Name="{Binding Name, StringFormat=Bar length of {0}}"
                                                                         Text="{Binding LengthText, UpdateSourceTrigger=LostFocus}"
                                                                         ToolTip="The bar length for this quote; changed when you leave the box (Tab)">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsOwnLength}" Value="True">
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                    <Setter Property="Background" Value="#FFF8E6" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                                <TextBlock Text="{Binding SourceText}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </views:ItemsList>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </DockPanel>
                    </Grid>

                    <!-- Bill of materials (Pricing area) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                                  Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Materials}">
                        <StackPanel Margin="14,16,24,24" MaxWidth="780" HorizontalAlignment="Left">
                            <TextBlock Text="Bill of materials" Style="{StaticResource PageTitle}" Margin="10,0,0,2" />
                            <TextBlock Text="Everything the quote's designs need: profiles, steel, glass, hardware and accessories, with their cost."
                                       Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,0" TextWrapping="Wrap" />
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource BillOfMaterialsPanel}" Focusable="False" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Cutting plan (Production area) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                                  Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Cutting}">
                        <StackPanel Margin="14,16,24,24" MaxWidth="780" HorizontalAlignment="Left">
                            <TextBlock Text="Cutting plan" Style="{StaticResource PageTitle}" Margin="10,0,0,2" />
                            <TextBlock Text="How to cut the quote's profiles and steel from stock bars: cuts per bar, offcuts kept and waste. To see another quote, use Open quote…"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,0" TextWrapping="Wrap" />
                            <Border Style="{StaticResource Card}" Margin="10,12,0,0" Padding="0,4">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CuttingPlanPanel}" Focusable="False" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Drawing: the designer (toolbar, library, canvas, properties) -->
                    <DockPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Drawing}">
                        <!-- ── Toolbar ──────────────────────────────────────────── -->
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1"
                                Background="{StaticResource PanelBackgroundBrush}" Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ToolbarButton}" Content="Library" ToolTip="Library manager: products, prices, stock lengths"
                                        Command="{Binding OpenLibraryManagerCommand}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Key" Command="{Binding DrawingKeyCommand}"
                                        ToolTip="What the labels on the drawing mean (S1, F1, HH, RI, FIXED…)" />
                                <Rectangle Width="1" Margin="6,2" Fill="{StaticResource BorderBrush}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Undo" Command="{Binding UndoCommand}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Redo" Command="{Binding RedoCommand}" />
                                <Rectangle Width="1" Margin="6,2" Fill="{StaticResource BorderBrush}" />
                                <!-- Interaction modes: exactly one is active. -->
                                <RadioButton Style="{StaticResource ToolRadio}" Content="Select" ToolTip="Select, move, resize (Esc)"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Select}" />
                                <RadioButton Style="{StaticResource ToolRadio}" Content="Pan" ToolTip="Drag to pan"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Pan}" />
                                <RadioButton Style="{StaticResource ToolRadio}" Content="Frame" ToolTip="Drag a rectangle to draw a frame"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=CreateFrame}" />
                                <RadioButton Style="{StaticResource ToolRadio}" Content="Mullion" ToolTip="Click a glass panel to add a mullion (Shift = whole frame)"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=AddMullion}" />
                                <RadioButton Style="{StaticResource ToolRadio}" Content="Transom" ToolTip="Click a glass panel to add a transom (Shift = whole frame)"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=AddTransom}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Delete" ToolTip="Delete the selection (Del)"
                                        Command="{Binding DeleteSelectedCommand}" />
                                <Rectangle Width="1" Margin="6,2" Fill="{StaticResource BorderBrush}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Zoom In" Command="{Binding Canvas.ZoomInCommand}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Zoom Out" Command="{Binding Canvas.ZoomOutCommand}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Fit" ToolTip="Fit to screen (F)" Command="{Binding Canvas.FitCommand}" />
                                <Button Style="{StaticResource ToolbarButton}" Content="Reset" ToolTip="Reset view" Command="{Binding Canvas.ResetViewCommand}" />
                                <ToggleButton Style="{StaticResource ToolbarToggle}" Content="Grid" ToolTip="Show grid (G)"
                                              IsChecked="{Binding Canvas.ShowGrid}" />
                            </StackPanel>
                        </Border>

                        <!-- ── Main area: design | canvas | properties ──────────── -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="306" MinWidth="250" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" MinWidth="220" />
                            </Grid.ColumnDefinitions>

                            <!-- Design library: category rail + the chosen category's designs (or the frame tools) -->
                            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <ListBox DockPanel.Dock="Left" Width="64" Style="{StaticResource RailList}"
                                             ItemContainerStyle="{StaticResource RailItem}"
                                             ItemsSource="{Binding DesignLibrary.Categories}" SelectedValuePath="Name"
                                             SelectedValue="{Binding DesignLibrary.SelectedCategory}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel ToolTip="{Binding ToolTip}" Width="50" AutomationProperties.Name="{Binding Name}">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                               MaxWidth="54" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Text="{Binding DesignLibrary.Title}" />

                                        <!-- Frame tools (new frame, divisions, snapping) -->
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                                                      Visibility="{Binding DesignLibrary.IsFramePanel, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource PanelHeader}" Text="NEW FRAME" Margin="12,0,12,8" />
                                            <Grid Margin="12,0,12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Width" Style="{StaticResource FieldLabel}" />
                                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource NumberBox}"
                                                         Text="{Binding NewFrameWidthText, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                                                <TextBlock Grid.Row="1" Text="Height" Style="{StaticResource FieldLabel}" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}"
                                                         Text="{Binding NewFrameHeightText, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                                            </Grid>
                                            <Button Style="{StaticResource PanelButton}" Content="Create Frame" Command="{Binding CreateFrameCommand}" />

                                            <TextBlock Style="{StaticResource PanelHeader}" Text="DIVISIONS" Margin="12,20,12,8" />
                                            <Button Style="{StaticResource PanelButton}" Content="Add Mullion  │" Command="{Binding AddMullionCommand}" />
                                            <Button Style="{StaticResource PanelButton}" Content="Add Transom  ─" Command="{Binding AddTransomCommand}" />
                                            <TextBlock Margin="12,6,12,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                                       Text="With a glass panel selected, the division splits only that opening. Otherwise it spans the whole frame." />

                                            <Border Margin="12,12,12,0" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                                                    Visibility="{Binding HasDesignMessage, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding DesignMessage}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                                            </Border>

                                            <TextBlock Style="{StaticResource PanelHeader}" Text="SNAP" Margin="12,20,12,8" />
                                            <CheckBox Margin="12,2" Content="Object snap" IsChecked="{Binding ObjectSnapEnabled}" Focusable="False"
                                                      ToolTip="Intersection › endpoint › midpoint › centre › edge" />
                                            <CheckBox Margin="12,2" Content="Grid snap" IsChecked="{Binding Canvas.SnapToGrid}" Focusable="False" />
                                            <Grid Margin="12,4,12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Grid step" Style="{StaticResource FieldLabel}" />
                                                <TextBox Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding Canvas.GridSpacingMm}" />
                                                <TextBlock Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                                                <TextBlock Grid.Row="1" Text="Tolerance" Style="{StaticResource FieldLabel}" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding SnapTolerancePixels}" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="px" Style="{StaticResource UnitLabel}" />
                                            </Grid>

                                            <TextBlock Margin="12,20,12,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                                       Text="Click selects, Shift+click adds, Ctrl+click toggles, drag on empty space box-selects (→ inside, ← touching). Drag frames, mullions, transoms or the frame's handles. Esc cancels, Del deletes, Ctrl+A selects all, Ctrl+Z / Ctrl+Y undo / redo." />
                                        </StackPanel>
                                        </ScrollViewer>

                                        <!-- Designs of the chosen category -->
                                        <DockPanel Visibility="{Binding DesignLibrary.IsFramePanel, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock DockPanel.Dock="Top" Margin="12,0,12,4" TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="Click a design to apply it to the selected opening or frame, or drag it onto an opening. With no frame yet, it creates one." />
                                            <Border DockPanel.Dock="Top" Margin="12,4,12,4" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                                                    Visibility="{Binding DesignLibrary.HasMessage, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding DesignLibrary.Message}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                                            </Border>
                                            <ContentControl DockPanel.Dock="Top" Style="{StaticResource LockNotice}" Margin="12,4,12,4"
                                                            Content="{Binding Access.DesignLibraryLock}"
                                                            Visibility="{Binding Access.CanUseDesignLibrary, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" IsEnabled="{Binding Access.CanUseDesignLibrary}">
                                                <views:ItemsList ItemsSource="{Binding DesignLibrary.Sections}" Margin="0,0,0,12">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,4,0,4">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="12,6,12,4"
                                                                           Foreground="{StaticResource TextBrush}" />
                                                                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="12,0,12,4" />
                                                                <views:ItemsList ItemsSource="{Binding Items}" Margin="8,0">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Style="{StaticResource DesignTile}" Command="{Binding ApplyCommand}"
                                                                                    ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                                                                    views:DesignDragSource.TemplateId="{Binding DragId}">
                                                                                <Image Source="{Binding Thumbnail}" Width="56" Height="56" />
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </views:ItemsList>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </views:ItemsList>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </DockPanel>
                                </DockPanel>
                            </Border>

                            <!-- 2D drawing view -->
                            <Grid Grid.Column="1">
                                <controls:ViewportControl x:Name="Viewport" Viewport="{Binding Canvas}" Tool="{Binding ActiveTool}"
                                                          DropTarget="{Binding}" />
                                <!-- Inside / Outside view -->
                                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" Padding="3"
                                        CornerRadius="16" Background="#EEFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentRadio}" Content="Inside" IsChecked="{Binding IsInsideView}"
                                                     ToolTip="Seen from inside (editable)" />
                                        <RadioButton Style="{StaticResource SegmentRadio}" Content="Outside" IsChecked="{Binding IsOutsideView}"
                                                     ToolTip="Seen from outside: mirrored, hinges swapped (read-only)" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Properties (hidden while the New design panel covers them, so Tab does not reach them) -->
                            <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NewDesignPanel.IsOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel>
                                <StackPanel DataContext="{Binding Properties}">
                                    <TextBlock Style="{StaticResource PanelHeader}" Text="PROPERTIES" />
                                    <TextBlock Margin="12,0,12,8" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" Text="{Binding Header}" />

                                    <!-- Design details (frame) and opening type (glass) -->
                                    <ContentControl Content="{Binding DesignEditor}" Focusable="False" />
                                    <ContentControl Content="{Binding OpeningEditor}" Focusable="False" />

                                    <!-- Frame size -->
                                    <StackPanel Visibility="{Binding IsFrameEditable, Converter={StaticResource BoolToVisibility}}">
                                        <Grid Margin="12,0,12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Width" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Column="1" Style="{StaticResource NumberBox}"
                                                     Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding ApplyFrameSizeCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <TextBlock Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                                            <TextBlock Grid.Row="1" Text="Height" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}"
                                                     Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding ApplyFrameSizeCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                                        </Grid>
                                        <Button Style="{StaticResource PanelButton}" Content="Apply" Command="{Binding ApplyFrameSizeCommand}" />
                                    </StackPanel>

                                    <!-- Division position -->
                                    <StackPanel Visibility="{Binding IsDivisionEditable, Converter={StaticResource BoolToVisibility}}">
                                        <Grid Margin="12,0,12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PositionLabel}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Column="1" Style="{StaticResource NumberBox}"
                                                     Text="{Binding PositionText, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding ApplyPositionCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <TextBlock Grid.Column="2" Text="mm" Style="{StaticResource UnitLabel}" />
                                        </Grid>
                                        <Button Style="{StaticResource PanelButton}" Content="Apply" Command="{Binding ApplyPositionCommand}" />
                                    </StackPanel>

                                    <Border Margin="12,8,12,4" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                                    </Border>

                                    <views:ItemsList ItemsSource="{Binding Items}" Margin="12,8,12,0" ItemTemplate="{StaticResource PropertyRow}" />

                                    <!-- Library assignments: the frame's system, then glass / profile after design -->
                                    <ContentControl Content="{Binding SystemPicker}" Focusable="False" />
                                    <ContentControl Content="{Binding ProfilePicker}" Focusable="False" />
                                    <ContentControl Content="{Binding GlassPicker}" Focusable="False" />

                                    <!-- Calculated values for the selection -->
                                    <StackPanel Visibility="{Binding HasCalculation, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource PanelHeader}" Text="CALCULATION" Margin="12,16,12,4" />
                                        <views:ItemsList ItemsSource="{Binding CalculationItems}" Margin="12,0,12,0" ItemTemplate="{StaticResource PropertyRow}" />
                                    </StackPanel>
                                    <Border Margin="12,8,12,4" Padding="8" Background="{StaticResource ErrorBackgroundBrush}"
                                            Visibility="{Binding HasCalculationMessage, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding CalculationMessage}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                                    </Border>
                                </StackPanel>

                                    <!-- Bill of materials and cutting plan for the whole project (also pages of Pricing and Production) -->
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource BillOfMaterialsPanel}" Focusable="False" />
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CuttingPlanPanel}" Focusable="False" />
                                </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- New design: design ref., quantity, location, brand and glass, shown for a design just made, over the properties -->
                            <Border Grid.Column="2" DataContext="{Binding NewDesignPanel}" Background="White"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                                    IsVisibleChanged="NewDesignPanel_IsVisibleChanged"
                                    Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="18,14,10,12">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="30" Height="30"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding CloseCommand}"
                                                    ToolTip="Keep the design as it was made" AutomationProperties.Name="Close" />
                                            <StackPanel>
                                                <TextBlock Text="New design" FontSize="15" FontWeight="SemiBold" Foreground="#1F2A37" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border DockPanel.Dock="Bottom" Padding="18,10,18,18" BorderBrush="#EEF0F3" BorderThickness="0,1,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="0" Padding="12,9"
                                                        Command="{Binding CloseCommand}" IsCancel="{Binding IsOpen}"
                                                        ToolTip="Keep the design as it was made; it can be changed in the properties" />
                                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Apply" Margin="0" Padding="12,9"
                                                        Command="{Binding ConfirmCommand}" IsDefault="{Binding IsOpen}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="18,14,18,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FormLabel}"><Run Text="Design ref." /><Run Text=" *" Foreground="{StaticResource ErrorBrush}" /></TextBlock>
                                                    <TextBox x:Name="NewDesignReference" Style="{StaticResource FormBox}" Margin="0,0,0,12"
                                                             Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Design ref."
                                                             ToolTip="Shown above the drawing and in quotes, e.g. W1" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Style="{StaticResource FormLabel}"><Run Text="Quantity" /><Run Text=" *" Foreground="{StaticResource ErrorBrush}" /></TextBlock>
                                                    <TextBox Style="{StaticResource FormBox}" Margin="0,0,0,12" TextAlignment="Right"
                                                             Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Quantity" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Location" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" Margin="0,0,0,12" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Location" ToolTip="Where it goes, e.g. Living room" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Width (mm)" Style="{StaticResource FormLabel}" />
                                                    <TextBox Style="{StaticResource FormBox}" Margin="0,0,0,12" TextAlignment="Right"
                                                             Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Width" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Height (mm)" Style="{StaticResource FormLabel}" />
                                                    <TextBox Style="{StaticResource FormBox}" Margin="0,0,0,12" TextAlignment="Right"
                                                             Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Height" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Visibility="{Binding AsksType, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Type" Style="{StaticResource FormLabel}" />
                                                <ComboBox ItemsSource="{x:Static vm:NewDesignViewModel.Types}" SelectedItem="{Binding SelectedType}" Padding="8,6" Margin="0,0,0,12"
                                                          AutomationProperties.Name="Type"
                                                          ToolTip="How it opens. More designs (and mesh) are in the design library on the left." />
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding AsksBrand, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Brand" Style="{StaticResource FormLabel}" />
                                                <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedBrand}" Padding="8,6" Margin="0,0,0,12"
                                                          AutomationProperties.Name="Brand"
                                                          ToolTip="The maker of the profiles. The design decides the system: sliding designs go in the brand's sliding system, casement designs in its casement system." />
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding AsksGlass, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Glass" Style="{StaticResource FormLabel}" />
                                                <ComboBox ItemsSource="{Binding GlassOptions}" SelectedItem="{Binding SelectedGlass}" Padding="8,6"
                                                          AutomationProperties.Name="Glass" views:SearchCombo.MinItems="6">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,1">
                                                                <TextBlock Text="{Binding Name}" />
                                                                <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Text="Used for every pane of the design. Single panes can be changed later in the properties."
                                                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                                                <TextBlock Text="No glass fits this system yet. Glass types are added in Library (or by your MARK supplier, when your catalogue comes from them)."
                                                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource ErrorBrush}" Margin="0,6,0,0"
                                                           Visibility="{Binding HasNoGlass, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>

                </Grid>
            </DockPanel>

        </Grid>
    </DockPanel>
</Window>
