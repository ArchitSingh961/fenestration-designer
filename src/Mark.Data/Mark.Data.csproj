<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local persistence: SQLite storage for the product library and saved projects. Headless (no WPF, plain
       net8.0) and references Core only; Calculation never references it. ArchitectureTests enforce this. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mark.Data</RootNamespace>
    <AssemblyName>Mark.Data</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mark.Core\Mark.Core.csproj" />
  </ItemGroup>

  <!-- Tests build databases of older schema versions to check the upgrades. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Mark.Tests" />
  </ItemGroup>

</Project>
