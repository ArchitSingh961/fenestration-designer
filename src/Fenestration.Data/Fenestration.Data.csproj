<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local persistence: SQLite storage for the product library and saved projects. Headless (no WPF, plain
       net8.0) and references Core only; Calculation never references it. ArchitectureTests enforce this. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fenestration.Data</RootNamespace>
    <AssemblyName>Fenestration.Data</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fenestration.Core\Fenestration.Core.csproj" />
  </ItemGroup>

</Project>
