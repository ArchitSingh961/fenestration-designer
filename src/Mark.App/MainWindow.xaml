                </DockPanel>
                <ContentControl DockPanel.Dock="Top" Style="{StaticResource LockNotice}" Margin="24,12,24,0" VerticalAlignment="Top" MaxWidth="560" HorizontalAlignment="Left"
                                Content="{Binding DataContext.Access.AccountsLock, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding DataContext.Access.CanUseAccounts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                <DockPanel Margin="24,10,24,18" Visibility="{Binding DataContext.Access.CanUseAccounts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                    <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,10" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F5EC" />
