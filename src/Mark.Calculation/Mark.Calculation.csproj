<Project Sdk="Microsoft.NET.Sdk">

  <!-- Calculation engine: headless (no WPF, plain net8.0) so it can run in a server or cloud process.
       References Core only; ArchitectureTests enforce both. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mark.Calculation</RootNamespace>
    <AssemblyName>Mark.Calculation</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mark.Core\Mark.Core.csproj" />
  </ItemGroup>

</Project>
