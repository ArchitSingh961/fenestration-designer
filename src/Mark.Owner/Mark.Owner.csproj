<Project Sdk="Microsoft.NET.Sdk">

  <!-- MARK Owner: the admin program (MARK.Owner.exe). Creates and manages the client companies' accounts, packages,
       company types and licence keys on the licence server. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Mark.Owner</RootNamespace>
    <AssemblyName>MARK.Owner</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mark.Licensing\Mark.Licensing.csproj" />
    <ProjectReference Include="..\Mark.Designer\Mark.Designer.csproj" />
  </ItemGroup>

</Project>
